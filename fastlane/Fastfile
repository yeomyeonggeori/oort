# momo — Fastfile (2026)
# 비대화형(CI) 전제. 모든 인증은 App Store Connect API Key(.p8 base64 secret).
#
# 전제(STATUS.md): clients/macOS·clients/iOS에 "얇은 Xcode App 프로젝트"가 추가되어
#   scheme "MomoMac"(macOS, developer-id) / "MomoiOS"(iOS, app-store)가 존재해야 한다.
#   (없으면 build_* 레인은 실패 — docs/cicd/04-codex-tickets.md C1/C2 선행.)
#
# 검수 게이트(docs/cicd/03-store-readiness-gate.md) PASS 전에는 release_* 레인을 돌리지 말 것.

require "base64"

default_platform(:ios)

# ── 공통: API Key 로드 (base64 in-memory, 파일 미기록) ───────────────────────
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

def match_git_auth
  Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}")
end

# =============================================================================
# iOS
# =============================================================================
platform :ios do
  desc "iOS: build-for-testing 만 (PR/푸시용, 서명·배포 없음)"
  lane :ci_build do
    run_tests(
      scheme: "MomoiOS",
      destination: "platform=iOS Simulator,name=iPhone 16,OS=latest",
      skip_build: false,
      build_for_testing: true,
      clean: true
    )
  end

  desc "iOS: TestFlight 업로드 (태그/수동 dispatch · 검수 게이트 PASS 후)"
  lane :beta do
    key = asc_api_key
    # 앱 + 알림 확장(NSE)은 각각 프로파일이 필요하다. 정본은 pbxproj의
    # PRODUCT_BUNDLE_IDENTIFIER — scripts/verify_ios_signing.sh 가 동치를 강제한다.
    match(
      type: "appstore",
      readonly: true,                       # CI 필수
      api_key: key,
      app_identifier: ["app.momo.ios", "app.momo.ios.NotificationService"],
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: match_git_auth
    )
    gym(
      scheme: "MomoiOS",
      export_method: "app-store",
      configuration: "Release",
      output_directory: "build",
      output_name: "MomoiOS.ipa",
      clean: true
    )
    pilot(
      api_key: key,
      ipa: "build/MomoiOS.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: ["momo-internal"],            # External Testing 그룹만 신뢰성 있게 동작
      changelog: "build #{ENV['GITHUB_RUN_NUMBER'] || 'local'}"
    )
  end

  desc "iOS: App Store 제출 (검수 게이트 PASS + 수동 승인 후에만)"
  lane :release do
    key = asc_api_key
    match(type: "appstore", readonly: true, api_key: key,
          app_identifier: ["app.momo.ios", "app.momo.ios.NotificationService"],
          git_url: ENV.fetch("MATCH_GIT_URL"),
          git_basic_authorization: match_git_auth)
    gym(scheme: "MomoiOS", export_method: "app-store",
        configuration: "Release", output_directory: "build",
        output_name: "MomoiOS.ipa", clean: true)
    deliver(
      api_key: key,
      ipa: "build/MomoiOS.ipa",
      submit_for_review: false,             # 처음엔 false (메타/스크린샷 수동 확인)
      automatic_release: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true                           # 비대화형(HTML 프롬프트 스킵)
    )
  end
end

# =============================================================================
# macOS (Developer ID 직접배포 + 공증)
# =============================================================================
platform :mac do
  desc "macOS: build 만 (PR/푸시용)"
  lane :ci_build do
    run_tests(scheme: "MomoMac", build_for_testing: true, clean: true)
  end

  desc "macOS: Developer ID 빌드 + 공증(notarize) + staple + dmg (태그/수동 · 게이트 PASS 후)"
  lane :notarized_release do
    key = asc_api_key
    # com.dawnkim.momo 는 자리표시자가 아니라 MomoMac의 실제 번들 ID다
    # (clients/macOS/MomoMac.xcodeproj/project.pbxproj). iOS 값과 다른 것이 정상이며,
    # Matchfile의 iOS 기본값을 덮어쓰기 위해 여기서 명시한다.
    match(
      type: "developer_id",                 # 직접배포용 Developer ID
      readonly: true,
      api_key: key,
      app_identifier: ["com.dawnkim.momo"],
      platform: "macos",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: match_git_auth
    )
    gym(
      scheme: "MomoMac",
      export_method: "developer-id",
      configuration: "Release",
      output_directory: "build",
      output_name: "MomoMac",
      clean: true
    )
    # 공증: fastlane notarize 액션 사용. 일부 버전 API Key 버그(issue #22055) 시
    #       docs/cicd/00 §4.2 직접 notarytool 경로(release-macos.yml에 구현)로 폴백.
    notarize(
      package: "build/MomoMac.app",
      api_key: key,
      print_log: true
    )
    sh("xcrun stapler staple ../build/MomoMac.app")
    # dmg 패키징은 워크플로우(create-dmg)에서 수행 → GitHub Release 업로드.
  end
end
