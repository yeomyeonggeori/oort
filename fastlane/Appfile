# momo — Appfile
# 정본은 Xcode 프로젝트다(clients/iOS·clients/macOS 의 PRODUCT_BUNDLE_IDENTIFIER).
# 이 파일에 맞춰 프로젝트를 바꾸지 말 것 — 등록된 App ID·푸시 인증서·App Group
# (group.app.momo.ios)·keychain access group($(AppIdentifierPrefix)app.momo.ios.shared)이
# 전부 번들 ID에 묶여 있어 함께 흔들린다.
# CI에서는 모든 인증을 App Store Connect API Key로 하므로 apple_id는 비워둠.

# iOS 앱 = TestFlight/App Store 업로드 대상(pilot/deliver가 찾는 ASC 앱 레코드).
# 알림 확장(app.momo.ios.NotificationService)은 앱에 임베드되어 함께 올라가므로
# 별도 ASC 레코드가 없다 — 대신 프로파일은 따로 필요하다(Matchfile 참조).
app_identifier("app.momo.ios")

# macOS(MomoMac)는 별도 번들 ID. mac 레인은 Fastfile에서도 명시적으로 넘긴다.
for_platform :mac do
  app_identifier("com.dawnkim.momo")
end

# apple_id("")                       # API Key 사용 → 비대화형, 불필요

# team_id / itc_team_id 는 Team Key 사용 시 API Key가 추론. 다중 팀 계정이면 명시:
# team_id("XXXXXXXXXX")              # Developer Portal Team ID
# itc_team_id("123456789")          # App Store Connect Team ID (숫자)
