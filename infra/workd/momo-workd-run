#!/bin/sh
# Private-environment launcher shared by the launchd/systemd user services.
set -eu
umask 077

ENV_FILE="${1:?workd environment file required}"
WORKD_BIN="${2:?momo-workd binary required}"

[ -f "$ENV_FILE" ] || {
  echo "momo-workd environment file missing" >&2
  exit 1
}
[ -x "$WORKD_BIN" ] || {
  echo "momo-workd binary missing or not executable" >&2
  exit 1
}

if mode="$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null)"; then
  :
else
  mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || true)"
fi
case "$mode" in
  400|600) ;;
  *)
    echo "momo-workd environment file must be mode 0400 or 0600" >&2
    exit 1
    ;;
esac

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
exec "$WORKD_BIN"
