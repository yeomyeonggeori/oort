# runtime-unverified (no docker/psql) — 이 환경에는 docker/psql 부재.
# 값/연결은 정적으로만 점검됨. 실제 기동(`make up`)은 PG18+Centrifugo v6 환경에서 검증 필요.
#
# momo v0 환경변수 템플릿.
# 사용법:  cp infra/.env.example .env   →  값 채움  →  make up
# (.gitignore에 .env/.env.local 등록됨 → 실제 시크릿은 커밋되지 않음.)
#
# 시크릿 생성 예: openssl rand -hex 32

# =============================================================================
# DB — PostgreSQL 18 (SoT). docker-compose의 postgres 서비스와 정합.
# =============================================================================
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# 서버/relay/worker가 읽는 연결 문자열(컨테이너 내부는 host=postgres, 로컬은 localhost).
DATABASE_URL=postgres://momo:change-me-postgres@localhost:5432/momo

# =============================================================================
# Centrifugo v6 — transport. centrifugo.json의 ${...} 인터폴레이션 대상.
# =============================================================================
CENT_PORT=8000
# Public WebSocket endpoint advertised by login/join responses. The macOS app
# prefers this server-owned value and only falls back to its own environment.
MOMO_CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket
# client connection/subscription JWT 서명용 HMAC 시크릿(스펙 §7.1).
CENT_TOKEN_HMAC=change-me-cent-token-hmac
# server-side HTTP API(POST /api/publish) 인증 키(X-API-Key). relay만 사용(§4.3).
CENT_API_KEY=change-me-cent-api-key
# relay가 publish할 Centrifugo API 엔드포인트.
# DATABASE_URL(위 §DB)과 **같은 규칙**이다 — 컨테이너 내부는 host=`centrifugo`,
# 호스트에서 직접 실행 시 host=`127.0.0.1`. 이 파일은 후자를 배포한다: `docs/SELF_HOST.md`
# §5가 relay를 호스트에서 띄우라고 지시하고, 이 변수를 읽는 것은 그 호스트 프로세스와
# `scripts/verify_*.sh` 뿐이기 때문이다(어떤 compose 서비스도 `${CENT_API_URL}`을
# 보간하지 않는다 — 컨테이너 relay에는 compose가 `http://centrifugo:8000/api`를
# 리터럴로 넣는다: infra/prod/docker-compose.prod.yml, infra/rust/docker-compose.rust.yml).
#
# 컨테이너 호스트명을 여기 두면 증상이 조용해서 나쁘다: REST 왕복도 DB 기록도 전부
# 성공하고 실시간 fan-out만 사라진다. relay는 `publish threw: NoSuchRecord`로 8회
# 재시도한 뒤 outbox 행을 `status='failed'`로 남기고 조용히 죽는다
# (2026-08-10 buzz-audit-C §2.5 실측). 레포 스크립트 7개가 `case $CENT_API_URL in
# *centrifugo*)` 재작성 가드로 이 증상을 조용히 우회하고 있었다 — 우회는 있었고
# 템플릿만 고쳐지지 않았던 것이다. #1231이 이 줄을 고쳤고 #1235가 가드 7개를
# 은퇴시켰다. 그러니 **이 줄이 이제 유일한 방어선**이다: 여기(또는 이 파일을 본떠
# 만드는 secret env — `docs/SELF_HOST.md` §local-alpha)에 컨테이너 호스트명을 넣으면
# 아무도 고쳐주지 않는다.
CENT_API_URL=http://127.0.0.1:8000/api
# subscribe proxy 콜백 공유 시크릿(MOMO-300). Centrifugo가 X-Centrifugo-Proxy-Secret
# 헤더로 붙이고 API가 검증한다. staging/prod/internal-host는 비-placeholder 필수(부팅 fail-fast).
CENT_PROXY_SECRET=change-me-cent-proxy-secret
# /v1/auth/realtime-token connection JWT TTL. 서버는 60~1800초로 clamp한다.
# CENT_CONNECTION_TOKEN_TTL_SECONDS=300

# =============================================================================
# JWT — App access/refresh 토큰(REST, HS256). 스펙 §7.1.
# =============================================================================
JWT_HMAC=change-me-jwt-hmac
# ADR-0004 증보 4 (#2066): the two webhook derivation roots are REQUIRED and
# no longer fall back to JWT_HMAC. Inbound native ingress secrets derive from
# the first, outbound event-subscription/doorbell secrets from the second.
# Sharing either with JWT_HMAC means a JWT rotation silently invalidates every
# issued webhook secret — the coupling this pair exists to break. Keep them
# distinct from JWT_HMAC, from PROVIDER_LINK_MASTER_KEY and from each other.
WEBHOOK_INGRESS_MASTER_KEY=change-me-webhook-ingress-master-key
OUTBOUND_WEBHOOK_MASTER_KEY=change-me-outbound-webhook-master-key
# MOMO-572 / ADR-0004 증보 1: dedicated key for the operator provider_link bearer
# (AES-GCM at rest). When unset it shares JWT_HMAC for local dev; strict envs
# (staging/prod/internal-host) must set a unique value (not JWT_HMAC, not the
# outbound key). The stored provider bearer is never logged or returned in clear.
# PROVIDER_LINK_MASTER_KEY=change-me-provider-link-master-key
# Provider cascade 전체 wall-clock 상한(ms). 각 홉의 timeout이 아니라 체인 합계다.
PROVIDER_CASCADE_TOTAL_TIMEOUT_MS=60000

# =============================================================================
# momo Cloud T3 provider adapter (ADR-0136 + ADR-0142, optional)
# =============================================================================
# T3 is unreleased and default-off while #888 redesign is in progress.
# Explicit opt-in is required in addition to a usable provider adapter.
# ADR-0170 link unfurl. Default 0 — opt-in. The webhook-sender drain fetches
# OG/Twitter card metadata for http(s) URLs in messages only when this is 1.
# Workspace admins can still turn fetch off per tenant after that.
# MOMO_UNFURL_ENABLED=0
#
# ADR-0171 hosted doorbell. Default off. Exact lowercase `true` only.
# The prerequisite gate is MOMO_HOSTED_DELIVERY_ENABLED (same spelling).
# Doorbell without it is a silent no-op: mentions never reach hosted inbox.
# MOMO_HOSTED_DELIVERY_ENABLED=true
# MOMO_DOORBELL_ENABLED=true
#
# ADR-0193 D6 subscription-agent kill switch. Default ON (unset or `true`).
# Any other value turns it OFF: subscription (owner_only) agents receive no
# calls, the subscription join is refused, clients hide the subscription rows.
# MOMO_SUBSCRIPTION_AGENTS_ENABLED=false

# Claude subscription agents (ADR-0193 증보 2026-10-03, #3397): OFF by default while
# Anthropic's reply to the subscription-agent question is pending. Only an exact `true`
# lets `POST …/subscription-agents/register` accept `harness: claude_code`; otherwise it
# answers 409 `claude_subscription_agent_paused`. Codex is not affected.
# MOMO_CLAUDE_SUBSCRIPTION_AGENTS_ENABLED=true

# MOMO_T3_ENABLED=1
# Unset keeps T1/T2 fully available and makes every T3 surface return 503.
#
# ADR-0142 D1: BYOC is the base form and is the default when MOMO_T3_PROVIDER is
# unset — you attach a server you already own (docs/BYOC_CLOUD_HOST.md) and need
# no provider account or credential whatsoever.
# MOMO_T3_PROVIDER=byoc
#
# A managed substrate is one adapter registry id plus its own env namespace.
# The operator key is process-only: never expose it to a workspace, client,
# database, log, or committed file (ADR-0004).
# MOMO_T3_PROVIDER=mock-a
# MOMO_T3_PROVIDER_MOCK_A_API_BASE_URL=https://provider.example.com
# MOMO_T3_PROVIDER_MOCK_A_API_KEY=
# MOMO_T3_PROVIDER_MOCK_A_IMAGE_REF=momo-workd
# MOMO_T3_PROVIDER_MOCK_A_INSTANCE_TIMEOUT_SECONDS=3600
#
# ADR-0156 — the first managed substrate momo really boots instances on. Both
# the API (acquisition) and the notifier (reconciliation) read this namespace,
# and both fail closed on absence: no base URL + key means no adapter is built,
# so acquisition answers 503 and reconciliation refuses the id by name rather
# than aiming at a host nobody stood up.
# IMAGE_REF is the CubeSandbox **template id** (a pre-built artifact), not an
# OCI reference. MAX_INSTANCES follows the box you bought (ADR-0156 D6①).
#
# RENEWAL_SECONDS replaces the retired SWEEP_SECONDS (#1197 H1), and the swap is
# not a rename. `timeout` was modelled as an *idle* clock, so the old knob was a
# ledger reclaim period the safety net was 4x of — 86400, i.e. a 96 h zombie
# ceiling. D4-② measured `timeout` to be an **absolute TTL from creation** that
# nothing resets except `POST /sandboxes/{id}/refreshes`, so momo now renews
# explicitly and this is the renewal period. The lease is still 4x it, but that
# lease is the zombie ceiling: at the 90 s default, an instance momo stops
# renewing (because momo died, or because the host's workd went quiet) is
# reclaimed by the substrate about six minutes later.
#
# Lower it and instances die sooner after momo does; raise it and they linger.
# Anything absent or malformed falls back to 90, which lengthens the lease
# rather than shortening it — a bad value must never delete a live session.
# MOMO_T3_PROVIDER=cubesandbox
# MOMO_T3_PROVIDER_CUBESANDBOX_API_BASE_URL=http://cube-host.internal:3000
# MOMO_T3_PROVIDER_CUBESANDBOX_API_KEY=
# MOMO_T3_PROVIDER_CUBESANDBOX_IMAGE_REF=tpl-oort-workd
# MOMO_T3_PROVIDER_CUBESANDBOX_INSTANCE_TIMEOUT_SECONDS=3600
# MOMO_T3_PROVIDER_CUBESANDBOX_MAX_INSTANCES=10
# MOMO_T3_PROVIDER_CUBESANDBOX_RENEWAL_SECONDS=90
# Public HTTPS MomoServer URL reached by the cloud workd bootstrap.
# MOMO_PUBLIC_BASE_URL=https://momo.example.com
# Snapshot the rate into each usage row so later rate changes cannot rewrite
# already accrued active time. 1 micro-USD = USD 0.000001.
# MOMO_T3_RATE_MICRO_USD_PER_SECOND=25

# =============================================================================
# LiveKit — ADR-0122 huddle SFU. Opt in with compose profile `huddle`.
# The API key/secret must match MomoServer's token issuer. Never commit real values.
# =============================================================================
MOMO_LIVEKIT_API_KEY=devkey
MOMO_LIVEKIT_API_SECRET=change-me-livekit-api-secret
MOMO_LIVEKIT_URL=ws://127.0.0.1:7880
# MOMO-646: intentionally blank until the Korean benchmark is judged.
MOMO_TRANSCRIPTION_MODEL=
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50100

# =============================================================================
# Platform admin read-only inspection (MOMO-013)
# =============================================================================
# 일반 tenant route는 DATABASE_URL(momo_app 등 NOBYPASSRLS)로 실행하고,
# /v1/platform/* 읽기 전용 조회만 별도 BYPASSRLS + SELECT-only role로 실행한다.
# 로컬 verifier가 momo_platform_admin role을 준비한다.
# PLATFORM_ADMIN_DATABASE_URL=postgres://momo_platform_admin:change-me@localhost:5432/momo
# PLATFORM_ADMIN_EMAILS=ops@momo.local
# v0 auth는 password verification stub이므로 platform:read와
# platform:credits:write 발급에는 별도 secret도 요구한다.
# PLATFORM_ADMIN_LOGIN_SECRET=change-me-platform-admin-login-secret

# =============================================================================
# hermes — Local Hermes OpenAI 호환 게이트웨이(/v1/chat/completions + SSE). 스펙 §6.2.
# =============================================================================
# local-mock=로컬 mock hermes, internal-host-mock=internal-smoke mock hermes,
# external-hermes=실제 Hermes/Kim Intern provider. staging/prod/internal-host는 external-hermes만 허용.
AGENT_PROVIDER_MODE=local-mock
AGENT_MODEL=hermes-agent
AGENT_HANDLE=hermes
AGENT_DISPLAY_NAME=Hermes
HERMES_BASE_URL=http://localhost:8088/v1
HERMES_API_KEY=change-me-hermes-bearer

# =============================================================================
# Attachment archive — ADR-0127. Default `drive` preserves Dawn operation.
# For the optional compose MinIO profile, select `s3` and keep endpoint path
# style enabled. These committed values are placeholders, never real secrets.
# =============================================================================
MOMO_ARCHIVE_BACKEND=drive
MOMO_S3_ENDPOINT=http://minio:9000
MOMO_S3_REGION=us-east-1
MOMO_S3_BUCKET=momo-attachments
MOMO_S3_ACCESS_KEY=change-me-s3-access-key
MOMO_S3_SECRET_KEY=change-me-s3-secret-key
MOMO_S3_FORCE_PATH_STYLE=1
MINIO_PORT=9000

# =============================================================================
# eve custom-agent runtime — optional compose profile `eve` (MOMO-538).
# The default stack ignores these values. Credentials are injected only into
# the eve container; use URL-safe random text for EVE_WORLD_PASSWORD.
# =============================================================================
EVE_PORT=28140
EVE_WORLD_DB=eve_world
EVE_WORLD_USER=eve_world
EVE_WORLD_PASSWORD=change-me-eve-world
EVE_WORLD_JOB_PREFIX=momo_eve
EVE_WORLD_WORKER_CONCURRENCY=10
EVE_WORLD_MAX_POOL_SIZE=10
EVE_MOMO_BASE_URL=http://host.docker.internal:8080
MOMO_WORKSPACE_ID=
MOMO_AGENT_MEMBER_ID=
MOMO_AGENT_TOKEN=
MOMO_CHANNEL_ROUTE_TOKEN=
EVE_AI_GATEWAY_API_KEY=

# Optional MOMO-325/337 Hermes gateway native-platform mode.
# Default worker mode keeps AgentWorker in charge of provider calls. Gateway mode
# broadcasts agent.job to Hermes and accepts per-agent bearer callbacks through
# momo REST. The shared secret is deprecated and disabled unless the flag is 1.
# AGENT_GATEWAY_MODE=worker
# AGENT_GATEWAY_SECRET=change-me-agent-gateway-secret
# MOMO_ALLOW_LEGACY_GATEWAY_SECRET=0

# =============================================================================
# (선택) 튜닝/오버라이드 — 모두 코드에 안전한 기본값이 있어 미설정 시 그 값으로 동작.
# 전체 목록·기본값·의미는 docs/SELF_HOST.md §2.2 참고. 자주 쓰는 것만 주석으로 노출:
# =============================================================================
# 서버 바인드(기본 0.0.0.0:8080). PORT 변경 시 centrifugo.json proxy(api:8080)도 맞출 것.
# HOST=0.0.0.0
# PORT=8080
# relay/worker 전용 BYPASSRLS(momo_relay) 접속(미설정 시 DATABASE_URL/POSTGRES_* 사용). 스펙 §2.2/§10.1.
# RELAY_DATABASE_URL=postgres://momo_relay:change-me@localhost:5432/momo
# worker 루프가드(스펙 §3.3/§3.4) — 기본 G2=3 / G3=12 / depth=4 / 동시실행=1.
# MAX_CONSECUTIVE_AUTO=3
# MAX_STEPS=12
# MAX_DEPTH=4
# MAX_CONCURRENT_RUNS=1
# 컨텍스트 조립(MOMO-302) — @mention 시 같은 채널 최근 히스토리를 hermes chat 배열로 전달.
# 서버가 payload에 담는 최근 메시지 수(기본 30, 1..200) / worker의 문자 예산(기본 24000, 초과 시 오래된 것부터 드랍).
# AGENT_CONTEXT_MAX_MESSAGES=30
# AGENT_CONTEXT_MAX_CHARS=24000
# 사람 기기 키 서명(ADR-0146 개정 2026-09-28 R2, #3022). MOMO_INSTANCE_ID는 서명문의
# instance_id 줄에 들어가는 이 인스턴스의 불변 id(운영자가 정함, URL에서 만들지 않음).
# MOMO_HOST_REGISTER_SIGNATURE_REQUIRED=true면 member-scope host 등록에 뿌리 기기 키의
# host_register 서명을 요구한다. 기본 꺼짐 — R1 보안 재검수 PASS 전까지 닫아 둔다(D-11).
# 켜려면 MOMO_INSTANCE_ID가 있어야 한다(없으면 부팅 거부). 데스크탑 앱의 host 등록은 뿌리 키가 묶인
# 워크스페이스에서 이 서명을 싣는다(#3120); 뿌리 키가 없는 맥은 서명 없이 등록하므로 켜면 403이다.
# MOMO_INSTANCE_ID=
# MOMO_HOST_REGISTER_SIGNATURE_REQUIRED=false
# MOMO_HUMAN_CONTROL_SIGNATURE_REQUIRED=true면 member-scope host로 가는 사람 지시(지금은 권한 허용,
# input·spawn은 E7 #3027)에 기기 키의 momo.human.control.v1 서명을 요구하고, member host로의
# 재개(resume)는 거부한다(v1은 서버가 고른 세션의 spawn을 서명할 수 없음). 기본 꺼짐(D-11, #3023).
# 보낸 서명은 꺼져 있어도 검증한다. 켜려면 MOMO_INSTANCE_ID가 있어야 한다.
# MOMO_HUMAN_CONTROL_SIGNATURE_REQUIRED=false
# refresh 토큰 재사용 시 계보 전체 폐기(ADR-0188 R1). QR 연결(폰) 세션은 항상 폐기한다.
# 비밀번호 로그인(웹 탭 여러 개 포함)까지 폐기하려면 true — 웹 클라이언트가 탭 사이 회전을
# 조율하기 전까지는 꺼 둔다(뒤늦게 연 탭이 앞 탭의 토큰을 써 버려 전 탭이 로그아웃됨, #3022).
# MOMO_REFRESH_REUSE_SWEEP_ALL_SESSIONS=false
# 에이전트가 아는 "지금"(goal B8 L7) — Rust worker가 매 턴 현재 시각을 system 줄로
# 주입한다. 이 값은 워크스페이스의 벽시계 오프셋(분)이지 서버의 TZ가 아니다: 서버가
# UTC로 돌아도 읽는 사람이 서울에 있으면 "오늘"은 서울의 오늘이다.
# 기본 540(UTC+09:00), 실제 오프셋 범위 -720..840으로 클램프.
# AGENT_CONTEXT_UTC_OFFSET_MINUTES=540
# 완료 리포트 프로토콜(#1454) — Rust worker가 매 턴 시스템 맥락에 ~6줄을 싣는다.
# 기본 on. 0|false|no|off 로만 꺼지며(오타는 켠 상태 유지), 끄면 #1454 이전 맥락과 바이트 동일.
# AGENT_REPORT_PROTOCOL_ENABLED=1
# 팀 기억 요약 루프(#3162, ADR-0196) — agent-worker 프로세스 안에서 job 루프 옆으로 돈다(새 서비스 없음).
# 설정 › AI 연결 › 기본 AI 의 「요약(summary)」 행이 풀릴 때만 모델을 부른다. 행이 없거나 링크가 바뀌었으면
# 모델을 부르지 않고 audit `mem.summary.unconfigured`(reason 코드, 6시간에 1번)만 남긴다 — 다른 모델로 대체하지 않는다.
# 기본 on. 0|false|no|off 로만 꺼진다(오타는 켠 상태 유지). 워크스페이스 관리자 스위치·채널 제외·일시정지는 DB 설정(mem_settings).
# MEMORY_SUMMARY_ENABLED=1
# 한 번 훑는 주기(초, 기본 60). 창 요약 트리거: 새 메시지 ≥40건, 또는 ≥5건이 30분 조용할 때. 스레드: 답글 ≥15건 또는 ≥3건이 30분 조용할 때.
# MEMORY_SUMMARY_POLL_SECONDS=60
# MEMORY_WINDOW_MIN_MESSAGES=40
# MEMORY_WINDOW_IDLE_MIN_MESSAGES=5
# MEMORY_WINDOW_IDLE_SECONDS=1800
# MEMORY_THREAD_MIN_REPLIES=15
# MEMORY_THREAD_IDLE_MIN_REPLIES=3
# 한 번의 모델 호출에 담는 상한(메시지 수 2..200 / 프롬프트 글자 수)과 출력 토큰.
# MEMORY_WINDOW_MAX_MESSAGES=60
# MEMORY_PROMPT_MAX_CHARS=16000
# MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=800
# 워크스페이스 일일 토큰 상한(UTC 날짜 기준). 워크스페이스가 mem_settings.daily_token_cap 을 정하면 그 값이 우선한다.
# 넘으면 모델 호출 전에 멈추고 audit `mem.summary.token_cap_reached` 를 남긴다(다음 UTC 날 재개). 0 이면 요약 안 함.
# MEMORY_DAILY_TOKEN_CAP=300000
# 채널 리스(초, 기본 300; 모델 호출 전마다 갱신) — 워커가 둘이어도 한 채널은 한 워커만 요약한다.
# MEMORY_LEASE_SECONDS=300
# 요약을 한 번도 안 만든 채널은 이만큼(일) 전부터 시작한다(기본 14) — 켜자마자 몇 년치를 보내지 않도록.
# MEMORY_BACKFILL_DAYS=14
# 일/주 롤업이 거슬러 보는 범위(일 8 / 주 5)와 끝난 하루를 롤업하는 현지 시각(기본 04시; 시간대는 AGENT_CONTEXT_UTC_OFFSET_MINUTES).
# MEMORY_ROLLUP_DAYS=8
# MEMORY_ROLLUP_WEEKS=5
# MEMORY_ROLLUP_HOUR=4
# 한 채널이 한 번 훑을 때 받는 창 수(기본 3, 밀린 양은 다음 회에), 40001/23503 재시도 횟수(기본 3), 훑는 채널 상한(기본 2000).
# MEMORY_WINDOWS_PER_CHANNEL=3
# MEMORY_APPLY_RETRIES=3
# 같은 요약을 다시 만들기까지 최소 간격(초, 기본 900) — 수정 폭주로 토큰 상한이 타는 것을 막는다.
# MEMORY_REGEN_MIN_INTERVAL_SECONDS=900
# MEMORY_MAX_CHANNELS=2000
# #3168: 창 요약 호출이 항목(결정·사실·약속) 후보도 함께 돌려주게 한다. 0 이면 M1처럼 요약만.
# MEMORY_EXTRACT_ENABLED=1
# 에이전트 답에 요약을 싣기(#3163, 기본 켜짐; 0|false|no|off 로 끔). 요약 루프와 별개 스위치다.
# 예산은 대화 창(24000자)과 따로: 프레임·라벨·본문을 합친 글자 수(기본 3000), 후보 상한(기본 12),
# 서빙 전체 제한 시간(ms, 기본 3000 — 넘으면 기억 없이 답이 나간다).
# MEMORY_SERVE_ENABLED=1
# MEMORY_SERVE_BUDGET_CHARS=3000
# MEMORY_SERVE_MAX_DIGESTS=12
# MEMORY_SERVE_TIMEOUT_MS=3000
# #3169: 요약 뒤에 붙는 항목 섹션(트리거 메시지로 검색한 결정·사실·약속). 자기 예산(기본 3000자 — 요약 3000 +
# 항목 3000 = 기억 블록 6000)과 후보 상한(기본 8). 0|false|no|off 로 항목 섹션만 끈다(요약은 그대로).
# MEMORY_SERVE_ITEMS_ENABLED=1
# MEMORY_SERVE_ITEM_BUDGET_CHARS=3000
# MEMORY_SERVE_MAX_ITEMS=8
# #3172: 하루 한 번(워크스페이스 현지 04:30 슬롯) 도는 정리 잡 — 중복 병합·결정 기간 닫기·감쇠·근거가 죽은 항목 내리기·
# 보존 삭제·대기 제안 정리. 0|false|no|off 로 끄면 데이터는 그대로 두고(요약·서빙과 별개 스위치) MEMORY_SUMMARY_ENABLED=0 도 함께 끈다.
# 모델 호출은 요약과 같은 일일 토큰 상한에서 예약하고 상한의 MEMORY_CONSOLIDATE_TOKEN_SHARE_PERCENT(%)까지만 쓴다.
# 사람이 확정한 항목은 자동으로 바꾸지 않고 제안만 만든다. 보존: retired 항목·롤업이 덮은 창 요약을 N일 뒤 삭제(기본 90).
# MEMORY_CONSOLIDATE_ENABLED=1
# MEMORY_CONSOLIDATE_HOUR=4
# MEMORY_CONSOLIDATE_MINUTE=30
# MEMORY_CONSOLIDATE_POLL_SECONDS=300
# MEMORY_CONSOLIDATE_MAX_CHANNELS=2000
# MEMORY_CONSOLIDATE_MAX_CALLS=30
# MEMORY_CONSOLIDATE_TOKEN_SHARE_PERCENT=80
# MEMORY_CONSOLIDATE_MERGE_SIMILARITY=0.55
# MEMORY_CONSOLIDATE_CLOSE_SIMILARITY=0.6
# MEMORY_CONSOLIDATE_LEASE_SECONDS=900
# MEMORY_CONSOLIDATE_MAX_OUTPUT_TOKENS=40
# MEMORY_CONSOLIDATE_RETRY_SECONDS=1800
# MEMORY_RETIRED_RETENTION_DAYS=90
# MEMORY_WINDOW_RETENTION_DAYS=90
# #3172 B: 주제(L3) — 같은 채널 안에서 항목 배정, 125개에 닿으면 표본 160개로 2~4개 하위 주제로 분할, 주제 요약. 0|false|no|off 로 끔.
# MEMORY_TOPICS_ENABLED=1
# MEMORY_TOPIC_CAP=125
# MEMORY_TOPIC_SPLIT_SAMPLE=160
# MEMORY_TOPIC_MAX_ROOTS=60
# MEMORY_TOPIC_BATCH=20
# MEMORY_TOPIC_SUMMARIES_PER_RUN=5
# MEMORY_TOPIC_SUMMARY_MIN_ITEMS=3
# MEMORY_TOPIC_MAX_OUTPUT_TOKENS=400
# #3173 (MEM-M3): 항목 임베딩 + 벡터 검색 융합(에이전트 워커 안에서 로컬 모델 multilingual-e5-small int8 을 돌린다).
# 기본 켬 — 모델 디렉터리가 로드될 때만 실제로 동작하고, 없으면 한 번 경고하고 키워드만으로 서빙한다(끄려면
# 0|false|no|off). 앱 이미지에는 /opt/momo/models/e5-small-int8 로 들어 있다(빌드 때 sha256 검증).
# 임베딩 실패·시간 초과는 답을 막지 않는다(키워드 전용으로 되돌아감). 브라우저(API) 검색은 계속 키워드만이다.
# MEMORY_EMBED_ENABLED=1
# MEMORY_EMBED_MODEL_DIR=/opt/momo/models/e5-small-int8
# ORT_DYLIB_PATH=/opt/momo/lib/libonnxruntime.so   # ONNX Runtime 공유 라이브러리(이미지가 설정; 직접 실행할 때만 손댄다)
# MEMORY_EMBED_THREADS=2                # ONNX Runtime CPU 스레드(답 경로를 굶기지 않게 작게)
# MEMORY_EMBED_QUERY_TIMEOUT_MS=250     # 질문 임베딩 예산(MEMORY_SERVE_TIMEOUT_MS 안). 넘으면 키워드 전용
# MEMORY_EMBED_MIN_SIMILARITY=0.80      # 벡터 후보의 코사인 하한(e5 는 무관 문장도 0.79~0.86 이라 단독으로는 못 거른다)
# MEMORY_EMBED_MARGIN=0.04              # 가장 가까운 후보에서 이만큼 넘게 멀면 자른다(상대 문턱)
# MEMORY_EMBED_POLL_SECONDS=30          # 임베딩 스윕 주기(이 프로세스가 새 항목을 저장하면 즉시 깨어난다)
# MEMORY_EMBED_BATCH=16                 # 모델 호출당 항목 수
# MEMORY_EMBED_MAX_PER_SWEEP=200        # 워크스페이스당 스윕당 임베딩 상한 = 백필 속도 제한
# MEMORY_EMBED_MAX_WORKSPACES=1000      # 스윕이 한 번에 읽는 워크스페이스 페이지 크기(전부를 페이지로 훑는다)
# MEMORY_EMBED_MIN_MEMORY_MB=1536       # 컨테이너 메모리 한도(cgroup)가 이보다 작으면 임베딩을 끄고 경고(0=검사 안 함)
# API rate limit(MOMO-300) — in-memory sliding window(단일 노드 v0, 문서화됨).
# 0은 해당 축 비활성. /health·subscribe proxy는 제외. 비용 브레이커(budget_window)와 독립.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_PER_MEMBER=600
# RATE_LIMIT_PER_IP=1200

# Agent Port(MCP) — 기존 join limiter와 별도인 단일 노드 sliding window.
# external origin은 브라우저형 client가 Origin을 보낼 때만 필요하며 exact HTTPS만 허용한다.
# 미설정이면 no-Origin(native/server) 요청은 허용하고 present Origin은 전부 거부한다.
# MOMO_AGENT_PORT_EXTERNAL_ORIGIN=https://app.example.com
# MOMO_AGENT_PORT_RATE_LIMIT_WINDOW_SECONDS=60
# MOMO_AGENT_PORT_RATE_LIMIT_PER_TOKEN=240
# MOMO_AGENT_PORT_RATE_LIMIT_PER_AGENT=480
# MOMO_AGENT_PORT_RATE_LIMIT_PER_IP=1200

# =============================================================================
# CORS 오리진 allowlist (MOMO-605 / ADR-0133 P2) — 쉼표 구분, 완전일치.
# =============================================================================
# 웹 클라는 같은 오리진으로 서빙되므로(ADR-0119 D1-A) CORS가 필요 없다. 이 값은
# **패키징된 Tauri 데스크톱**만을 위한 것 — 릴리스 빌드의 webview 오리진이
# `tauri://localhost`(Windows/Android는 `http://tauri.localhost`)라서 `/v1/*` 호출이
# 진짜 교차 오리진이 된다. `tauri dev`는 devUrl(`http://localhost:5173`)을 그대로 쓴다.
#
#   * 미설정/빈값 = 기본값 = **완전 무변경**. 미들웨어 자체를 mount하지 않아
#     Access-Control-*/Vary 헤더가 단 하나도 붙지 않고 OPTIONS 동작도 그대로다.
#   * **와일드카드 금지**: `*`, `https://*.example.com`, 리터럴 `null`, 경로/트레일링
#     슬래시가 붙은 값은 부팅 시 거부되고 warning 로그로 알린다(허용 범위는 좁아질
#     뿐 넓어지지 않는다).
#   * credentials 정합: momo는 쿠키를 발급하지 않고 Authorization 베어러만 쓰므로
#     `Access-Control-Allow-Credentials`를 절대 보내지 않는다. 클라이언트는 fetch
#     기본값(`credentials: 'omit'`)으로 호출하고 토큰 헤더를 직접 붙일 것.
#   * Centrifugo(wss)는 별도 계약이다 — dev/e2e/내부알파는 infra/centrifugo.json의
#     `client.allowed_origins`에 같은 오리진이 이미 들어 있고, prod는 APP_DOMAIN 파생
#     (MOMO-398)이라 이 변수와 무관하다.
# MOMO_CORS_ALLOWED_ORIGINS=tauri://localhost,http://localhost:5173
