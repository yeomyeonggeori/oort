# runtime-unverified (no docker/psql) — 이 환경에는 docker/psql 부재.
# 값/연결은 정적으로만 점검됨. 실제 기동(`make up`)은 PG18+Centrifugo v6 환경에서 검증 필요.
#
# momo v0 환경변수 템플릿.
# 사용법:  cp infra/.env.example .env   →  값 채움  →  make up
# (.gitignore에 .env/.env.local 등록됨 → 실제 시크릿은 커밋되지 않음.)
#
# 시크릿 생성 예: openssl rand -hex 32

# =============================================================================
# DB — PostgreSQL 18 (SoT). docker-compose의 postgres 서비스와 정합.
# =============================================================================
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# 서버/relay/worker가 읽는 연결 문자열(컨테이너 내부는 host=postgres, 로컬은 localhost).
DATABASE_URL=postgres://momo:change-me-postgres@localhost:5432/momo

# =============================================================================
# Centrifugo v6 — transport. centrifugo.json의 ${...} 인터폴레이션 대상.
# =============================================================================
CENT_PORT=8000
# Public WebSocket endpoint advertised by login/join responses. The macOS app
# prefers this server-owned value and only falls back to its own environment.
MOMO_CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket
# client connection/subscription JWT 서명용 HMAC 시크릿(스펙 §7.1).
CENT_TOKEN_HMAC=change-me-cent-token-hmac
# server-side HTTP API(POST /api/publish) 인증 키(X-API-Key). relay만 사용(§4.3).
CENT_API_KEY=change-me-cent-api-key
# relay가 publish할 Centrifugo API 엔드포인트(컨테이너 내부 기준).
CENT_API_URL=http://centrifugo:8000/api
# subscribe proxy 콜백 공유 시크릿(MOMO-300). Centrifugo가 X-Centrifugo-Proxy-Secret
# 헤더로 붙이고 API가 검증한다. staging/prod/internal-host는 비-placeholder 필수(부팅 fail-fast).
CENT_PROXY_SECRET=change-me-cent-proxy-secret
# /v1/auth/realtime-token connection JWT TTL. 서버는 60~1800초로 clamp한다.
# CENT_CONNECTION_TOKEN_TTL_SECONDS=300

# =============================================================================
# JWT — App access/refresh 토큰(REST, HS256). 스펙 §7.1.
# =============================================================================
JWT_HMAC=change-me-jwt-hmac
# Optional dedicated outbound webhook derivation key. When unset, relay and API
# intentionally share JWT_HMAC so one-time event signing secrets remain derivable.
# OUTBOUND_WEBHOOK_MASTER_KEY=change-me-outbound-webhook-master-key
# MOMO-572 / ADR-0004 증보 1: dedicated key for the operator provider_link bearer
# (AES-GCM at rest). When unset it shares JWT_HMAC for local dev; strict envs
# (staging/prod/internal-host) must set a unique value (not JWT_HMAC, not the
# outbound key). The stored provider bearer is never logged or returned in clear.
# PROVIDER_LINK_MASTER_KEY=change-me-provider-link-master-key
# Provider cascade 전체 wall-clock 상한(ms). 각 홉의 timeout이 아니라 체인 합계다.
PROVIDER_CASCADE_TOTAL_TIMEOUT_MS=60000

# =============================================================================
# momo Cloud T3 provider adapter (ADR-0136 + ADR-0142, optional)
# =============================================================================
# T3 is unreleased and default-off while #888 redesign is in progress.
# Explicit opt-in is required in addition to a usable provider adapter.
# MOMO_T3_ENABLED=1
# Unset keeps T1/T2 fully available and makes every T3 surface return 503.
#
# ADR-0142 D1: BYOC is the base form and is the default when MOMO_T3_PROVIDER is
# unset — you attach a server you already own (docs/BYOC_CLOUD_HOST.md) and need
# no provider account or credential whatsoever.
# MOMO_T3_PROVIDER=byoc
#
# A managed substrate is one adapter registry id plus its own env namespace.
# The operator key is process-only: never expose it to a workspace, client,
# database, log, or committed file (ADR-0004).
# MOMO_T3_PROVIDER=mock-a
# MOMO_T3_PROVIDER_MOCK_A_API_BASE_URL=https://provider.example.com
# MOMO_T3_PROVIDER_MOCK_A_API_KEY=
# MOMO_T3_PROVIDER_MOCK_A_IMAGE_REF=momo-workd
# MOMO_T3_PROVIDER_MOCK_A_INSTANCE_TIMEOUT_SECONDS=3600
#
# ADR-0156 — the first managed substrate momo really boots instances on. Both
# the API (acquisition) and the notifier (reconciliation) read this namespace,
# and both fail closed on absence: no base URL + key means no adapter is built,
# so acquisition answers 503 and reconciliation refuses the id by name rather
# than aiming at a host nobody stood up.
# IMAGE_REF is the CubeSandbox **template id** (a pre-built artifact), not an
# OCI reference. MAX_INSTANCES follows the box you bought (ADR-0156 D6①) and
# SWEEP_SECONDS is the ledger reclaim period the idle safety net is 4x of
# (D6②); both fall back to conservative defaults when unset or malformed.
# MOMO_T3_PROVIDER=cubesandbox
# MOMO_T3_PROVIDER_CUBESANDBOX_API_BASE_URL=http://cube-host.internal:3000
# MOMO_T3_PROVIDER_CUBESANDBOX_API_KEY=
# MOMO_T3_PROVIDER_CUBESANDBOX_IMAGE_REF=tpl-oort-workd
# MOMO_T3_PROVIDER_CUBESANDBOX_INSTANCE_TIMEOUT_SECONDS=3600
# MOMO_T3_PROVIDER_CUBESANDBOX_MAX_INSTANCES=10
# MOMO_T3_PROVIDER_CUBESANDBOX_SWEEP_SECONDS=86400
# Public HTTPS MomoServer URL reached by the cloud workd bootstrap.
# MOMO_PUBLIC_BASE_URL=https://momo.example.com
# Snapshot the rate into each usage row so later rate changes cannot rewrite
# already accrued active time. 1 micro-USD = USD 0.000001.
# MOMO_T3_RATE_MICRO_USD_PER_SECOND=25

# =============================================================================
# LiveKit — ADR-0122 huddle SFU. Opt in with compose profile `huddle`.
# The API key/secret must match MomoServer's token issuer. Never commit real values.
# =============================================================================
MOMO_LIVEKIT_API_KEY=devkey
MOMO_LIVEKIT_API_SECRET=change-me-livekit-api-secret
MOMO_LIVEKIT_URL=ws://127.0.0.1:7880
# MOMO-646: intentionally blank until the Korean benchmark is judged.
MOMO_TRANSCRIPTION_MODEL=
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50100

# =============================================================================
# Platform admin read-only inspection (MOMO-013)
# =============================================================================
# 일반 tenant route는 DATABASE_URL(momo_app 등 NOBYPASSRLS)로 실행하고,
# /v1/platform/* 읽기 전용 조회만 별도 BYPASSRLS + SELECT-only role로 실행한다.
# 로컬 verifier가 momo_platform_admin role을 준비한다.
# PLATFORM_ADMIN_DATABASE_URL=postgres://momo_platform_admin:change-me@localhost:5432/momo
# PLATFORM_ADMIN_EMAILS=ops@momo.local
# v0 auth는 password verification stub이므로 platform:read와
# platform:credits:write 발급에는 별도 secret도 요구한다.
# PLATFORM_ADMIN_LOGIN_SECRET=change-me-platform-admin-login-secret

# =============================================================================
# hermes — Local Hermes OpenAI 호환 게이트웨이(/v1/chat/completions + SSE). 스펙 §6.2.
# =============================================================================
# local-mock=로컬 mock hermes, internal-host-mock=internal-smoke mock hermes,
# external-hermes=실제 Hermes/Kim Intern provider. staging/prod/internal-host는 external-hermes만 허용.
AGENT_PROVIDER_MODE=local-mock
AGENT_MODEL=hermes-agent
AGENT_HANDLE=hermes
AGENT_DISPLAY_NAME=Hermes
HERMES_BASE_URL=http://localhost:8088/v1
HERMES_API_KEY=change-me-hermes-bearer

# =============================================================================
# Attachment archive — ADR-0127. Default `drive` preserves Dawn operation.
# For the optional compose MinIO profile, select `s3` and keep endpoint path
# style enabled. These committed values are placeholders, never real secrets.
# =============================================================================
MOMO_ARCHIVE_BACKEND=drive
MOMO_S3_ENDPOINT=http://minio:9000
MOMO_S3_REGION=us-east-1
MOMO_S3_BUCKET=momo-attachments
MOMO_S3_ACCESS_KEY=change-me-s3-access-key
MOMO_S3_SECRET_KEY=change-me-s3-secret-key
MOMO_S3_FORCE_PATH_STYLE=1
MINIO_PORT=9000

# =============================================================================
# eve custom-agent runtime — optional compose profile `eve` (MOMO-538).
# The default stack ignores these values. Credentials are injected only into
# the eve container; use URL-safe random text for EVE_WORLD_PASSWORD.
# =============================================================================
EVE_PORT=28140
EVE_WORLD_DB=eve_world
EVE_WORLD_USER=eve_world
EVE_WORLD_PASSWORD=change-me-eve-world
EVE_WORLD_JOB_PREFIX=momo_eve
EVE_WORLD_WORKER_CONCURRENCY=10
EVE_WORLD_MAX_POOL_SIZE=10
EVE_MOMO_BASE_URL=http://host.docker.internal:8080
MOMO_WORKSPACE_ID=
MOMO_AGENT_MEMBER_ID=
MOMO_AGENT_TOKEN=
MOMO_CHANNEL_ROUTE_TOKEN=
EVE_AI_GATEWAY_API_KEY=

# Optional MOMO-325/337 Hermes gateway native-platform mode.
# Default worker mode keeps AgentWorker in charge of provider calls. Gateway mode
# broadcasts agent.job to Hermes and accepts per-agent bearer callbacks through
# momo REST. The shared secret is deprecated and disabled unless the flag is 1.
# AGENT_GATEWAY_MODE=worker
# AGENT_GATEWAY_SECRET=change-me-agent-gateway-secret
# MOMO_ALLOW_LEGACY_GATEWAY_SECRET=0

# =============================================================================
# (선택) 튜닝/오버라이드 — 모두 코드에 안전한 기본값이 있어 미설정 시 그 값으로 동작.
# 전체 목록·기본값·의미는 docs/RUN.md §2.2 참고. 자주 쓰는 것만 주석으로 노출:
# =============================================================================
# 서버 바인드(기본 0.0.0.0:8080). PORT 변경 시 centrifugo.json proxy(api:8080)도 맞출 것.
# HOST=0.0.0.0
# PORT=8080
# relay/worker 전용 BYPASSRLS(momo_relay) 접속(미설정 시 DATABASE_URL/POSTGRES_* 사용). 스펙 §2.2/§10.1.
# RELAY_DATABASE_URL=postgres://momo_relay:change-me@localhost:5432/momo
# worker 루프가드(스펙 §3.3/§3.4) — 기본 G2=3 / G3=12 / depth=4 / 동시실행=1.
# MAX_CONSECUTIVE_AUTO=3
# MAX_STEPS=12
# MAX_DEPTH=4
# MAX_CONCURRENT_RUNS=1
# 컨텍스트 조립(MOMO-302) — @mention 시 같은 채널 최근 히스토리를 hermes chat 배열로 전달.
# 서버가 payload에 담는 최근 메시지 수(기본 30, 1..200) / worker의 문자 예산(기본 24000, 초과 시 오래된 것부터 드랍).
# AGENT_CONTEXT_MAX_MESSAGES=30
# AGENT_CONTEXT_MAX_CHARS=24000
# 에이전트가 아는 "지금"(goal B8 L7) — Rust worker가 매 턴 현재 시각을 system 줄로
# 주입한다. 이 값은 워크스페이스의 벽시계 오프셋(분)이지 서버의 TZ가 아니다: 서버가
# UTC로 돌아도 읽는 사람이 서울에 있으면 "오늘"은 서울의 오늘이다.
# 기본 540(UTC+09:00), 실제 오프셋 범위 -720..840으로 클램프.
# AGENT_CONTEXT_UTC_OFFSET_MINUTES=540
# Memory Plane 추출(MOMO-526) — local-mock은 명시 marker만 처리하며,
# external-hermes는 위 HERMES_* BYOA 자격을 worker process 안에서만 사용한다.
# MEMORY_EXTRACTION_ENABLED=1
# MEMORY_EXTRACTION_POLL_INTERVAL_MS=5000
# MEMORY_EXTRACTION_BATCH_SIZE=50
# Memory embedding(MOMO-527) — local-mock은 결정적 384차원 벡터를 생성하고,
# external-hermes는 위 HERMES_* BYOA 자격을 worker process 안에서만 사용한다.
# MEMORY_EMBEDDING_ENABLED=1
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_POLL_INTERVAL_MS=5000
# MEMORY_EMBEDDING_BATCH_SIZE=50
# API rate limit(MOMO-300) — in-memory sliding window(단일 노드 v0, 문서화됨).
# 0은 해당 축 비활성. /health·subscribe proxy는 제외. 비용 브레이커(budget_window)와 독립.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_PER_MEMBER=600
# RATE_LIMIT_PER_IP=1200

# =============================================================================
# CORS 오리진 allowlist (MOMO-605 / ADR-0133 P2) — 쉼표 구분, 완전일치.
# =============================================================================
# 웹 클라는 같은 오리진으로 서빙되므로(ADR-0119 D1-A) CORS가 필요 없다. 이 값은
# **패키징된 Tauri 데스크톱**만을 위한 것 — 릴리스 빌드의 webview 오리진이
# `tauri://localhost`(Windows/Android는 `http://tauri.localhost`)라서 `/v1/*` 호출이
# 진짜 교차 오리진이 된다. `tauri dev`는 devUrl(`http://localhost:5173`)을 그대로 쓴다.
#
#   * 미설정/빈값 = 기본값 = **완전 무변경**. 미들웨어 자체를 mount하지 않아
#     Access-Control-*/Vary 헤더가 단 하나도 붙지 않고 OPTIONS 동작도 그대로다.
#   * **와일드카드 금지**: `*`, `https://*.example.com`, 리터럴 `null`, 경로/트레일링
#     슬래시가 붙은 값은 부팅 시 거부되고 warning 로그로 알린다(허용 범위는 좁아질
#     뿐 넓어지지 않는다).
#   * credentials 정합: momo는 쿠키를 발급하지 않고 Authorization 베어러만 쓰므로
#     `Access-Control-Allow-Credentials`를 절대 보내지 않는다. 클라이언트는 fetch
#     기본값(`credentials: 'omit'`)으로 호출하고 토큰 헤더를 직접 붙일 것.
#   * Centrifugo(wss)는 별도 계약이다 — dev/e2e/내부알파는 infra/centrifugo.json의
#     `client.allowed_origins`에 같은 오리진이 이미 들어 있고, prod는 APP_DOMAIN 파생
#     (MOMO-398)이라 이 변수와 무관하다.
# MOMO_CORS_ALLOWED_ORIGINS=tauri://localhost,http://localhost:5173
