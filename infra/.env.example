# runtime-unverified (no docker/psql) — 이 환경에는 docker/psql 부재.
# 값/연결은 정적으로만 점검됨. 실제 기동(`make up`)은 PG18+Centrifugo v6 환경에서 검증 필요.
#
# momo v0 환경변수 템플릿.
# 사용법:  cp infra/.env.example .env   →  값 채움  →  make up
# (.gitignore에 .env/.env.local 등록됨 → 실제 시크릿은 커밋되지 않음.)
#
# 시크릿 생성 예: openssl rand -hex 32

# =============================================================================
# DB — PostgreSQL 18 (SoT). docker-compose의 postgres 서비스와 정합.
# =============================================================================
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# 서버/relay/worker가 읽는 연결 문자열(컨테이너 내부는 host=postgres, 로컬은 localhost).
DATABASE_URL=postgres://momo:change-me-postgres@localhost:5432/momo

# =============================================================================
# Centrifugo v6 — transport. centrifugo.json의 ${...} 인터폴레이션 대상.
# =============================================================================
CENT_PORT=8000
# client connection/subscription JWT 서명용 HMAC 시크릿(스펙 §7.1).
CENT_TOKEN_HMAC=change-me-cent-token-hmac
# server-side HTTP API(POST /api/publish) 인증 키(X-API-Key). relay만 사용(§4.3).
CENT_API_KEY=change-me-cent-api-key
# relay가 publish할 Centrifugo API 엔드포인트(컨테이너 내부 기준).
CENT_API_URL=http://centrifugo:8000/api
# subscribe proxy 콜백 공유 시크릿(MOMO-300). Centrifugo가 X-Centrifugo-Proxy-Secret
# 헤더로 붙이고 API가 검증한다. staging/prod/internal-host는 비-placeholder 필수(부팅 fail-fast).
CENT_PROXY_SECRET=change-me-cent-proxy-secret
# /v1/auth/realtime-token connection JWT TTL. 서버는 60~1800초로 clamp한다.
# CENT_CONNECTION_TOKEN_TTL_SECONDS=300

# =============================================================================
# JWT — App access/refresh 토큰(REST, HS256). 스펙 §7.1.
# =============================================================================
JWT_HMAC=change-me-jwt-hmac

# =============================================================================
# Platform admin read-only inspection (MOMO-013)
# =============================================================================
# 일반 tenant route는 DATABASE_URL(momo_app 등 NOBYPASSRLS)로 실행하고,
# /v1/platform/* 읽기 전용 조회만 별도 BYPASSRLS + SELECT-only role로 실행한다.
# 로컬 verifier가 momo_platform_admin role을 준비한다.
# PLATFORM_ADMIN_DATABASE_URL=postgres://momo_platform_admin:change-me@localhost:5432/momo
# PLATFORM_ADMIN_EMAILS=ops@momo.local
# v0 auth는 password verification stub이므로 platform:read 발급에는 별도 secret도 요구한다.
# PLATFORM_ADMIN_LOGIN_SECRET=change-me-platform-admin-login-secret

# =============================================================================
# hermes — Local Hermes OpenAI 호환 게이트웨이(/v1/chat/completions + SSE). 스펙 §6.2.
# =============================================================================
# local-mock=로컬 mock hermes, internal-host-mock=internal-smoke mock hermes,
# external-hermes=실제 Hermes/Kim Intern provider. staging/prod/internal-host는 external-hermes만 허용.
AGENT_PROVIDER_MODE=local-mock
AGENT_MODEL=hermes-agent
AGENT_HANDLE=hermes
AGENT_DISPLAY_NAME=Hermes
HERMES_BASE_URL=http://localhost:8088/v1
HERMES_API_KEY=change-me-hermes-bearer

# =============================================================================
# (선택) 튜닝/오버라이드 — 모두 코드에 안전한 기본값이 있어 미설정 시 그 값으로 동작.
# 전체 목록·기본값·의미는 docs/RUN.md §2.2 참고. 자주 쓰는 것만 주석으로 노출:
# =============================================================================
# 서버 바인드(기본 0.0.0.0:8080). PORT 변경 시 centrifugo.json proxy(api:8080)도 맞출 것.
# HOST=0.0.0.0
# PORT=8080
# relay/worker 전용 BYPASSRLS(momo_relay) 접속(미설정 시 DATABASE_URL/POSTGRES_* 사용). 스펙 §2.2/§10.1.
# RELAY_DATABASE_URL=postgres://momo_relay:change-me@localhost:5432/momo
# worker 루프가드(스펙 §3.3/§3.4) — 기본 G2=3 / G3=12 / depth=4 / 동시실행=1.
# MAX_CONSECUTIVE_AUTO=3
# MAX_STEPS=12
# MAX_DEPTH=4
# MAX_CONCURRENT_RUNS=1
# API rate limit(MOMO-300) — in-memory sliding window(단일 노드 v0, 문서화됨).
# 0은 해당 축 비활성. /health·subscribe proxy는 제외. 비용 브레이커(budget_window)와 독립.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_PER_MEMBER=600
# RATE_LIMIT_PER_IP=1200
