# momo production/staging secret template.
# Example only: copy to infra/prod/secrets.env, replace every __PLACEHOLDER__,
# encrypt immediately to infra/prod/secrets.sops.env, then delete the plaintext.
#
# Generate random values with:
#   openssl rand -hex 32        # HMAC/API/DB passwords
#   openssl rand -base64 48     # pgBackRest repository cipher passphrase

# Environment identity, public routing, and image pins. These are not all
# secrets, but travel with the same deployment environment for atomic
# staging/prod promotion and prod_env_preflight coverage.
COMPOSE_PROJECT_NAME=momo-staging
MOMO_ENV=staging
SECRET_SOURCE=sops://infra/prod/secrets.sops.env
DOMAIN=__BASE_DOMAIN__
PUBLIC_BASE_URL=https://api.staging.__BASE_DOMAIN__
API_DOMAIN=api.staging.__BASE_DOMAIN__
REALTIME_DOMAIN=rt.staging.__BASE_DOMAIN__
# MOMO-390 (ADR-0119): optional web SPA domain served by Caddy on the same
# origin as /v1. Leave APP_DOMAIN commented for a web-less 2-site deploy
# (fully backward compatible). The pinned MOMO_WEB_IMAGE still populates the
# named volume so enabling the domain later needs no host bind mount.
# MOMO-398: setting APP_DOMAIN also opens Centrifugo browser realtime for
# https://<APP_DOMAIN> only — compose derives CENTRIFUGO_CLIENT_ALLOWED_ORIGINS
# from APP_DOMAIN; never set that variable here (preflight rejects drift).
# APP_DOMAIN=app.staging.__BASE_DOMAIN__
WEB_STATIC_VOLUME_NAME=momo-web-static
MOMO_CENTRIFUGO_WS_URL=wss://rt.staging.__BASE_DOMAIN__/connection/websocket
CADDY_EMAIL=ops@__BASE_DOMAIN__
ACME_EMAIL=ops@__BASE_DOMAIN__
HTTP_PORT=80
HTTPS_PORT=443
MOMO_IMAGE_TAG=__IMAGE_TAG__
MOMO_IMAGE=ghcr.io/yeomyeonggeori/momo:${MOMO_IMAGE_TAG}
# Backward-compatible aliases. Keep these derived from the one canonical ref.
MOMO_API_IMAGE=${MOMO_IMAGE}
MOMO_RELAY_IMAGE=${MOMO_IMAGE}
MOMO_WORKER_IMAGE=${MOMO_IMAGE}
MOMO_MIGRATE_IMAGE=${MOMO_IMAGE}
MOMO_WEB_IMAGE=${MOMO_IMAGE}
MOMO_LINKSHORT_IMAGE=${MOMO_IMAGE}
# Set required only for a release lane with authenticated gh access and
# published GitHub SLSA provenance. Default install remains warning-only while
# official image attestations are not yet guaranteed to exist.
MOMO_ATTESTATION_POLICY=warn

# Single-node resource ceilings. These are not secrets, but remain beside the
# atomic deployment environment so staging/prod promotion cannot drift.
MOMO_CADDY_MEM_LIMIT=256m
MOMO_POSTGRES_MEM_LIMIT=2g
MOMO_REDIS_MEM_LIMIT=512m
MOMO_CENTRIFUGO_MEM_LIMIT=512m
MOMO_API_MEM_LIMIT=1g
MOMO_RELAY_MEM_LIMIT=512m
MOMO_WORKER_MEM_LIMIT=2g
MOMO_MIGRATE_MEM_LIMIT=1g
MOMO_RUNTIME_ROLES_MEM_LIMIT=256m
MOMO_WEB_INIT_MEM_LIMIT=128m
MOMO_LINKSHORT_MEM_LIMIT=256m
MOMO_EVE_DB_ROLES_MEM_LIMIT=256m
MOMO_EVE_MEM_LIMIT=2g
MOMO_MINIO_MEM_LIMIT=1g
MOMO_MINIO_INIT_MEM_LIMIT=256m

# PostgreSQL 18 owner is initialization/migration-only. Runtime roles are
# provisioned idempotently by install/upgrade before migrations; URL-encode each
# password in its matching URL when it contains reserved characters.
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=__OPENSSL_RAND_HEX_32__
MIGRATE_DATABASE_URL=postgres://momo:__URL_ENCODED_POSTGRES_PASSWORD__@postgres:5432/momo
DB_VOLUME_NAME=momo-staging-pgdata

# API is always NOBYPASSRLS. Background consumers receive distinct BYPASSRLS
# roles so their access remains attributable and independently revocable.
MOMO_APP_POSTGRES_PASSWORD=__OPENSSL_RAND_HEX_32__
MOMO_APP_DATABASE_URL=postgres://momo_app:__URL_ENCODED_APP_POSTGRES_PASSWORD__@postgres:5432/momo
RELAY_POSTGRES_USER=momo_relay
RELAY_POSTGRES_PASSWORD=__OPENSSL_RAND_HEX_32__
RELAY_DATABASE_URL=postgres://momo_relay:__URL_ENCODED_RELAY_POSTGRES_PASSWORD__@postgres:5432/momo
WORKER_POSTGRES_USER=momo_worker
WORKER_POSTGRES_PASSWORD=__OPENSSL_RAND_HEX_32__
WORKER_DATABASE_URL=postgres://momo_worker:__URL_ENCODED_WORKER_POSTGRES_PASSWORD__@postgres:5432/momo

# Initial workspace owner. Keep both values in SOPS/host-only secret storage;
# the migrate image reads them from env and never accepts the password in argv.
MOMO_INITIAL_OWNER_EMAIL=owner@__BASE_DOMAIN__
MOMO_INITIAL_OWNER_PASSWORD=__INITIAL_OWNER_PASSWORD__

# Centrifugo v6 transport secrets.
CENT_TOKEN_HMAC=__OPENSSL_RAND_HEX_32__
CENT_API_KEY=__OPENSSL_RAND_HEX_32__
# MOMO-300 subscribe proxy shared secret (X-Centrifugo-Proxy-Secret header).
CENT_PROXY_SECRET=__OPENSSL_RAND_HEX_32__
CENT_API_URL=http://centrifugo:8000/api

# REST JWT signing.
JWT_HMAC=__OPENSSL_RAND_HEX_32__
# Independent encryption key for outbound webhook subscription secrets. Never
# reuse JWT_HMAC: rotation and compromise domains are intentionally separate.
OUTBOUND_WEBHOOK_MASTER_KEY=__OPENSSL_RAND_HEX_32__
# MOMO-572 / ADR-0004 증보 1: encryption key for the operator provider_link
# bearer (AES-GCM at rest). Generate an independent value — reusing JWT_HMAC or
# OUTBOUND_WEBHOOK_MASTER_KEY fails the boot security check in strict envs.
PROVIDER_LINK_MASTER_KEY=__OPENSSL_RAND_HEX_32__

# Agent gateway. Use the real hermes/OpenAI-compatible gateway base URL.
HERMES_BASE_URL=https://__HERMES_HOST__/v1
HERMES_API_KEY=__HERMES_BEARER_TOKEN__

# Optional eve profile. Omit all of these when eve is disabled.
EVE_WORLD_PASSWORD=__OPENSSL_RAND_HEX_32__
MOMO_WORKSPACE_ID=__EVE_MOMO_WORKSPACE_UUID__
MOMO_AGENT_MEMBER_ID=__EVE_MOMO_AGENT_MEMBER_UUID__
MOMO_AGENT_TOKEN=__EVE_MOMO_AGENT_BEARER__
MOMO_CHANNEL_ROUTE_TOKEN=__EVE_ROUTE_BEARER__
EVE_AI_GATEWAY_API_KEY=__EVE_PROVIDER_KEY__

# Centrifugo Redis engine. Add a Redis password only when MOMO-005 prod compose
# enables one, then use rediss:// or redis://:password@redis:6379 as appropriate.
REDIS_PASSWORD=__OPENSSL_RAND_HEX_32__
CENTRIFUGO_REDIS_ADDRESS=redis://:__URL_ENCODED_REDIS_PASSWORD__@redis:6379/0
REDIS_VOLUME_NAME=momo-staging-redis-data

# pgBackRest. Keep repo cipher and object-store credentials only in SOPS.
PGBACKREST_STANZA=momo
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_REPO1_CIPHER_PASS=__OPENSSL_RAND_BASE64_48__
PGBACKREST_WAL_ARCHIVE_REQUIRED=1
PGBACKREST_STANZA_CHECK_REQUIRED=1
PGBACKREST_FULL_BACKUP_REQUIRED=1
PGBACKREST_PITR_REHEARSAL_REQUIRED=1

# Optional S3-compatible repository. Leave unset for a local repo rehearsal.
# PGBACKREST_REPO1_TYPE=s3
# PGBACKREST_REPO1_S3_BUCKET=__BUCKET__
# PGBACKREST_REPO1_S3_ENDPOINT=__S3_ENDPOINT__
# PGBACKREST_REPO1_S3_REGION=__REGION__
# PGBACKREST_REPO1_S3_KEY=__ACCESS_KEY__
# PGBACKREST_REPO1_S3_KEY_SECRET=__SECRET_KEY__
