# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

# ADR-0119 v0 client. MOMO-596 (ADR-0133) moved it from clients/web to
# clients/web-legacy; it remains the artifact this image serves until the
# ADR-0133 parity gate flips serving to the new clients/web.
WORKDIR /workspace/clients/web-legacy
COPY clients/web-legacy/package.json clients/web-legacy/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY clients/web-legacy/ ./
RUN npm run build

FROM alpine:3.24

RUN mkdir -p /opt/momo-web /srv/momo-web
COPY --from=build /workspace/clients/web-legacy/dist/ /opt/momo-web/

ENTRYPOINT ["/bin/sh", "-ec", "rm -rf /srv/momo-web/* /srv/momo-web/.[!.]* /srv/momo-web/..?* 2>/dev/null || true; cp -a /opt/momo-web/. /srv/momo-web/"]
