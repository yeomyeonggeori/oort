# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /workspace/clients/web
COPY clients/web/package.json clients/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY clients/web/ ./
RUN npm run build

FROM alpine:3.21

RUN mkdir -p /opt/momo-web /srv/momo-web
COPY --from=build /workspace/clients/web/dist/ /opt/momo-web/

ENTRYPOINT ["/bin/sh", "-ec", "rm -rf /srv/momo-web/* /srv/momo-web/.[!.]* /srv/momo-web/..?* 2>/dev/null || true; cp -a /opt/momo-web/. /srv/momo-web/"]
