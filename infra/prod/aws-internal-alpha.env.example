# MOMO-233 AWS internal alpha topology preflight fixture.
# This file is intentionally non-secret. It proves the 1-week EC2 recommended
# shape for docs/static review; real operators must copy it to an untracked host
# env file and replace domains, CIDRs, IAM profile, bucket names, and image tags.

AWS_ALPHA_PROVIDER=ec2
AWS_ALPHA_TOPOLOGY=recommended
AWS_REGION=us-east-1
AWS_ALPHA_DURATION_DAYS=7

# Public names point at the one alpha host Elastic IP or Lightsail static IP.
# Use real domains before host deploy; this fixture uses public-shaped names only.
AWS_ALPHA_DOMAIN_ROOT=momo-alpha.dev
API_DOMAIN=alpha-api.momo-alpha.dev
REALTIME_DOMAIN=alpha-rt.momo-alpha.dev
MOMO_CENTRIFUGO_WS_URL=wss://alpha-rt.momo-alpha.dev/connection/websocket
TLS_MODE=caddy-http-01
ACME_EMAIL=ops@momo-alpha.dev

# Recommended v0: one EC2 app/data node. Split mode adds a private DB node.
EC2_APP_INSTANCE_TYPE=t4g.large
EC2_ROOT_VOLUME_GB=30
EC2_DATA_VOLUME_GB=120
EBS_VOLUME_TYPE=gp3
EBS_ENCRYPTED=1
IMDSV2_REQUIRED=1
IAM_INSTANCE_PROFILE=momo-alpha-host

# Source checkout stays off the host. Images must be immutable git-SHA or digest tags.
IMAGE_DEPLOY_MODE=registry-pinned
SOURCE_CHECKOUT_ON_HOST=0
MOMO_IMAGE_TAG=sha-0123456789abcdef0123456789abcdef01234567
MOMO_IMAGE=ghcr.io/yeomyeonggeori/oort:${MOMO_IMAGE_TAG}
MOMO_API_IMAGE=${MOMO_IMAGE}
MOMO_RELAY_IMAGE=${MOMO_IMAGE}
MOMO_WORKER_IMAGE=${MOMO_IMAGE}
MOMO_MIGRATE_IMAGE=${MOMO_IMAGE}
MOMO_WEB_IMAGE=${MOMO_IMAGE}
MOMO_LINKSHORT_IMAGE=${MOMO_IMAGE}

# Placement contract.
CADDY_PLACEMENT=app-node
API_PLACEMENT=app-node
RELAY_PLACEMENT=app-node
WORKER_PLACEMENT=app-node
LINKSHORT_PLACEMENT=app-node
CENTRIFUGO_PLACEMENT=app-node
REDIS_PLACEMENT=app-node
POSTGRES_PLACEMENT=app-node

# Security group intent. Replace SSH CIDRs with operator VPN/office IP ranges.
SECURITY_GROUP_SSH_CIDRS=203.0.113.10/32
SECURITY_GROUP_HTTP_CIDRS=0.0.0.0/0
SECURITY_GROUP_HTTPS_CIDRS=0.0.0.0/0
EXPOSE_POSTGRES=0
EXPOSE_REDIS=0
EXPOSE_CENTRIFUGO=0
EXPOSE_API_DIRECT=0

# Backup/restore/rollback contract.
DB_BACKUP_STRATEGY=pgbackrest-s3+ebs-snapshot
S3_BACKUP_BUCKET=momo-alpha-pgbackrest-us-east-1
S3_BACKUP_STORAGE_CLASS=STANDARD
EBS_SNAPSHOT_RETENTION_DAYS=7
PGBACKREST_RETENTION_FULL=2
DB_RESTORE_REHEARSAL_REQUIRED=1
ROLLBACK_STRATEGY=previous-image+snapshot-restore
