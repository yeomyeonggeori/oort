# MOMO-005 staging/prod skeleton env example.
# Copy to a host-local env file or encrypt with SOPS/age in MOMO-006.
# Never commit real values. Generate secrets with: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Compose / domains / TLS
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=momo-staging
MOMO_ENV=staging
SECRET_SOURCE=__SOPS_OR_HOST_ENV_SOURCE__
PUBLIC_BASE_URL=https://api.staging.example.com
API_DOMAIN=api.staging.example.com
REALTIME_DOMAIN=rt.staging.example.com
CADDY_EMAIL=ops@example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Images
# These tags are placeholders until the deploy pipeline publishes runtime images.
# -----------------------------------------------------------------------------
MOMO_API_IMAGE=ghcr.io/dawn-kim-official/momo-server:staging
MOMO_RELAY_IMAGE=ghcr.io/dawn-kim-official/momo-outbox-relay:staging
MOMO_WORKER_IMAGE=ghcr.io/dawn-kim-official/momo-agent-worker:staging

# -----------------------------------------------------------------------------
# PostgreSQL 18
# DATABASE_URL uses the compose-internal host name because api runs in Docker.
# RELAY_DATABASE_URL should point at a BYPASSRLS role prepared by the DB runbook.
# -----------------------------------------------------------------------------
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgres://momo:change-me-postgres@postgres:5432/momo
RELAY_DATABASE_URL=postgres://momo_relay:change-me-relay@postgres:5432/momo
DB_VOLUME_NAME=__DB_VOLUME_NAME__

# -----------------------------------------------------------------------------
# Redis for Centrifugo engine
# Keep REDIS_PASSWORD and CENTRIFUGO_REDIS_ADDRESS in sync.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
CENTRIFUGO_REDIS_ADDRESS=redis://:change-me-redis@redis:6379/0
REDIS_VOLUME_NAME=__REDIS_VOLUME_NAME__

# -----------------------------------------------------------------------------
# Centrifugo v6
# Secrets are injected as CENTRIFUGO_* env overrides by docker-compose.prod.yml.
# -----------------------------------------------------------------------------
CENT_TOKEN_HMAC=change-me-cent-token-hmac
CENT_API_KEY=change-me-cent-api-key
CENTRIFUGO_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API JWT
# -----------------------------------------------------------------------------
JWT_HMAC=change-me-jwt-hmac
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# hermes / Kim Intern OpenAI-compatible gateway
# staging/prod/internal-host fail fast unless AGENT_PROVIDER_MODE=external-hermes,
# HERMES_BASE_URL is HTTPS, and HERMES_API_KEY is non-placeholder.
# -----------------------------------------------------------------------------
AGENT_PROVIDER_MODE=external-hermes
AGENT_MODEL=hermes-agent
AGENT_HANDLE=kim-intern
AGENT_DISPLAY_NAME=김인턴
HERMES_BASE_URL=https://hermes.example.com/v1
HERMES_API_KEY=change-me-hermes-bearer

# -----------------------------------------------------------------------------
# pgBackRest / WAL / PITR host evidence requirements
# These are placeholders in this example. staging/prod preflight requires real
# SOPS/host-injected values and explicit required=1 acknowledgements.
# -----------------------------------------------------------------------------
PGBACKREST_STANZA=momo
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_REPO1_CIPHER_PASS=__PGBACKREST_CIPHER_PASS__
PGBACKREST_WAL_ARCHIVE_REQUIRED=1
PGBACKREST_STANZA_CHECK_REQUIRED=1
PGBACKREST_FULL_BACKUP_REQUIRED=1
PGBACKREST_PITR_REHEARSAL_REQUIRED=1

# -----------------------------------------------------------------------------
# Relay / worker tuning
# -----------------------------------------------------------------------------
RELAY_POLL_INTERVAL_MS=300
RELAY_CLAIM_BATCH=64
RELAY_MAX_ATTEMPTS=8
WORKER_POLL_INTERVAL_MS=300
WORKER_MAX_ATTEMPTS=8
MAX_CONSECUTIVE_AUTO=3
MAX_STEPS=12
MAX_DEPTH=4
MAX_CONCURRENT_RUNS=1
