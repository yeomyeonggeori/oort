# MOMO-005 staging/prod skeleton env example.
# Copy to a host-local env file or encrypt with SOPS/age in MOMO-006.
# Never commit real values. Generate secrets with: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Compose / domains / TLS
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=momo-staging
MOMO_ENV=staging
SECRET_SOURCE=__SOPS_OR_HOST_ENV_SOURCE__
PUBLIC_BASE_URL=https://api.staging.example.com
API_DOMAIN=api.staging.example.com
REALTIME_DOMAIN=rt.staging.example.com
# MOMO-390 (ADR-0119): optional web SPA domain (same-origin /v1 proxy).
# Unset = web serving disabled; the existing 2-site deploy is unchanged.
# MOMO-398: setting APP_DOMAIN also opens Centrifugo browser realtime for
# https://<APP_DOMAIN> only (compose derives CENTRIFUGO_CLIENT_ALLOWED_ORIGINS
# from APP_DOMAIN — never set that variable directly; preflight rejects drift).
# APP_DOMAIN=app.staging.example.com
WEB_STATIC_VOLUME_NAME=momo-web-static
MOMO_CENTRIFUGO_WS_URL=wss://rt.staging.example.com/connection/websocket
CADDY_EMAIL=ops@example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Images
# MOMO_IMAGE is the canonical multi-command image. The six aliases are retained
# so existing automation/env files remain valid; shipped defaults all expand to
# the same ref. For deploy/rollback, pin MOMO_IMAGE to @sha256 and keep aliases
# derived from it.
# -----------------------------------------------------------------------------
MOMO_IMAGE_TAG=sha-0123456789abcdef0123456789abcdef01234567
MOMO_IMAGE=ghcr.io/yeomyeonggeori/momo:${MOMO_IMAGE_TAG}
MOMO_API_IMAGE=${MOMO_IMAGE}
MOMO_RELAY_IMAGE=${MOMO_IMAGE}
MOMO_WORKER_IMAGE=${MOMO_IMAGE}
MOMO_MIGRATE_IMAGE=${MOMO_IMAGE}
MOMO_WEB_IMAGE=${MOMO_IMAGE}
MOMO_LINKSHORT_IMAGE=${MOMO_IMAGE}
# warn: gh missing or an unpublished provenance attestation is reported but
# installation continues. Use required only in a release lane where gh auth and
# GitHub SLSA provenance publication are guaranteed.
MOMO_ATTESTATION_POLICY=warn

# -----------------------------------------------------------------------------
# PostgreSQL 18 (MOMO-554 role posture)
# The owner role is initialization/migration-only. install/upgrade provision the
# runtime roles idempotently before migrations: momo_app (API, NOBYPASSRLS) and
# momo_relay/momo_worker (BYPASSRLS background consumers). URLs use the
# compose-internal host name because all services run in Docker.
# -----------------------------------------------------------------------------
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres
MIGRATE_DATABASE_URL=postgres://momo:change-me-postgres@postgres:5432/momo
MOMO_APP_POSTGRES_PASSWORD=change-me-app
MOMO_APP_DATABASE_URL=postgres://momo_app:change-me-app@postgres:5432/momo
RELAY_POSTGRES_PASSWORD=change-me-relay
RELAY_DATABASE_URL=postgres://momo_relay:change-me-relay@postgres:5432/momo
WORKER_POSTGRES_PASSWORD=change-me-worker
WORKER_DATABASE_URL=postgres://momo_worker:change-me-worker@postgres:5432/momo
DB_VOLUME_NAME=__DB_VOLUME_NAME__

# Initial workspace owner. install.sh consumes these only through the migrate
# image environment and never prints them. A later `migrate set-owner` run is a
# credential rotation and revokes the owner's active sessions.
MOMO_INITIAL_OWNER_EMAIL=owner@example.com
MOMO_INITIAL_OWNER_PASSWORD=change-me-initial-owner-password

# -----------------------------------------------------------------------------
# Redis for Centrifugo engine
# Keep REDIS_PASSWORD and CENTRIFUGO_REDIS_ADDRESS in sync.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
CENTRIFUGO_REDIS_ADDRESS=redis://:change-me-redis@redis:6379/0
REDIS_VOLUME_NAME=__REDIS_VOLUME_NAME__

# -----------------------------------------------------------------------------
# Centrifugo v6
# Secrets are injected as CENTRIFUGO_* env overrides by docker-compose.prod.yml.
# -----------------------------------------------------------------------------
CENT_TOKEN_HMAC=change-me-cent-token-hmac
CENT_API_KEY=change-me-cent-api-key
# MOMO-300 subscribe proxy shared secret (X-Centrifugo-Proxy-Secret header).
CENT_PROXY_SECRET=change-me-cent-proxy-secret
CENTRIFUGO_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API JWT
# -----------------------------------------------------------------------------
JWT_HMAC=change-me-jwt-hmac
# Independent encryption key for outbound webhook subscription secrets. Never
# reuse JWT_HMAC: rotation and compromise domains are intentionally separate.
OUTBOUND_WEBHOOK_MASTER_KEY=change-me-outbound-webhook-master-key
# MOMO-572 / ADR-0004 증보 1: encryption key for the operator provider_link
# bearer (AES-GCM at rest). Must be unique — not JWT_HMAC and not the outbound
# key — so provider-credential and signing key compromise domains stay separate.
PROVIDER_LINK_MASTER_KEY=change-me-provider-link-master-key
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS origin allowlist (MOMO-605 / ADR-0133 P2) — comma separated, exact match.
# -----------------------------------------------------------------------------
# NOT needed for the web SPA: Caddy serves it and proxies /v1/* on the same
# APP_DOMAIN origin (ADR-0119 D1-A), so browsers never make a cross-origin call.
# This knob exists only for a packaged desktop webview, whose origin is
# `tauri://localhost` (`http://tauri.localhost` on Windows/Android) and cannot be
# derived from any domain — which is why, unlike the MOMO-398 Centrifugo
# allowance, it is an explicit operator value rather than an APP_DOMAIN
# derivation.
#
#   * Unset/empty is the shipped default and means NO CHANGE AT ALL: the server
#     mounts no CORS middleware, so not one Access-Control-*/Vary header is
#     emitted and OPTIONS behaves exactly as before.
#   * Wildcards are refused. `*`, `https://*.example.com`, the literal `null`,
#     and values carrying a path/trailing slash are dropped at boot with a
#     warning — a typo can only ever narrow the allowlist, never widen it.
#   * Credentials stay off: momo sets no cookies and authenticates with an
#     Authorization bearer, so `Access-Control-Allow-Credentials` is never sent
#     and the unsafe `Allow-Origin: *` + credentials pair is unrepresentable.
#   * Realtime is a separate contract: prod Centrifugo origins are still derived
#     from APP_DOMAIN only (MOMO-398). Do not set
#     CENTRIFUGO_CLIENT_ALLOWED_ORIGINS here — preflight rejects that drift.
# MOMO_CORS_ALLOWED_ORIGINS=tauri://localhost

# -----------------------------------------------------------------------------
# hermes / Kim Intern OpenAI-compatible gateway
# staging/prod/internal-host fail fast unless AGENT_PROVIDER_MODE=external-hermes,
# HERMES_BASE_URL is HTTPS, and HERMES_API_KEY is non-placeholder.
# -----------------------------------------------------------------------------
AGENT_PROVIDER_MODE=external-hermes
AGENT_MODEL=hermes-agent
AGENT_HANDLE=kim-intern
AGENT_DISPLAY_NAME=김인턴
HERMES_BASE_URL=https://hermes.example.com/v1
HERMES_API_KEY=change-me-hermes-bearer
# 비동기 memory_item embedding. 자격증명은 위 worker-local Hermes BYOA 경로만 사용한다.
MEMORY_EMBEDDING_ENABLED=1
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_POLL_INTERVAL_MS=5000
MEMORY_EMBEDDING_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# Optional eve custom-agent runtime (`docker compose --profile eve ...`).
# Keep its Workflow world in the separate eve_world database. All three
# credential values are placeholders and must come from the host secret source.
# -----------------------------------------------------------------------------
EVE_PORT=28140
EVE_RUNTIME_VOLUME_NAME=momo-staging-eve-runtime
EVE_WORLD_DB=eve_world
EVE_WORLD_USER=eve_world
EVE_WORLD_PASSWORD=change-me-eve-world
EVE_WORLD_JOB_PREFIX=momo_eve
EVE_WORLD_WORKER_CONCURRENCY=10
EVE_WORLD_MAX_POOL_SIZE=10
EVE_MOMO_BASE_URL=http://api:8080
MOMO_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
MOMO_AGENT_MEMBER_ID=00000000-0000-7000-8000-000000000103
MOMO_AGENT_TOKEN=change-me-eve-momo-agent-token
MOMO_CHANNEL_ROUTE_TOKEN=change-me-eve-route-token
EVE_AI_GATEWAY_API_KEY=change-me-eve-provider-key

# -----------------------------------------------------------------------------
# Optional WH-1 work host sidecar (`docker compose --profile workhost ...`).
# The sidecar never starts without the profile, but compose interpolates every
# service before it filters profiles — so these two must exist here or `docker
# compose --env-file infra/prod/.env.example ... config` fails for everyone,
# including the docs gate's eve drift check. Both are placeholders: pin the real
# image digest and the real workspace UUID from the host secret source before
# selecting the profile.
# -----------------------------------------------------------------------------
MOMO_WORKHOST_IMAGE=ghcr.io/yeomyeonggeori/momo-workhost:change-me-workhost-tag
MOMO_WORKHOST_WORKSPACE_ID=00000000-0000-7000-8000-000000000001

# -----------------------------------------------------------------------------
# Attachment archive — default Drive; self-host MinIO is opt-in with
# `MOMO_ARCHIVE_BACKEND=s3` and compose `--profile s3`.
# -----------------------------------------------------------------------------
MOMO_ARCHIVE_BACKEND=drive
# MOMO_S3_ENDPOINT=https://files.staging.example.com
# MOMO_S3_REGION=us-east-1
# MOMO_S3_BUCKET=momo-attachments
# MOMO_S3_ACCESS_KEY=change-me-s3-access-key
# MOMO_S3_SECRET_KEY=change-me-s3-secret-key
# MOMO_S3_FORCE_PATH_STYLE=1
# MINIO_PUBLIC_DOMAIN=files.staging.example.com
# MINIO_VOLUME_NAME=momo-minio-data

# -----------------------------------------------------------------------------
# pgBackRest / WAL / PITR host evidence requirements
# These are placeholders in this example. staging/prod preflight requires real
# SOPS/host-injected values and explicit required=1 acknowledgements.
# -----------------------------------------------------------------------------
PGBACKREST_STANZA=momo
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_REPO1_CIPHER_PASS=__PGBACKREST_CIPHER_PASS__
PGBACKREST_WAL_ARCHIVE_REQUIRED=1
PGBACKREST_STANZA_CHECK_REQUIRED=1
PGBACKREST_FULL_BACKUP_REQUIRED=1
PGBACKREST_PITR_REHEARSAL_REQUIRED=1

# -----------------------------------------------------------------------------
# Relay / worker tuning
# -----------------------------------------------------------------------------
RELAY_POLL_INTERVAL_MS=300
RELAY_CLAIM_BATCH=64
RELAY_MAX_ATTEMPTS=8
WORKER_POLL_INTERVAL_MS=300
WORKER_MAX_ATTEMPTS=8
# Whole provider chain wall-clock cap; a hop gets only the remaining allowance.
PROVIDER_CASCADE_TOTAL_TIMEOUT_MS=60000
MAX_CONSECUTIVE_AUTO=3
MAX_STEPS=12
MAX_DEPTH=4
MAX_CONCURRENT_RUNS=1

# -----------------------------------------------------------------------------
# Per-service Docker memory ceilings
# Keep these explicit so one runaway service cannot exhaust a single-node host.
# One-shot helpers use smaller ceilings; agent/eve workloads retain headroom.
# -----------------------------------------------------------------------------
MOMO_CADDY_MEM_LIMIT=256m
MOMO_POSTGRES_MEM_LIMIT=2g
MOMO_REDIS_MEM_LIMIT=512m
MOMO_CENTRIFUGO_MEM_LIMIT=512m
MOMO_API_MEM_LIMIT=1g
MOMO_RELAY_MEM_LIMIT=512m
MOMO_WORKER_MEM_LIMIT=2g
MOMO_MIGRATE_MEM_LIMIT=1g
MOMO_RUNTIME_ROLES_MEM_LIMIT=256m
MOMO_WEB_INIT_MEM_LIMIT=128m
MOMO_LINKSHORT_MEM_LIMIT=256m
MOMO_EVE_DB_ROLES_MEM_LIMIT=256m
MOMO_EVE_MEM_LIMIT=2g
MOMO_MINIO_MEM_LIMIT=1g
MOMO_MINIO_INIT_MEM_LIMIT=256m
