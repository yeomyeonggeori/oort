{
    email {$ACME_EMAIL}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

{$API_DOMAIN} {
    import security_headers
    encode zstd gzip

    # MOMO-300: the Centrifugo subscribe-proxy callback is internal-only —
    # Centrifugo reaches the api service over the compose network, never via
    # this edge. The route authenticates with CENT_PROXY_SECRET and is excluded
    # from API rate limiting, so exposing it publicly would open an unmetered
    # brute-force surface. Deny it at the edge (403, fail closed).
    handle /v1/centrifugo/* {
        respond "forbidden" 403
    }

    # ADR-0121 D7: metrics is a separate compose-private listener. Keep an
    # explicit edge deny so future API router changes cannot expose it.
    handle /metrics {
        respond "not found" 404
    }

    handle {
        reverse_proxy api:8080
    }
}

{$REALTIME_DOMAIN} {
    import security_headers
    encode zstd gzip
    reverse_proxy centrifugo:8000
}

# ADR-0127: optional public S3-compatible data plane. Presigned PUT/GET URLs
# must be reachable by clients over HTTPS, while MinIO itself remains only on
# the private compose network. Unset deployments keep a reserved .localhost
# sentinel that answers 404 and never contacts the absent profile service.
{$MINIO_PUBLIC_DOMAIN:momo-minio-domain-unset.localhost} {
    import security_headers

    @s3_endpoint_unset host momo-minio-domain-unset.localhost
    handle @s3_endpoint_unset {
        respond "MINIO_PUBLIC_DOMAIN is not configured" 404
    }

    handle {
        reverse_proxy minio:9000
    }
}

# MOMO-390 (ADR-0119 D1-A): the workspace representative domain serves the web
# SPA and proxies /v1/* to the api container on the same origin, so the browser
# client needs no CORS and the server stays unchanged. The api container never
# serves web assets; Caddy's file_server does.
#
# APP_DOMAIN is optional. When it is not configured, the site address falls
# back to the reserved sentinel below and the site fails closed:
#   - `.localhost` names always receive a locally-signed certificate from
#     Caddy's internal CA — no ACME traffic, no public issuance attempt;
#   - the @app_domain_unset guard matches every request on the sentinel host
#     and answers 404 before the /v1 proxy and file handlers (the Caddyfile
#     adapter orders this host-matcher handle ahead of the path handles;
#     scripts/web_serving_smoke.sh asserts that ordering at runtime);
#   - the {$API_DOMAIN}/{$REALTIME_DOMAIN} sites above are untouched, so a
#     deploy without APP_DOMAIN keeps the existing 2-site behavior.
# NOTE: a set-but-empty APP_DOMAIN is not parseable by Caddy (empty site
# address). The prod compose maps it as `${APP_DOMAIN:-<sentinel>}` so the
# container-side value can never be empty; keep that guard when running this
# file outside compose.
{$APP_DOMAIN:momo-app-domain-unset.localhost} {
    import security_headers
    encode zstd gzip

    @app_domain_unset host momo-app-domain-unset.localhost
    handle @app_domain_unset {
        respond "APP_DOMAIN is not configured" 404
    }

    # MOMO-300: same edge rule as {$API_DOMAIN} — the Centrifugo
    # subscribe-proxy callback is internal-only. Deny it here too (403,
    # fail closed) so the rate-limit-excluded route is never web-reachable.
    handle /v1/centrifugo/* {
        respond "forbidden" 403
    }

    # The SPA fallback would otherwise turn /metrics into index.html (200).
    handle /metrics {
        respond "not found" 404
    }

    handle /v1/* {
        reverse_proxy api:8080
    }

    handle /health {
        reverse_proxy api:8080
    }

    # ADR-0121 D2: resolve short links before the SPA fallback. LinkShort is
    # stateless and only redirects to this site's /join?code=... landing.
    handle /i/* {
        reverse_proxy linkshort:28190
    }

    handle {
        root * /srv/momo-web
        # ADR-0119 D3-A: Vite emits external scripts, so default-src 'self'
        # keeps inline script blocked. React's current CSS does not require an
        # inline script hash; style-src keeps the ADR-approved inline style
        # allowance. connect-src permits both realtime transport schemes.
        #
        # #1207: www.googleapis.com is in connect-src because ADR-0151 D1 puts
        # the attachment bytes on a path that never touches this server — the
        # browser PUTs them straight to the Drive resumable session URL. The
        # host was already trusted with those bytes; naming it here only makes
        # the declaration match the data path (clients/web/.../uploadTransport.ts).
        # Nothing else is added: every other attachment call is same-origin /v1.
        header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$REALTIME_DOMAIN} https://{$REALTIME_DOMAIN} https://www.googleapis.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
        # SPA routing fallback: unknown paths rewrite to index.html.
        try_files {path} /index.html
        file_server
    }
}
