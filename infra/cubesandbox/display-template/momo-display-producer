# W3C `KeyboardEvent.code` (a PHYSICAL key) -> X keysym name.
#
# The contract carries the physical key and never the character the browser
# produced from it (template.spec.json `inputChannel.carriesCharacter: false`,
# ADR-0004 증보 3 D2), so this table is the whole translation and there is no
# text path to fall back on. What the key PRODUCES is then the far side's
# layout — a `KeyA` lands as whatever the VM's own keymap says `a` is, which is
# the point: the character of a password never forms as a value the browser
# client owns.
#
# Unlisted codes are dropped rather than guessed at. A guess here would be a
# keystroke the person did not press arriving in a shell.
KEYSYM_BY_CODE = {
    **{f"Key{c}": c.lower() for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"},
    **{f"Digit{d}": d for d in "0123456789"},
    **{f"F{n}": f"F{n}" for n in range(1, 25)},
    "Enter": "Return",
    "NumpadEnter": "KP_Enter",
    "Space": "space",
    "Backspace": "BackSpace",
    "Tab": "Tab",
    "Escape": "Escape",
    "Minus": "minus",
    "Equal": "equal",
    "BracketLeft": "bracketleft",
    "BracketRight": "bracketright",
    "Backslash": "backslash",
    "Semicolon": "semicolon",
    "Quote": "apostrophe",
    "Backquote": "grave",
    "Comma": "comma",
    "Period": "period",
    "Slash": "slash",
    "IntlBackslash": "less",
    "CapsLock": "Caps_Lock",
    "ShiftLeft": "Shift_L",
    "ShiftRight": "Shift_R",
    "ControlLeft": "Control_L",
    "ControlRight": "Control_R",
    "AltLeft": "Alt_L",
    "AltRight": "Alt_R",
    "MetaLeft": "Super_L",
    "MetaRight": "Super_R",
    "ContextMenu": "Menu",
    "ArrowLeft": "Left",
    "ArrowRight": "Right",
    "ArrowUp": "Up",
    "ArrowDown": "Down",
    "Home": "Home",
    "End": "End",
    "PageUp": "Prior",
    "PageDown": "Next",
    "Insert": "Insert",
