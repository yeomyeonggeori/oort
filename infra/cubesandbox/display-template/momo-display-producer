# Wheel direction -> X button. X has no scroll axis; it has four buttons, and
# every X client already reads them as scrolling.
WHEEL_BUTTON_UP = 4
WHEEL_BUTTON_DOWN = 5
WHEEL_BUTTON_LEFT = 6
WHEEL_BUTTON_RIGHT = 7

# A browser wheel `deltaY` is device-dependent (pixels, lines or pages); what
# survives translation is the SIGN and a bounded count. Unbounded would let one
# frame hold the far side's scroll for a minute.
MAX_WHEEL_CLICKS = 10
WHEEL_PIXELS_PER_CLICK = 53.0


class InputRefused(Exception):
    """A frame that will not be injected, and the reason a log line can carry."""


class X11InputSink:
    """Turns validated input frames into XTEST events on the local X server.

    XTEST rather than writing to a device node: the events enter the same X
    server the capture pipeline is reading, so what the person sees confirmed on
    their screen is the event that was actually delivered — there is no second
    input path that could succeed while the picture disagrees.

    Every method here assumes the frame is ALREADY validated. Parsing lives in
    `input_frame_action` so that a malformed frame is refused before anything
    touches the display, and so the parse can be tested without an X server.
    """

    def __init__(self, display_name: str) -> None:
        # Debian `python3-xlib`, not pip; imported here so an observer-only
        # instance without the package still starts and still streams.
        from Xlib import X, XK, display as xlib_display
        from Xlib.ext import xtest

        self._X = X
        self._XK = XK
        self._xtest = xtest
        self._display = xlib_display.Display(display_name)
        if not self._display.has_extension("XTEST"):
            raise RuntimeError("X server has no XTEST extension")
        screen = self._display.screen()
        self.width = screen.width_in_pixels
        self.height = screen.height_in_pixels
        # Xlib's display object is not thread-safe and the datachannel delivers
        # from GLib's loop thread while the revalidation loop runs in another.
        self._lock = threading.Lock()
        self._keycodes: dict[str, int] = {}
        log(f"input: XTEST ready on {display_name} ({self.width}x{self.height})")

    def keycode_for(self, code: str) -> int:
        """Resolve a W3C code to an X keycode on THIS server's keymap."""
        cached = self._keycodes.get(code)
        if cached is not None:
            return cached
        keysym_name = KEYSYM_BY_CODE.get(code)
        if keysym_name is None:
            raise InputRefused(f"unmapped key code {code!r}")
        keysym = self._XK.string_to_keysym(keysym_name)
        if not keysym:
            raise InputRefused(f"no keysym for {keysym_name!r}")
        keycode = self._display.keysym_to_keycode(keysym)
        if not keycode:
            raise InputRefused(f"keysym {keysym_name!r} is not on this keymap")
        self._keycodes[code] = keycode
        return keycode

    def key(self, action: str, code: str) -> None:
        keycode = self.keycode_for(code)
        event = self._X.KeyPress if action == "down" else self._X.KeyRelease
        with self._lock:
            self._xtest.fake_input(self._display, event, keycode)
            self._display.sync()

    def pointer_move(self, x: float, y: float) -> None:
        # Normalised 0..1 over the video box, so the VM's resolution stays the
        # VM's — the client never learns it and never has to.
        px = max(0, min(self.width - 1, int(round(x * (self.width - 1)))))
        py = max(0, min(self.height - 1, int(round(y * (self.height - 1)))))
        with self._lock:
            self._xtest.fake_input(self._display, self._X.MotionNotify, x=px, y=py)
            self._display.sync()

    def pointer_button(self, action: str, x: float, y: float, button: int) -> None:
        # Move first: a click carries its own position, and a button press at a
        # stale pointer would land somewhere the person was not pointing.
        self.pointer_move(x, y)
        event = self._X.ButtonPress if action == "down" else self._X.ButtonRelease
        with self._lock:
            self._xtest.fake_input(self._display, event, button)
            self._display.sync()

    def wheel(self, dx: float, dy: float) -> None:
        with self._lock:
            for delta, negative, positive in (
                (dy, WHEEL_BUTTON_UP, WHEEL_BUTTON_DOWN),
                (dx, WHEEL_BUTTON_LEFT, WHEEL_BUTTON_RIGHT),
            ):
                if not delta:
                    continue
                button = positive if delta > 0 else negative
                clicks = min(
                    MAX_WHEEL_CLICKS,
                    max(1, int(round(abs(delta) / WHEEL_PIXELS_PER_CLICK))),
                )
                for _ in range(clicks):
                    self._xtest.fake_input(self._display, self._X.ButtonPress, button)
                    self._xtest.fake_input(self._display, self._X.ButtonRelease, button)
            self._display.sync()

    def close(self) -> None:
        try:
            self._display.close()
        except Exception:  # noqa: BLE001
            pass


def input_frame_action(message) -> tuple:
    """Validate one input frame against the declared contract.

    Returns a `(kind, *args)` tuple the sink can apply, or raises
    [`InputRefused`]. Split out from the sink so the CONTRACT can be exercised
    without an X server, and so a frame is refused before it can move anything.

    The shape it enforces is `template.spec.json`'s `signalling.inputChannel`,
    including the part that reads like a detail and is not: `button` is absent
    on a MOVE rather than sent as zero. A producer that required `button` on
    every pointer frame would drop every move — clicks would keep working and
    the cursor would never travel, which looks like a network problem and is
    not.
    """
    if not isinstance(message, dict):
        raise InputRefused("frame is not an object")
    kind = message.get("type")
    action = message.get("action")
    if not isinstance(action, str):
        raise InputRefused("frame has no action")

    if kind == "key":
        if action not in ("down", "up"):
            raise InputRefused(f"key action {action!r}")
        code = message.get("code")
        if not isinstance(code, str) or not code:
            raise InputRefused("key frame has no code")
        # `carriesCharacter: false` is enforced, not assumed. A client that sent
        # the produced character would be handing this producer a value the
        # contract says never forms on that side — refusing it keeps the one
        # rule that makes a remote password a physical-key sequence.
        if "key" in message or "char" in message or "text" in message:
            raise InputRefused("key frame carried a character")
        return ("key", action, code)

    if kind == "pointer":
        if action not in ("move", "down", "up"):
            raise InputRefused(f"pointer action {action!r}")
        x, y = message.get("x"), message.get("y")
        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):
            raise InputRefused("pointer frame has no position")
        if not (0.0 <= float(x) <= 1.0 and 0.0 <= float(y) <= 1.0):
            raise InputRefused("pointer position is not normalised 0..1")
        if action == "move":
            if "button" in message:
                raise InputRefused("move carried a button")
            return ("pointer_move", float(x), float(y))
        button = message.get("button")
        if not isinstance(button, int) or isinstance(button, bool):
            raise InputRefused("pointer down/up has no button")
        # Browser button numbering (0 left, 1 middle, 2 right) -> X (1, 2, 3).
        x_button = {0: 1, 1: 2, 2: 3}.get(button)
        if x_button is None:
            raise InputRefused(f"unsupported button {button!r}")
        return ("pointer_button", action, float(x), float(y), x_button)

    if kind == "wheel":
        if action != "scroll":
            raise InputRefused(f"wheel action {action!r}")
        dx, dy = message.get("dx"), message.get("dy")
        if not isinstance(dx, (int, float)) or not isinstance(dy, (int, float)):
            raise InputRefused("wheel frame has no delta")
        return ("wheel", float(dx), float(dy))

    raise InputRefused(f"unknown frame type {kind!r}")


# ---------------------------------------------------------------------------
# The GStreamer half
# ---------------------------------------------------------------------------

PIPELINE = (
    f"ximagesrc display-name={X11} use-damage=0 show-pointer=false "
    "! video/x-raw,framerate=15/1 "
    "! videoconvert ! queue max-size-buffers=2 leaky=downstream "
    "! x264enc tune=zerolatency speed-preset=ultrafast bitrate=1500 key-int-max=30 "
    "! video/x-h264,profile=constrained-baseline "
    "! h264parse config-interval=-1 "
    "! rtph264pay pt=96 config-interval=-1 "
    "! application/x-rtp,media=video,encoding-name=H264,payload=96 "
    "! webrtcbin name=sendonly latency=50"
)


class Session:
    """One viewer, one peer connection. Media is sendonly; there is no data path."""

    def __init__(
        self,
        peer: Peer,
        display_id: str,
        mode: str,
        ice_servers=None,
        input_enabled: bool = False,
    ) -> None:
        self.peer = peer
        self.display_id = display_id
        self.mode = mode
        # THE SERVER'S ANSWER, not a setting and not the viewer's request. It is
        # `mode == controller AND the control window is still open`, computed in
        # display_attach.rs as one conjunction, so a controller whose window was
        # returned arrives here as False at the next re-validation and the
        # channel closes under them. See `revoke_input`.
        self.input_enabled = bool(input_enabled) and not INPUT_KILL_SWITCH
        if input_enabled and INPUT_KILL_SWITCH:
            log("input: server granted control but MOMO_DISPLAY_INPUT_DISABLED=1 refuses it")
        self.input_channel = None
        self.input_sink = None
        self._input_lock = threading.Lock()
        self._frames_applied = 0
        self._frames_refused = 0
        # LIVE-5a: the relay credential the SERVER minted for this session, if
        # this instance was configured with a relay. Empty on an instance that
        # was not, and the static `MOMO_DISPLAY_TURN_URI` then stands — see
        # `start`.
        #
        # KNOWN LIMIT, stated here rather than discovered in production: this is
        # installed into webrtcbin ONCE, in `start`, and the 30-second
        # re-validation loop below mints a fresh credential that this process
        # THROWS AWAY. GStreamer has no way to swap a TURN server on a running
        # ICE agent — and the one property that looks like a way in
        # (`webrtcbin.ice-agent`) destroys the agent when read, measured in #1438
        # and warned about a few lines down. So the credential's TTL is this peer
        # connection's ceiling: past it the connection can no longer allocate or
        # refresh a relay and the viewer's screen goes black with nothing to
        # explain it. A NEW viewer is unaffected (new Session, new pipeline,
        # credential minted when they attached). Renegotiating versus accepting
        # the ceiling is a LIVE-5c question and is measured there, not guessed at
        # here.
        self.ice_servers = ice_servers or []
        # Whether ICE was restricted to relay candidates. Read by the candidate
        # log so it can tell a missing relay from an expected host candidate.
        self.relay_only = False
        self.pipe = None
        self.webrtc = None
        self.done = threading.Event()

    def start(self) -> None:
        self.pipe = Gst.parse_launch(PIPELINE)
        self.webrtc = self.pipe.get_by_name("sendonly")

        # BUNDLE, before anything negotiates.
        #
        # webrtcbin's default bundle policy is `none`, which gives every m-line
        # its own ICE component and its own DTLS transport. That was invisible
        # while the offer had exactly one m-line (#1438 measured video only). The
        # moment the input channel adds `m=application`, `none` asks the viewer
        # for a SECOND transport, and the measured result is ICE reaching
        # `completed` and the connection then going `failed` in DTLS — a screen
        # that connects and a keyboard that never arrives, with no error naming
        # the cause.
        #
        # Browsers negotiate max-bundle and the web client is a browser, so this
        # is also the only policy the real viewer was ever going to accept.
        self.webrtc.set_property(
            "bundle-policy", GstWebRTC.WebRTCBundlePolicy.MAX_BUNDLE
        )

        # E2E (#1438) — force relay-only ICE and wire the oort-operated TURN.
        # ADR-0165 증보 1 (D3-1) measured that a CubeSandbox microVM sits behind a
        # symmetric NAT: host/srflx candidates cannot connect from outside, so the
        # only ICE path that works is `typ relay`. We therefore (a) wire the TURN
        # server(s) delivered via envVars (#1437 receiver → this process's environ)
        # and (b) set ice-transport-policy=relay so webrtcbin gathers ONLY relay
        # candidates — collecting host/srflx that are known to fail only costs
        # connection time (ADR-0165 증보 1 residual item 5). turn:// URIs carry a
        # credential, so they are never logged.
        #
        # LIVE-5a — the credential is now the SERVER's, minted per session and
        # expiring on its own (`validate.ice_servers`). The static envVars pair
        # below is the pre-LIVE-5a delivery and stays as the fallback for exactly
        # as long as the retirement takes: an instance whose operator has not yet
        # given momo-server the relay's `static-auth-secret` answers with an
        # empty `ice_servers`, and this producer must keep streaming through it.
        # The server's copy WINS when present — that preference is what makes the
        # static `user=` line removable from coturn later without a second deploy
        # of this template.
        turn_uri, turn_uri_tcp = turn_uris_from_ice_servers(self.ice_servers)
        credential_source = "server (per-session, expiring)"
        if not turn_uri:
            turn_uri = os.environ.get("MOMO_DISPLAY_TURN_URI", "").strip()
            turn_uri_tcp = os.environ.get("MOMO_DISPLAY_TURN_URI_TCP", "").strip()
            credential_source = "envVars static (pre-LIVE-5a)"
        if turn_uri:
            self.webrtc.set_property("turn-server", turn_uri)
            added_tcp = False
            if turn_uri_tcp:
                try:
                    added_tcp = bool(self.webrtc.emit("add-turn-server", turn_uri_tcp))
                except Exception as exc:  # noqa: BLE001
                    log(f"ice: add-turn-server(tcp) failed ({exc})")
            self.webrtc.set_property(
                "ice-transport-policy",
                GstWebRTC.WebRTCICETransportPolicy.RELAY,
            )
            self.relay_only = True
            log(
                "ice: TURN wired from {} (udp + tcp={}), "
                "ice-transport-policy=RELAY (relay-only, credential not logged)".format(
                    credential_source, added_tcp
                )
            )
        else:
            # No TURN delivered — leave webrtcbin at the spec defaults (stun=[],
            # turn=null). This is the pre-#1438 posture (offer carries only
            # link-local candidates and a browser cannot connect).
            log("ice: no TURN delivered — defaults (relay unavailable)")

        # NOTE (measured, do not "fix" by reading `ice-agent`): on GStreamer 1.22
        # `webrtcbin.get_property("ice-agent")` through PyGObject over-unrefs the
        # GstWebRTCNice object — the property returns an object, and the ICE agent
        # is DESTROYED as a side effect of reading it. Every later negotiation then
        # dies on `gst_webrtc_ice_add_stream: assertion 'GST_IS_WEBRTC_ICE (ice)'`.
        # There is no port-range property on webrtcbin in 1.22 either, so
        # template.spec.json's `mediaUdpPortRange` is NOT enforceable here.
        log(f"ice: mediaUdpPortRange {UDP_RANGE} DECLARED BUT NOT ENFORCED (GStreamer 1.22)")

        self.webrtc.connect("on-negotiation-needed", self._on_negotiation_needed)
        self.webrtc.connect("on-ice-candidate", self._on_ice_candidate)

        # The input channel is created between READY and PLAYING, and the order
        # is not a style choice — it is the only window that works:
        #
        #   * before READY, `create-data-channel` fails the assertion
        #     `webrtc->priv->is_closed != TRUE` and returns NULL (measured), so a
        #     grant would be silently dropped;
        #   * after PLAYING, `on-negotiation-needed` has already fired and the
        #     offer is on its way WITHOUT an `m=application` section, so the
        #     channel would need a second offer for something known all along.
        #
        # In READY the element is alive and negotiation has not started, so the
        # channel lands in the FIRST offer.
        self.pipe.set_state(Gst.State.READY)
        if self.input_enabled:
            self._open_input_channel()

        self.pipe.set_state(Gst.State.PLAYING)
        log("pipeline PLAYING")

        # sendonly: it sends pixels and accepts no media back.
        try:
            transceiver = self.webrtc.emit("get-transceiver", 0)
            if transceiver is not None:
                transceiver.set_property(
                    "direction",
                    GstWebRTC.WebRTCRTPTransceiverDirection.SENDONLY,
                )
                log("transceiver direction=SENDONLY")
        except Exception as exc:  # noqa: BLE001
            log(f"transceiver: {exc}")

    # -- the input datachannel ------------------------------------------------

    def _open_input_channel(self) -> None:
        """Open the channel the SERVER authorised, and only then.

        Opened by the producer, never by the viewer: the trigger is this
        producer's own validate answer, so a viewer that opened its own channel
        would be routing around the grant rather than holding one. The web
        client therefore has no `createDataChannel` at all — it listens on
        `ondatachannel` (DisplayController.tsx) — and this is the other half of
        that arrangement.
        """
        try:
            self.input_sink = X11InputSink(X11)
        except Exception as exc:  # noqa: BLE001
            # A grant we cannot honour must not be reported as honoured. The
            # stream continues; the keyboard does not.
            log(f"input: sink unavailable ({exc}) — control granted but NOT delivered")
            self.input_enabled = False
            self.input_sink = None
            return
        try:
            channel = self.webrtc.emit(
                "create-data-channel", INPUT_CHANNEL_LABEL, None
            )
        except Exception as exc:  # noqa: BLE001
            log(f"input: create-data-channel failed ({exc})")
            channel = None
        if channel is None:
            log("input: webrtcbin refused the channel — control NOT delivered")
            self.input_enabled = False
            self.input_sink.close()
            self.input_sink = None
            return
        channel.connect("on-open", self._on_input_open)
        channel.connect("on-close", self._on_input_close)
        channel.connect("on-message-string", self._on_input_message)
        self.input_channel = channel
        log(f"input: channel {INPUT_CHANNEL_LABEL!r} created (server granted control)")

    def _on_input_open(self, _channel) -> None:
        log("input: channel OPEN — keystrokes now reach this screen")

    def _on_input_close(self, _channel) -> None:
        log(
            "input: channel CLOSED "
            f"(applied={self._frames_applied} refused={self._frames_refused})"
        )

    def _on_input_message(self, _channel, raw: str) -> None:
        """One frame in, one X event out — or nothing, loudly.

        Never logs the frame. A key frame names the physical key, and a log line
        holding a sequence of them is a keylogger written by accident.
        """
        if not self.input_enabled or self.input_sink is None:
            self._frames_refused += 1
            return
        try:
            message = json.loads(raw)
        except ValueError:
            self._frames_refused += 1
            log("input: refused a frame (not JSON)")
            return
        try:
            action = input_frame_action(message)
        except InputRefused as exc:
            self._frames_refused += 1
            # The REASON, never the frame.
            log(f"input: refused a frame ({exc})")
            return
        try:
            with self._input_lock:
                if self.input_sink is None:
                    return
                kind, args = action[0], action[1:]
                getattr(self.input_sink, kind)(*args)
        except InputRefused as exc:
            self._frames_refused += 1
            log(f"input: refused a frame ({exc})")
            return
        except Exception as exc:  # noqa: BLE001
            self._frames_refused += 1
            log(f"input: injection failed ({exc})")
            return
        self._frames_applied += 1
        # One line per burst rather than per frame: the count is the evidence,
        # the sequence would be the leak.
        if self._frames_applied in (1, 10, 100) or self._frames_applied % 500 == 0:
            log(f"input: {self._frames_applied} frames applied")

    def revoke_input(self, reason: str = "server withdrew the control window") -> None:
        """Take the keyboard back.

        With the default reason this is what makes 반환 remove control rather
        than merely record that somebody asked: the stream is NOT cut — the
        person keeps watching, they just stop typing — which is the difference
        between a returned window and a revoked capability.

        `reason` exists because teardown calls this too, and a teardown that
        logged "the server withdrew the window" sent a reader looking for a
        ledger change that never happened (measured while soaking LIVE-5c).
        """
        with self._input_lock:
            if not self.input_enabled and self.input_channel is None:
                return
            self.input_enabled = False
            sink, self.input_sink = self.input_sink, None
            channel, self.input_channel = self.input_channel, None
        if sink is not None:
            sink.close()
        if channel is not None:
            try:
                channel.emit("close")
            except Exception as exc:  # noqa: BLE001
                log(f"input: channel close failed ({exc})")
        log(f"input: REVOKED ({reason})")

    def _on_negotiation_needed(self, element) -> None:
        promise = Gst.Promise.new_with_change_func(self._on_offer_created, element, None)
        element.emit("create-offer", None, promise)

    def _on_offer_created(self, promise, element, _data) -> None:
        promise.wait()
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        element.emit("set-local-description", offer, Gst.Promise.new())
        sdp = offer.sdp.as_text()
        # D4, as amended by `producer.inputDatachannelOnDemand`. The absence of
        # an application m-line is STILL the guarantee for an observer, and it is
        # still checked on the way out rather than assumed from a flag: if this
        # session was not granted input, a datachannel in the offer is a bug in
        # this file and the honest response is to send nothing.
        has_datachannel = "m=application" in sdp or "webrtc-datachannel" in sdp
        if has_datachannel and not self.input_enabled:
            log("FATAL: offer contained a datachannel without a grant — refusing to send (D4)")
            self.peer.close()
            return
        if self.input_enabled and not has_datachannel:
            # The grant was made and the channel is not on the wire, so the
            # viewer would be told it has control and then type into nothing.
            log("FATAL: control granted but the offer carries no input channel — refusing")
            self.peer.close()
            return
        send_json(self.peer, {"type": "offer", "sdp": sdp})
        log(
            "offer sent (video sendonly, m=application {})".format(
                "present — control granted" if has_datachannel else "absent — view-only"
            )
        )

    def _on_ice_candidate(self, _element, mline_index, candidate) -> None:
        if "typ relay" in candidate:
            # #1438: with ice-transport-policy=relay this is the ONLY kind that
            # should appear. Its address is the oort TURN public IP — proof that
            # the microVM allocated a relay on the dedicated host (INFRA-B item 1).
            log(f"ice: RELAY candidate (microVM→TURN allocation OK): {candidate}")
        elif self.relay_only:
            log(f"ice: non-relay candidate emitted (unexpected under relay policy): {candidate}")
        else:
            # No relay configured, so host/srflx candidates are the expected
            # shape rather than a surprise. Saying "unexpected" here sent a
            # reader hunting for a TURN fault in a run that had no TURN.
            log(f"ice: host candidate (no relay configured): {candidate}")
        send_json(
            self.peer,
            {"type": "ice", "candidate": candidate, "sdpMLineIndex": mline_index},
        )

    def set_remote_answer(self, sdp_text: str) -> None:
        ok, sdp = GstSdp.SDPMessage.new_from_text(sdp_text)
        if ok != GstSdp.SDPResult.OK:
            log("answer: unparseable SDP — signalling continues, media will not")
            return
        answer = GstWebRTC.WebRTCSessionDescription.new(
            GstWebRTC.WebRTCSDPType.ANSWER, sdp
        )
        try:
            self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())
            log("answer applied")
        except Exception as exc:  # noqa: BLE001
            log(f"answer: rejected by webrtcbin ({exc})")

    def add_remote_ice(self, candidate: str, mline_index: int) -> None:
        try:
            self.webrtc.emit("add-ice-candidate", mline_index, candidate)
        except Exception as exc:  # noqa: BLE001
            log(f"ice: remote candidate rejected ({exc})")

    def stop(self) -> None:
        self.done.set()
        # The keyboard goes before the picture: a half-torn-down pipeline that
        # still injected would be typing into a screen nobody is watching.
        self.revoke_input("session ending")
        if self.pipe is not None:
            self.pipe.set_state(Gst.State.NULL)


# ---------------------------------------------------------------------------
# Signalling server
# ---------------------------------------------------------------------------


def handle_connection(conn: socket.socket, addr) -> None:
    conn.settimeout(30)
    peer = Peer(conn)
    session = None
    try:
        request = b""
        while b"\r\n\r\n" not in request:
            chunk = conn.recv(4096)
            if not chunk:
                return
            request += chunk
        head, _, peer.buffered = request.partition(b"\r\n\r\n")
        lines = head.decode("latin-1").split("\r\n")
        request_line = lines[0] if lines else ""
        headers = {}
        for line in lines[1:]:
            if ": " in line:
                name, _, value = line.partition(": ")
                headers[name.lower()] = value

        # Readiness probe (cubemastercli --probe) and plain health checks.
        if "upgrade" not in headers.get("connection", "").lower():
            body = b'{"status":"ok"}'
            conn.sendall(
                b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
                b"Content-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body
            )
            return

        offered = [p.strip() for p in headers.get("sec-websocket-protocol", "").split(",")]
        if not offered or offered[0] != SUBPROTOCOL or len(offered) < 2:
            conn.sendall(b"HTTP/1.1 400 Bad Request\r\n\r\n")
            log("refused a handshake with no capability")
            return
        capability = offered[1]

        verdict = validate_capability(capability)
        if verdict is None:
            conn.sendall(b"HTTP/1.1 401 Unauthorized\r\n\r\n")
            log("server refused the capability")
            return

        accept = _accept_key(headers["sec-websocket-key"])
        conn.sendall(
            (
                "HTTP/1.1 101 Switching Protocols\r\n"
                "Upgrade: websocket\r\n"
                "Connection: Upgrade\r\n"
                f"Sec-WebSocket-Accept: {accept}\r\n"
                # BARE subprotocol: echoing the capability would put a live
                # bearer in every intermediary's response log.
                f"Sec-WebSocket-Protocol: {SUBPROTOCOL}\r\n"
                "\r\n"
            ).encode("ascii")
        )
        log(f"viewer attached from {addr[0]} display_id={verdict['display_id']}")

        # The server's word, not this process's setting. `MOMO_DISPLAY_INPUT` is
        # still read as false and only false; the one env var that can move this
        # moves it DOWN (`MOMO_DISPLAY_INPUT_DISABLED`).
        granted_input = bool(verdict.get("input_enabled")) and not INPUT_KILL_SWITCH

        send_json(
            peer,
            {
                "type": "ready",
                "display_id": verdict["display_id"],
                "mode": verdict.get("mode", "observer"),
                "input_enabled": granted_input,
                "codec": CODEC,
                "audio": AUDIO,
            },
        )

        session = Session(
            peer,
            verdict["display_id"],
            verdict.get("mode", "observer"),
            # LIVE-5a: the relay credential the server minted for THIS session,
            # taken from THIS viewer's own validate, so the full TTL is ahead of
            # the pipeline about to be built rather than partly spent. It reaches
            # webrtcbin exactly once — see the limit noted on `Session.__init__`.
            verdict.get("ice_servers"),
            granted_input,
        )
        session.start()

        # The signalling socket goes QUIET once negotiation finishes — a viewer
        # that is watching and typing sends nothing here, because input rides the
        # datachannel and media rides ICE. So the loop is driven by a CLOCK, and
        # a read timeout is a tick rather than an ending.
        #
        # Measured (LIVE-5c soak): with the timeout treated as an ending, every
        # session died ~30s after the last ICE candidate — the re-validation
        # below never ran even once, the control window's lease was never
        # renewed, and the person's keyboard stopped roughly half a minute in.
        # Nothing before LIVE-5c held a session open long enough to see it.
        # `select` rather than a socket timeout, because a timeout that fired
        # midway through a frame would leave the next read starting inside the
        # previous frame's body and desync the channel for good. Waiting for
        # readability first means every `_recv_frame` call runs on a frame that
        # has begun to arrive, and the timeout belongs to the WAIT.
        conn.settimeout(REVALIDATE_SECONDS)
        deadline = time.monotonic() + REVALIDATE_SECONDS
        while True:
            message = None
            if peer.buffered:
                readable = True
            else:
                try:
                    readable = bool(
                        select.select([conn], [], [], REVALIDATE_TICK_SECONDS)[0]
                    )
                except (OSError, ValueError):
                    break
            if readable:
                try:
                    opcode, payload = _recv_frame(peer)
                except (ConnectionError, OSError):
                    break
                if opcode == OPCODE_CLOSE:
                    break
                if opcode != OPCODE_TEXT:
                    continue
                try:
                    message = json.loads(payload.decode("utf-8"))
                except ValueError:
                    continue
            kind = message.get("type") if message is not None else None
            if kind == "answer":
                session.set_remote_answer(message.get("sdp", ""))
            elif kind == "ice":
                session.add_remote_ice(
                    message.get("candidate", ""), int(message.get("sdpMLineIndex", 0))
                )
            elif kind == "open_input":
                # STILL refused, and the refusal is now the load-bearing half of
                # the grant rather than a leftover: a viewer's request is not an
                # authorisation (`viewerRequestIsNotAuthorisation`). If this
                # viewer holds control it already HAS a channel, opened by the
                # producer off the server's answer before the offer went out. If
                # it does not, asking is exactly the move that must not work.
                send_json(peer, {"type": "error", "reason": VIEW_ONLY_REFUSAL})
                log("open_input refused: a viewer request is not a grant")
            elif kind == "bye":
                break

            if time.monotonic() > deadline:
                revalidated = validate_capability(capability, stream=True)
                if revalidated is None:
                    log("revalidation failed — cutting the stream")
                    break
                # 반환 lands HERE. The window closing does not cut the stream and
                # must not: the person keeps watching the screen they no longer
                # drive. `input_enabled` is the server's conjunction of
                # controller-mode AND an open window, so this is the same answer
                # the browser is being told, arriving at the half that can act on
                # it.
                if session.input_enabled and not revalidated.get("input_enabled"):
                    session.revoke_input()
                deadline = time.monotonic() + REVALIDATE_SECONDS
    except Exception as exc:  # noqa: BLE001
        log(f"session error: {exc}")
    finally:
        if session is not None:
            session.stop()
        peer.close()


def main() -> int:
    global SIGNER

    Gst.init(None)
    if not Gst.ElementFactory.find("webrtcbin"):
        log("FATAL: webrtcbin plugin missing")
        return 1
    if not Gst.ElementFactory.find("ximagesrc"):
        log("FATAL: ximagesrc plugin missing")
        return 1

    # Built once, at startup, so a missing or malformed key is one line in the
    # boot log rather than a puzzle at the first attach.
    SIGNER = WorkHostSigner(HOST_ID, WORK_HOST_KEY_PATH)
    if SERVER_ORIGIN and not SIGNER.ready:
        log("WARNING: a real server is configured but validate will be UNSIGNED (401s ahead)")

    loop = threading.Thread(target=lambda: GLib.MainLoop().run(), daemon=True)
    loop.start()

    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("0.0.0.0", SIGNAL_PORT))
    listener.listen(8)
    log(
        f"signalling on :{SIGNAL_PORT} subprotocol={SUBPROTOCOL} "
        f"input=per-grant (kill switch={'ON' if INPUT_KILL_SWITCH else 'off'})"
    )

    while True:
        conn, addr = listener.accept()
        threading.Thread(target=handle_connection, args=(conn, addr), daemon=True).start()


if __name__ == "__main__":
    raise SystemExit(main())
