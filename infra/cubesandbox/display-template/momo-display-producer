# ---------------------------------------------------------------------------
# RFC 6455 — the subset a signalling channel uses
# ---------------------------------------------------------------------------


def _accept_key(client_key: str) -> str:
    digest = hashlib.sha1((client_key + WS_GUID).encode("ascii")).digest()
    return base64.b64encode(digest).decode("ascii")


class Peer:
    def __init__(self, sock: socket.socket, buffered: bytes = b"") -> None:
        self.sock = sock
        self.buffered = buffered
        self.lock = threading.Lock()
        self.closed = False

    def close(self) -> None:
        self.closed = True
        try:
            self.sock.close()
        except OSError:
            pass


def _recv_exactly(peer: Peer, count: int) -> bytes:
    out = b""
    if peer.buffered:
        take = peer.buffered[:count]
        peer.buffered = peer.buffered[count:]
        out += take
    while len(out) < count:
        chunk = peer.sock.recv(count - len(out))
        if not chunk:
            raise ConnectionError("peer closed")
        out += chunk
    return out


def _send_frame(peer: Peer, payload: bytes, opcode: int = OPCODE_TEXT) -> None:
    header = bytes([0x80 | opcode])
    length = len(payload)
    if length < 126:
        header += bytes([length])
    elif length < (1 << 16):
        header += bytes([126]) + struct.pack(">H", length)
    else:
        header += bytes([127]) + struct.pack(">Q", length)
    with peer.lock:
        if not peer.closed:
            peer.sock.sendall(header + payload)


def _recv_frame(peer: Peer) -> tuple[int, bytes]:
    first, second = _recv_exactly(peer, 2)
    opcode = first & 0x0F
    masked = bool(second & 0x80)
    length = second & 0x7F
    if length == 126:
        length = struct.unpack(">H", _recv_exactly(peer, 2))[0]
    elif length == 127:
        length = struct.unpack(">Q", _recv_exactly(peer, 8))[0]
    mask = _recv_exactly(peer, 4) if masked else b""
    payload = _recv_exactly(peer, length)
    if masked:
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    return opcode, payload


def send_json(peer: Peer, message: dict) -> None:
    _send_frame(peer, json.dumps(message).encode("utf-8"))


# ---------------------------------------------------------------------------
# Capability validation — the producer does not trust what it is handed
# ---------------------------------------------------------------------------


class WorkHostSigner:
    """Signs a request as this work host (`momo.work_host.request.v2`).

    The server mounts `display-attach/validate` OUTSIDE the bearer middleware —
    a producer inside a sandbox holds no bearer and must not, because a bearer
    that reached the sandbox would be a bearer the sandbox could spend. What it
    holds instead is an Ed25519 signing key, and the server verifies it against
    the public half registered for the host (`work_host_auth.rs`).

    The payload is byte-for-byte the server's `momo_wire::signing::request_payload`:

        momo.work_host.request.v2\\n{METHOD}\\n{path}\\n{workspace}\\n{host}
        \\n{sentAtMs}\\n{sha256hex(body)}\\n{requestId}

    `path` is the RAW request path. Rebuilding it from parts on either side is
    how a signature silently stops verifying, so it is formatted once, by the
    caller, and the same string is what goes on the wire.

    `requestId` is fresh per call and the server consumes it exactly once — the
    replay barrier. A retry therefore needs a NEW id, which is why this returns
    headers per request rather than a cached set.
    """

    SCHEMA = "momo.work_host.request.v2"

    def __init__(self, host_id: str, key_path: str) -> None:
        self.host_id = host_id
        self._key = None
        if not host_id or not key_path:
            log("signer: no work-host identity configured — validate will be unsigned")
            return
        try:
            # Debian `python3-cryptography`, not pip. Imported here rather than
            # at module scope so an observer-only instance built without the
            # package still starts and still streams.
            from cryptography.hazmat.primitives.asymmetric.ed25519 import (
                Ed25519PrivateKey,
            )
        except ImportError as exc:
            log(f"signer: cryptography missing ({exc}) — validate cannot be signed")
            return
        try:
            with open(key_path, "rb") as handle:
                raw = handle.read().strip()
        except OSError as exc:
            log(f"signer: key unreadable ({exc})")
            return
        # The delivered form is base64 of the 32-byte seed — CryptoKit's
        # `rawRepresentation`, the same shape the Swift host daemon carries.
        try:
            seed = base64.b64decode(raw, validate=True)
        except (ValueError, TypeError):
            seed = b""
        if len(seed) != 32:
            log(f"signer: not a 32-byte Ed25519 seed (got {len(seed)}) — refusing")
            return
        self._key = Ed25519PrivateKey.from_private_bytes(seed)
        log(f"signer: work-host {host_id} key loaded (Ed25519)")

    @property
    def ready(self) -> bool:
        return self._key is not None

    def headers(self, method: str, path: str, workspace: str, body: bytes) -> dict:
        if self._key is None:
            return {}
        sent_at_ms = int(time.time() * 1000)
        request_id = str(uuid.uuid4())
        body_digest = hashlib.sha256(body).hexdigest()
        payload = (
            f"{self.SCHEMA}\n{method.upper()}\n{path}\n{workspace}\n{self.host_id}"
            f"\n{sent_at_ms}\n{body_digest}\n{request_id}"
        ).encode("utf-8")
        signature = base64.b64encode(self._key.sign(payload)).decode("ascii")
        return {
            # `MomoHost <hostId>` is the scheme the server's authenticator
            # parses, and the id must equal the one in the path: a host may only
            # ever act as itself.
            "Authorization": f"MomoHost {self.host_id}",
            "X-Momo-Work-Host-Sent-At": str(sent_at_ms),
            "X-Momo-Work-Host-Signature": signature,
            "X-Momo-Work-Host-Request-Id": request_id,
        }


SIGNER: "WorkHostSigner | None" = None


def _server_ssl_context():
    """Verify the proxy's certificate, naming it rather than trusting anything.

    The install runbook's proxy carries a self-signed certificate (runbook §9
    item 2). A self-signed leaf verifies against ITSELF, so pointing
    `load_verify_locations` at that one file is real verification against
    exactly one certificate — not `CERT_NONE`, which would accept whatever any
    hijacker presented on the way to the route that decides who may type.
    """
    if not SERVER_ORIGIN.startswith("https://"):
        return None
    import ssl

    context = ssl.create_default_context()
    if SERVER_CA_BUNDLE:
        # An IP SAN is checked by hostname verification like any other name, so
        # the runbook's IP-issued certificate needs no relaxation here.
        context.load_verify_locations(cafile=SERVER_CA_BUNDLE)
    return context


def validate_capability(token: str, stream: bool = False) -> dict | None:
    """Ask the server. `stream: true` relaxes expiry and ONLY expiry."""
    if not token.startswith(CAPABILITY_PREFIX):
        return None
    if not SERVER_ORIGIN:
        if ALLOW_STUB_VALIDATE:
            log("validate: STUBBED (no MOMO_SERVER_ORIGIN) — install-goal only")
            return {"display_id": DISPLAY_ID, "mode": "observer"}
        return None
    # Formatted ONCE and used for both the request line and the signature — the
    # server verifies over the raw path, so a second spelling here would be a
    # signature that silently stops matching.
    path = f"/v1/workspaces/{WORKSPACE}/work-hosts/{HOST_ID}/display-attach/validate"
    url = f"{SERVER_ORIGIN}{path}"
    # `capability_token`, not `capability`. The request DTO is
    # `deny_unknown_fields`, so the old spelling was a 400 on every call — never
    # noticed because #1438 ran with `MOMO_DISPLAY_STUB_VALIDATE=1` and no
    # producer has yet made a real validate (template.spec.json
    # `unverified.serverValidateWiring`). LIVE-5a reads `ice_servers` out of this
    # answer, so the spelling stops being cosmetic.
    body = json.dumps({"capability_token": token, "stream": stream}).encode("utf-8")
    req = urllib.request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    if SIGNER is not None:
        for name, value in SIGNER.headers("POST", path, WORKSPACE, body).items():
            req.add_header(name, value)
    try:
        with urllib.request.urlopen(req, timeout=5, context=_server_ssl_context()) as resp:
            if resp.status != 200:
                return None
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError) as exc:
        log(f"validate: refused ({exc})")
        return None


def turn_uris_from_ice_servers(ice_servers) -> tuple[str, str]:
    """Render the server's `ice_servers` into webrtcbin's `turn://` spelling.

    LIVE-5a. The validate answer now carries a **per-session, expiring**
    credential (coturn `use-auth-secret`), replacing the one static password the
    install runbook shipped and called temporary in writing. The two sides speak
    different shapes and neither should learn the other's: the server speaks W3C
    (`{urls, username, credential}` — what a browser hands `RTCPeerConnection`),
    and webrtcbin wants the credential inside the URI. This is that translation
    and nothing else.

    Returns `(udp_uri, tcp_uri)`, either of which may be empty. Both carry a
    credential and are therefore **never logged** — the caller logs only whether
    it got them.

    Percent-encoding is not optional here: the username is
    `<expiry>:<session-uuid>` and the credential is base64, so `:`, `/`, `+` and
    `=` all occur and all mean something inside a URI's userinfo.
    """
    udp = ""
    tcp = ""
    for server in ice_servers or []:
        username = urllib.parse.quote(str(server.get("username", "")), safe="")
        credential = urllib.parse.quote(str(server.get("credential", "")), safe="")
        if not username or not credential:
            continue
        for url in server.get("urls") or []:
            url = str(url).strip()
            # `turn:host:port?transport=udp` — the scheme is replaced, the rest
            # (host, port, query) is kept verbatim. `turns:` passes through as
            # `turns://` so a certificate on the relay later needs no change here.
            if url.startswith("turn:"):
                scheme, rest = "turn", url[len("turn:") :]
            elif url.startswith("turns:"):
                scheme, rest = "turns", url[len("turns:") :]
            else:
                continue
            uri = f"{scheme}://{username}:{credential}@{rest}"
            if "transport=tcp" in rest:
                tcp = tcp or uri
            else:
                udp = udp or uri
    return udp, tcp


