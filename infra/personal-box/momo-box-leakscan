#!/usr/bin/env node
// Runs INSIDE the box. Reads text on stdin (a log/stream from the host side) and reports
// whether it contains any secret string value from /cred, or login URL/device-code shapes.
// Only labels and counts are printed, never the secret values (they never leave the box).
'use strict';
const fs = require('fs');
const path = require('path');
const label = process.argv[2] || 'stdin';
const secrets = new Set();
function addString(s) { if (typeof s === 'string' && s.length >= 16) secrets.add(s); }
function walkJson(v) {
  if (typeof v === 'string') addString(v);
  else if (Array.isArray(v)) v.forEach(walkJson);
  else if (v && typeof v === 'object') Object.values(v).forEach(walkJson);
}
function walk(dir) {
  let entries = [];
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) { walk(p); continue; }
    if (!e.isFile()) continue;
    let text = '';
    try { if (fs.statSync(p).size > 1 << 20) continue; text = fs.readFileSync(p, 'utf8'); } catch { continue; }
    try { walkJson(JSON.parse(text)); } catch {
      (text.match(/[A-Za-z0-9_\-.~+\/=]{24,}/g) || []).forEach(addString);
    }
  }
}
walk(process.env.MOMO_BOX_CRED_DIR || '/cred');
// Exit codes: 0 clean, 1 leak/login shape found, 2 vacuous (no secrets to compare, empty input).
const allowEmpty = process.argv.includes('--allow-empty');
const raw = fs.readFileSync(0, 'utf8');
// Normalise terminal noise: strip ANSI escapes, then also test a form with line wraps removed.
const stripped = raw.replace(/\x1b\[[0-9;?]*[ -\/]*[@-~]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)/g, '').replace(/\r/g, '');
const joined = stripped.replace(/\n/g, '');
const views = [raw, stripped, joined];
let leaks = 0;
for (const s of secrets) if (views.some((v) => v.includes(s))) leaks++;
const shapes = {
  claude_oauth_url: /claude\.ai\/oauth\/authorize/i,
  anthropic_oauth_url: /console\.anthropic\.com\/oauth/i,
  openai_device_or_oauth_url: /auth\.openai\.com\/(codex\/device|oauth\/authorize)/i,
  device_code: { test: (v) => /\b[A-Z0-9]{4}-[A-Z0-9]{4,5}\b/.test(v) && /(device|one-time|verification)\s+code|code[^\n]{0,40}device/i.test(v) },
  anthropic_key: /sk-ant-[A-Za-z0-9_-]{10,}/,
  jwt: /\beyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}\./,
};
const hit = Object.entries(shapes).filter(([, re]) => views.some((v) => re.test(v))).map(([k]) => k);
console.log(`leakscan[${label}]: bytes=${raw.length} secret_values=${secrets.size} leaked=${leaks} login_shapes=${hit.length}${hit.length ? ' (' + hit.join(',') + ')' : ''}`);
if (leaks || hit.length) process.exit(1);
if (raw.length === 0) { console.log(`leakscan[${label}]: UNREAD empty input`); process.exit(2); }
if (secrets.size === 0 && !allowEmpty) { console.log(`leakscan[${label}]: VACUOUS no secret values under /cred to compare (pre-login? use --allow-empty)`); process.exit(2); }
