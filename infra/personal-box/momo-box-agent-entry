#!/bin/sh
# The entry of a runner-created box (ADR-0197 M2, M4). `momo-box-runner` starts the container as root with
# ONLY CAP_SETUID + CAP_SETGID (everything else dropped, no-new-privileges, read-only root) — the shape M3
# documented in verify-m3.sh. This script is what runs as root: it starts the box-agent at the agent uid
# (10002) carrying those two capabilities as ambient, so the agent can start the person's PTY under uid
# 10001 and strip every capability from it. Root itself never runs the agent or any user code.
#
# Per start:
#   1. the seal key on tmpfs  the runner's per-box key from its read-only inject directory (/run/oort-runner),
#                             installed by the agent (0600, its own file); without an inject directory (the M2
#                             shape) a fresh key is made. The seal key never lives on the volume or the key mount
#                             (D8: it must not share a device with the key it seals).
#   2. the host key, sealed   born in the box on the persistent key mount (`hostKeyRoot`) when the runner has one,
#                             else on tmpfs; the runner, the server and the image never see it
#   3. the agent itself       registers (proving the runner's pairing code by MAC), confirms the owner's first device
#                             list, then serves the blind relay outbound-only
# Exit status 75 from the agent means "the spawn helper is gone": this process holds the capabilities a new helper
# needs and the agent (which dropped them on purpose) does not, so the entry starts the agent again.
set -eu
umask 077
AGENT_UID=10002
AS_AGENT="setpriv --reuid $AGENT_UID --regid $AGENT_UID --clear-groups --inh-caps +setuid,+setgid --ambient-caps +setuid,+setgid --"
INJECT="${OORT_BOX_INJECT_DIR:-/run/oort-runner}"
# shellcheck disable=SC2086
if [ -f "$INJECT/seal.key" ]; then
  $AS_AGENT momo-box-agent install-seal-key "$INJECT/seal.key" "$OORT_BOX_SEAL_KEY_FILE"
else
  $AS_AGENT momo-box-agent make-seal-key "$OORT_BOX_SEAL_KEY_FILE"
fi
# shellcheck disable=SC2086
$AS_AGENT momo-box-agent init-key >/dev/null
restarts=0
while :; do
  set +e
  # shellcheck disable=SC2086
  $AS_AGENT momo-box-agent run
  status=$?
  set -e
  [ "$status" -eq 75 ] || exit "$status"
  restarts=$((restarts + 1))
  [ "$restarts" -le 20 ] || exit 75
  sleep 1
done
