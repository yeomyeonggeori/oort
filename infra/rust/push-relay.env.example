# Template for the ADR-0120 push path (infra/rust/docker-compose.push.yml).
#
#   cp infra/rust/push-relay.env.example infra/rust/push-relay.secrets.env
#   # then fill in the values described below
#
# `*.secrets.env` is gitignored repo-wide — never rename the copy, never commit
# it. This file is layered ON TOP of rust-smoke.secrets.env:
#
#   docker compose --env-file infra/rust/rust-smoke.secrets.env \
#     --env-file infra/rust/push-relay.secrets.env \
#     -f infra/rust/docker-compose.rust.yml \
#     -f infra/rust/docker-compose.push.yml <command>
#
# ## What is NOT in this file, and never will be
#
# The APNs `.p8` itself, and this server's Ed25519 private key. Both are FILES,
# referenced here only by absolute host path, and both live outside this repo.
# ADR-0120 D1-A: the relay is the only component that holds an APNs key, and no
# momo image or checkout contains one.
#
# Full procedure: docs/cicd/12-push-relay-deploy-runbook.md

# --- images -----------------------------------------------------------------
# Local build: momo-push-relay:dev (see docker-compose.push.build.yml).
# Deployed: the published, digest-pinned ref.
MOMO_PUSH_RELAY_IMAGE=momo-push-relay:dev

# --- relay: server registry -------------------------------------------------
# JSON object mapping server_id -> that server's raw Ed25519 PUBLIC key, base64.
# Produced by scripts/push_relay_keygen.sh on the SERVER side; only the public
# half is ever handed to the relay. Add one entry per registered self-hoster.
# Empty is a boot refusal, not a relay that accepts nobody quietly.
MOMO_RELAY_SERVERS={"momo-local":"replace-with-raw-ed25519-public-key-base64"}

# Per-server sliding 60s window (ADR-0120 D5).
MOMO_PUSH_RELAY_RATE_LIMIT_PER_MINUTE=60

# --- relay: APNs credential -------------------------------------------------
# live = talk to Apple. This is the default and the only deployment value.
# stub = the repo verifier; it fabricates a 200 and contacts nobody, so it
#        additionally requires MOMO_APNS_ALLOW_STUB=1 to boot at all.
MOMO_APNS_SENDER=live
MOMO_APNS_ALLOW_STUB=

# sandbox | production. One relay instance serves exactly ONE environment —
# APNs tokens are not interchangeable between them, and a dispatch whose
# apns_env disagrees is refused 400. Two environments means two instances.
MOMO_APNS_ENV=sandbox

# Absolute path ON THE HOST to the Apple APNs Auth Key (.p8), outside this repo.
# Mounted read-only at /run/secrets/apns-key.p8. Must be readable by uid 10001
# (the image's unprivileged user); if it is not, the relay refuses to boot and
# names MOMO_APNS_KEY_PATH in its log line.
MOMO_APNS_KEY_HOST_PATH=/replace/with/absolute/path/AuthKey_XXXXXXXXXX.p8

# From the Apple Developer portal, alongside the key.
MOMO_APNS_KEY_ID=
MOMO_APNS_TEAM_ID=

# --- notifier: this server's identity at the relay ---------------------------
# Turns the push-candidate drain on. Off means no candidate is ever claimed —
# an explicit deactivation, not a loop that quietly finds nothing to do.
MOMO_PUSH_NOTIFIER_ENABLED=0

# Must match a key in MOMO_RELAY_SERVERS above, or every dispatch is a 403.
PUSH_RELAY_SERVER_ID=momo-local
PUSH_RELAY_URL=http://push-relay:28195/v1/push

# Absolute path ON THE HOST to THIS SERVER's Ed25519 PRIVATE key
# (scripts/push_relay_keygen.sh). Identity at the relay — not an APNs
# credential. Mounted read-only; the notifier refuses to boot if the drain is
# enabled and this is absent.
MOMO_RELAY_SIGNING_KEY_HOST_PATH=/replace/with/absolute/path/server-ed25519-private.pem

# --- notifier: database -----------------------------------------------------
# A BYPASSRLS connection string. NOTE: infra/prod/bootstrap_runtime_roles.sql
# does not yet create `momo_notifier` (it provisions momo_app/momo_relay/
# momo_worker only), so there is no correct default. See the prerequisites
# section of docs/cicd/12-push-relay-deploy-runbook.md before filling this in.
NOTIFIER_DATABASE_URL=
