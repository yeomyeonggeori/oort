# Template for the Rust stack smoke (infra/rust/docker-compose.rust.yml).
#
#   cp infra/rust/rust-smoke.env.example infra/rust/rust-smoke.secrets.env
#   # then replace every change-me-* value with a generated secret
#
# `*.secrets.env` is gitignored repo-wide — never rename the copy to something
# else, and never commit it. Every value below is a PLACEHOLDER: the compose
# file fails closed (`${VAR:?}`) on anything missing, and the placeholders are
# deliberately not usable as real credentials.
#
# Generate values with: openssl rand -hex 24

# --- image ------------------------------------------------------------------
# Local build: momo-rust:dev (see docker-compose.rust.build.yml).
# Deployed: the published, digest-pinned ref.
MOMO_RUST_IMAGE=momo-rust:dev
COMPOSE_PROJECT_NAME=momo-rust
MOMO_ENV=staging
LOG_LEVEL=info

# --- postgres ---------------------------------------------------------------
# POSTGRES_USER is the database OWNER: it runs runtime-roles + migrate, and is
# never used by api/relay (they get the least-privilege runtime roles below).
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres-owner

# Owner connection (runtime-roles + migrate). Host is the compose service name.
MIGRATE_DATABASE_URL=postgres://momo:change-me-postgres-owner@postgres:5432/momo

# --- runtime roles (MOMO-554) ----------------------------------------------
# These three passwords are what runtime-roles sets on momo_app / momo_relay /
# momo_worker. The two URLs below MUST carry the same values.
MOMO_APP_POSTGRES_PASSWORD=change-me-momo-app
RELAY_POSTGRES_PASSWORD=change-me-momo-relay
WORKER_POSTGRES_PASSWORD=change-me-momo-worker

# api → momo_app (NOBYPASSRLS), relay → momo_relay (BYPASSRLS).
MOMO_APP_DATABASE_URL=postgres://momo_app:change-me-momo-app@postgres:5432/momo
RELAY_DATABASE_URL=postgres://momo_relay:change-me-momo-relay@postgres:5432/momo

# --- app secrets ------------------------------------------------------------
# App JWT signing key (prod name; the Rust api reads JWT_HMAC).
JWT_HMAC=change-me-jwt-hmac
# Centrifugo connection/subscription-token key and server API key.
# B4: the Rust api now SIGNS connection tokens with CENT_TOKEN_HMAC
# (`POST /v1/auth/realtime-token`), so centrifugo and api must carry the same
# value — a mismatch lets every client connect and be rejected immediately.
CENT_TOKEN_HMAC=change-me-cent-token-hmac
CENT_API_KEY=change-me-cent-api-key
# Subscribe-proxy shared header. B4: **live** — the Rust api serves
# /v1/centrifugo/subscribe and 401s a callback that does not present exactly
# this value. centrifugo and api must agree; in staging/prod a placeholder here
# fails the api boot rather than silently denying every subscribe.
CENT_PROXY_SECRET=change-me-cent-proxy-secret

# --- realtime address (ADR-0110) -------------------------------------------
# The exact URL clients will dial. Loopback for a tunnelled smoke; wss://<host>
# once a TLS edge fronts the stack.
MOMO_CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket

# --- host ports (loopback-bound by the compose file) ------------------------
MOMO_RUST_API_PORT=8080
CENT_HOST_PORT=8000

# --- migration behaviour ----------------------------------------------------
# none = product default (no agent fixtures; the seeded owner password is locked
#        by migration 012 → create the login with `run --rm migrate set-owner`)
# e2e  = deterministic fixtures incl. the PUBLIC dev-password. Local only.
MOMO_AGENT_SEED_MODE=none
MIGRATE_IDEMPOTENCY_CHECK=1

# Consumed only by `docker compose ... run --rm migrate set-owner`.
MOMO_INITIAL_OWNER_EMAIL=
MOMO_INITIAL_OWNER_PASSWORD=
