# Template for the Rust stack smoke (infra/rust/docker-compose.rust.yml).
#
#   cp infra/rust/rust-smoke.env.example infra/rust/rust-smoke.secrets.env
#   # then replace every change-me-* value with a generated secret
#
# `*.secrets.env` is gitignored repo-wide — never rename the copy to something
# else, and never commit it. Every value below is a PLACEHOLDER: the compose
# file fails closed (`${VAR:?}`) on anything missing, and the placeholders are
# deliberately not usable as real credentials.
#
# Generate values with: openssl rand -hex 24

# --- image ------------------------------------------------------------------
# Local build: momo-rust:dev (see docker-compose.rust.build.yml).
# Deployed: the published, digest-pinned ref.
MOMO_RUST_IMAGE=momo-rust:dev
COMPOSE_PROJECT_NAME=momo-rust
MOMO_ENV=staging
# #1330: staging/production migrations fail closed unless one of the two PITR
# modes below is selected. Do not copy `development` to a public host. The
# local one-command path (`scripts/self_host_env.sh`) generates its own explicit
# development warning posture instead of using this deployment template.
# This template is a local smoke. A public host MUST replace this with
# `production`, add docker-compose.backup.yml, and provide signed evidence.
MOMO_MIGRATE_ENV=development
MOMO_PITR_EVIDENCE_REQUIRED=0
MOMO_PITR_BOOTSTRAP_EMPTY=0
LOG_LEVEL=info

# --- postgres ---------------------------------------------------------------
# POSTGRES_USER is the database OWNER: it runs runtime-roles + migrate, and is
# never used by api/relay (they get the least-privilege runtime roles below).
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=change-me-postgres-owner

# Owner connection (runtime-roles + migrate). Host is the compose service name.
MIGRATE_DATABASE_URL=postgres://momo:change-me-postgres-owner@postgres:5432/momo

# --- runtime roles (MOMO-554) ----------------------------------------------
# These three passwords are what runtime-roles sets on momo_app / momo_relay /
# momo_worker. The two URLs below MUST carry the same values.
MOMO_APP_POSTGRES_PASSWORD=change-me-momo-app
RELAY_POSTGRES_PASSWORD=change-me-momo-relay
WORKER_POSTGRES_PASSWORD=change-me-momo-worker

# api → momo_app (NOBYPASSRLS), relay → momo_relay (BYPASSRLS).
MOMO_APP_DATABASE_URL=postgres://momo_app:change-me-momo-app@postgres:5432/momo
RELAY_DATABASE_URL=postgres://momo_relay:change-me-momo-relay@postgres:5432/momo

# --- app secrets ------------------------------------------------------------
# App JWT signing key (prod name; the Rust api reads JWT_HMAC).
JWT_HMAC=change-me-jwt-hmac
# Centrifugo connection/subscription-token key and server API key.
# B4: the Rust api now SIGNS connection tokens with CENT_TOKEN_HMAC
# (`POST /v1/auth/realtime-token`), so centrifugo and api must carry the same
# value — a mismatch lets every client connect and be rejected immediately.
CENT_TOKEN_HMAC=change-me-cent-token-hmac
CENT_API_KEY=change-me-cent-api-key
# Subscribe-proxy shared header. B4: **live** — the Rust api serves
# /v1/centrifugo/subscribe and 401s a callback that does not present exactly
# this value. centrifugo and api must agree; in staging/prod a placeholder here
# fails the api boot rather than silently denying every subscribe.
CENT_PROXY_SECRET=change-me-cent-proxy-secret
# agent-worker only, and the compose file requires it (`${VAR:?}`) — an absent
# value makes `docker compose ... config` exit 1 before anything starts, so this
# line is what keeps the README §2 → §3 path renderable from an unedited copy.
# It encrypts the stored operator provider bearer at rest (ADR-0004 증보 1); in
# staging/prod it must not equal JWT_HMAC or the outbound webhook key.
PROVIDER_LINK_MASTER_KEY=change-me-provider-link-master-key

# --- realtime address (ADR-0110) -------------------------------------------
# The exact URL clients will dial. Loopback for a tunnelled smoke; wss://<host>
# once a TLS edge fronts the stack.
MOMO_CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket

# --- optional huddle / LiveKit (ADR-0122) ----------------------------------
# Leave all three empty to keep huddles fail-closed (HTTP 503 `허들 미구성`).
# To enable `--profile huddle`, replace both credential placeholders and set a
# URL that clients can reach. The API key/secret must match the LiveKit service.
MOMO_LIVEKIT_API_KEY=
MOMO_LIVEKIT_API_SECRET=
MOMO_LIVEKIT_URL=

# --- host ports (loopback-bound by the compose file) ------------------------
MOMO_RUST_API_PORT=8080
CENT_HOST_PORT=8000
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50100

# --- migration behaviour ----------------------------------------------------
# none = product default (no agent fixtures; the seeded owner password is locked
#        by migration 012 → open the login with the two variables below)
# e2e  = deterministic fixtures incl. the PUBLIC dev-password. Local only.
MOMO_AGENT_SEED_MODE=none
MIGRATE_IDEMPOTENCY_CHECK=1

# --- first login (#1227) ----------------------------------------------------
# THIS IS THE ONLY THING BETWEEN A HEALTHY STACK AND A LOGIN SCREEN YOU CANNOT
# PASS. Migration 012 nulls the seeded owner's publicly known `dev-password`
# (correct, fail-closed), so a database migrated with these two empty has no
# usable credential anywhere in it — the API answers `invalid credentials` to
# every attempt and no amount of re-migrating changes that.
#
# Fill both and the `migrate` service creates the login during `up -d`. The
# write happens only when no usable password exists, so every later restart is
# a no-op: it cannot reset a password you have since changed, and it never
# signs anyone out. To rotate deliberately, run the ops one-shot instead:
#   docker compose ... run --rm -e MOMO_INITIAL_OWNER_EMAIL \
#     -e MOMO_INITIAL_OWNER_PASSWORD migrate set-owner
#
# Setting only one of the two is exit 2 — a half-filled pair is a typo, and
# reading it as "off" would lock you out behind a green boot log. So is a
# non-lowercase address: the credential is stored `lower(btrim(...))` but the
# login lookup compares the address verbatim, so `Owner@Example.com` would be
# written and then never match what you type. Use lowercase.
# Generate the password with: openssl rand -base64 24
MOMO_INITIAL_OWNER_EMAIL=
MOMO_INITIAL_OWNER_PASSWORD=
# ADR-0166 opt-in. `1` with EMAIL and an empty PASSWORD issues a one-time
# `/claim/<token>` (printed once on migrate stdout). Mutually exclusive with
# a set PASSWORD. Default empty = off (existing password path unchanged).
MOMO_BOOTSTRAP_CLAIM=

# --- instance operator (#1534) ----------------------------------------------
# Comma-separated addresses this instance treats as its OPERATORS (MOMO-583).
# The instance-global surfaces — 설정 › AI 연결 (`/v1/provider/link`) and
# `POST /v1/workspaces` — open to a `platform:read` token OR to an owner/admin
# whose *verified* address is listed here. A self-hosted stack cannot mint the
# former, so an empty list closes those surfaces to everybody, including
# whoever installed the instance. That is not a theoretical posture: it is what
# made "설치 → 첫 에이전트 응답" unreachable in the #1526 measurement (F1).
#
# Normally the same address as MOMO_INITIAL_OWNER_EMAIL above. Changing it needs
# an api restart — this is process env, not a database row. (The provider key
# itself IS a row, and needs no restart.)
PLATFORM_ADMIN_EMAILS=
