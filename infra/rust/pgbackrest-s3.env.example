# Optional S3-compatible repository topology for static Compose validation.
# Actual access key bytes remain separate uid-999 owner-only files. The live
# object-storage round trip is runtime-unverified until an attended NCP run.

MOMO_PGBACKREST_S3_BUCKET=oort-backups-example
MOMO_PGBACKREST_S3_ENDPOINT=objectstorage.example.invalid
MOMO_PGBACKREST_S3_REGION=kr-standard
MOMO_PGBACKREST_S3_KEY_FILE=/run/momo-pitr/pgbackrest-s3-key
MOMO_PGBACKREST_S3_KEY_SECRET_FILE=/run/momo-pitr/pgbackrest-s3-key-secret
