# Shape-only example of the owner-only 19-key artifact emitted by
# scripts/verify_pgbackrest_pitr.sh. Operators do not author this file and must
# not copy these placeholder identities into a migration. It exists so Compose
# template drift is checked without weakening the signed runtime contract.

MOMO_MIGRATE_ENV=production
MOMO_PITR_EVIDENCE_REQUIRED=1
MOMO_PITR_BOOTSTRAP_EMPTY=0
MOMO_PITR_EVIDENCE_FILE=/run/momo-pitr/evidence/pgbackrest-pitr-example.json
MOMO_PITR_HMAC_KEY_FILE=/run/momo-pitr/evidence-hmac-key
MOMO_PITR_MIGRATE_CIPHER_FILE=/run/momo-pitr/evidence/pgbackrest-pitr-example.cipher
MOMO_PITR_EXPECT_RUN_ID=pitr-20260812T000000Z-example
MOMO_PITR_EXPECT_GIT_COMMIT=0000000000000000000000000000000000000000
MOMO_PITR_EXPECT_COMPOSE_PROJECT=momo-rust
MOMO_PITR_EXPECT_SOURCE_VOLUME=momo-rust-pgdata
MOMO_PITR_EXPECT_RESTORE_VOLUME=momo-pitr-pitr-20260812T000000Z-example-restore-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
MOMO_PITR_EXPECT_REPO_VOLUME=momo-rust-pgbackrest-repo
MOMO_PITR_EXPECT_POSTGRES_IMAGE_DIGEST=sha256:1111111111111111111111111111111111111111111111111111111111111111
MOMO_PITR_EXPECT_MIGRATE_IMAGE_DIGEST=sha256:2222222222222222222222222222222222222222222222222222222222222222
MOMO_PITR_EXPECT_STANZA=momo
MOMO_PITR_EXPECT_CIPHER_TYPE=aes-256-cbc
MOMO_PITR_EXPECT_CIPHER_FINGERPRINT=3333333333333333333333333333333333333333333333333333333333333333
MOMO_PITR_EXPECT_SYSTEM_IDENTIFIER=1234567890123456789
MOMO_POSTGRES_PGBACKREST_IMAGE=ghcr.io/yeomyeonggeori/oort-postgres@sha256:1111111111111111111111111111111111111111111111111111111111111111
