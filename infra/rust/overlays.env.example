# Template for the three deploy overlays (#1228):
#   infra/rust/t3.override.yml · caddy.override.yml · cent-origin.override.yml
#
#   cp infra/rust/overlays.env.example infra/rust/overlays.secrets.env
#   # then replace every change-me-* / example.com value
#
# `*.secrets.env` is gitignored repo-wide — never rename the copy, never commit
# it. This file is layered ON TOP of rust-smoke.secrets.env, exactly like
# push-relay.secrets.env is:
#
#   docker compose --env-file infra/rust/rust-smoke.secrets.env \
#     --env-file infra/rust/overlays.secrets.env \
#     -f infra/rust/docker-compose.rust.yml \
#     -f infra/rust/t3.override.yml \
#     -f infra/rust/caddy.override.yml \
#     -f infra/rust/cent-origin.override.yml <command>
#
# ## Why a separate file instead of adding these keys to rust-smoke.env.example
#
# The base template is the contract of the base stack: everything in it is
# required to boot postgres/api/relay/agent-worker. These keys are required
# only when an operator names an overlay, and mixing the two makes both
# unreadable — you can no longer tell which missing value is what broke you.
# Two files, two failure surfaces.
#
# Every key below is interpolated with `${VAR:?}`. There is no key here whose
# omission produces a quietly half-configured stack: `docker compose config`
# exits 1 and names the variable before anything starts.

# ── t3.override.yml — ADR-0140 platform surfaces ────────────────────────────
# "1" opens them, anything else keeps them closed (bins/momo-server/config.rs).
MOMO_T3_ENABLED=1

# Comma-separated operator addresses, lowercased on read. Only these accounts
# can mint a `platform:read` token. Empty = the surface is open to nobody,
# which is a working deployment right up until you need it.
PLATFORM_ADMIN_EMAILS=ops@example.com

# This deployment's public origin — the address a provisioned workd registers
# back to. No trailing slash.
MOMO_PUBLIC_BASE_URL=https://app.example.com

# ── cent-origin.override.yml — WSS origin allowlist ─────────────────────────
# **SPACE-separated** (Centrifugo v6 env format). A JSON array string becomes a
# single element that matches nothing and every client gets 403 on connect
# (2026-08-01 실측). Include the Tauri desktop origin if a packaged shell has
# to reach this deployment.
CENTRIFUGO_ALLOWED_ORIGINS=https://app.example.com tauri://localhost

# ── caddy.override.yml — TLS edge + web serving ─────────────────────────────
#
# ⚠ Naming `caddy.override.yml` anywhere but the deploy host starts a real ACME
# order for the hostname in infra/rust/Caddyfile, at container boot, whatever
# ports you map here. Moving these two values does NOT make the run local
# (#1228 실측: 4 failed challenges against production Let's Encrypt). For local
# work, leave this overlay out — see the header of caddy.override.yml.
#
# Host ports. 80/443 are the deploy values and ACME HTTP-01 requires them.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# The TLS edge image. Left as a moving tag to match the live deployment; pin it
# by digest here (caddy:2-alpine@sha256:…) when you want the edge binary to
# change only when you say so.
MOMO_CADDY_IMAGE=caddy:2-alpine

# The site's hostname and the routes live in infra/rust/Caddyfile, not here —
# it is a repo-canonical file (#1217), mounted read-only by the overlay.
#
# The SPA is NOT configured here either. It ships inside ${MOMO_RUST_IMAGE} and
# `web-init` stages it into the `web-static` volume, so the web version is the
# image version (#1228). Nothing to copy, nothing to keep in sync.

# ── keys these overlays require but do NOT own ──────────────────────────────
# t3.override.yml also interpolates CENT_TOKEN_HMAC, CENT_PROXY_SECRET and
# PROVIDER_LINK_MASTER_KEY. All three belong to the base stack and live in
# rust-smoke.env.example — they are not repeated here, because two templates
# offering the same secret is how the two copies drift apart.
