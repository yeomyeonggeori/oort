# Exact operator-owned POSIX repository inputs for the attended PITR runner.
#
# This file is deliberately only two keys. The signed evidence producer emits
# the other migration bindings in its owner-only 19-key `.env` artifact, and
# scripts/run_pitr_gated_migrate.sh rejects overlap between operator, backup,
# and evidence bindings before Docker is called. Values are host paths/names;
# the repository cipher bytes themselves never belong in an env file.

MOMO_PGBACKREST_CIPHER_FILE=/run/momo-pitr/pgbackrest-repo1-cipher-pass
PGBACKREST_REPO_VOLUME_NAME=momo-rust-pgbackrest-repo
