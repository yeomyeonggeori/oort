{
  "channel": {
    "namespaces": [
      {
        "name": "ch",
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": true,
        "history_size": 300,
        "history_ttl": "720h",
        "history_meta_ttl": "744h",
        "force_recovery": true,
        "force_positioning": true,
        "subscribe_proxy_enabled": true,
        "channel_regex": "^ws[0-9A-Fa-f-]{36}\\.[0-9A-Fa-f-]{36}$"
      },
      {
        "name": "dm",
        "presence": true,
        "history_size": 300,
        "history_ttl": "720h",
        "history_meta_ttl": "744h",
        "force_recovery": true,
        "allow_user_limited_channels": true
      },
      {
        "name": "agent",
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": true,
        "history_size": 100,
        "history_ttl": "24h",
        "history_meta_ttl": "48h",
        "force_recovery": true,
        "subscribe_proxy_enabled": true,
        "channel_regex": "^ws[0-9A-Fa-f-]{36}\\.[0-9A-Fa-f-]{36}\\.[0-9A-Fa-f-]{36}$"
      },
      {
        "name": "agentwork",
        "history_size": 100,
        "history_ttl": "24h",
        "history_meta_ttl": "48h",
        "force_recovery": true,
        "subscribe_proxy_enabled": true,
        "channel_regex": "^ws[0-9A-Fa-f-]{36}\\.[0-9A-Fa-f-]{36}$"
      },
      {
        "name": "user",
        "history_size": 50,
        "history_ttl": "168h",
        "history_meta_ttl": "192h",
        "force_recovery": true,
        "allow_user_limited_channels": true
      },
      {
        "name": "typing",
        "history_size": 0,
        "history_ttl": "0s",
        "subscribe_proxy_enabled": true,
        "channel_regex": "^ws[0-9A-Fa-f-]{36}\\.[0-9A-Fa-f-]{36}$"
      }
    ],
    "proxy": {
      "subscribe": {
        "endpoint": "http://api:8080/v1/centrifugo/subscribe",
        "include_connection_meta": true,
        "http": {
          "static_headers": {
            "X-Centrifugo-Proxy-Secret": "dev-insecure-cent-proxy-secret"
          }
        }
      }
    }
  },
  "client": {
    "allowed_origins": [
      "https://app.oor7.com",
      "https://app.localhost",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "tauri://localhost",
      "http://tauri.localhost"
    ],
    "subscription_token": {
      "enabled": true
    }
  }
}