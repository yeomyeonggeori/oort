            "scopes": [
              "github:read"
            ]
          },
          {
            "approvalPolicy": "none",
            "description": "권한을 위임한 사용자가 접근할 수 있는 저장소에서 이슈를 검색합니다.",
            "inputSchema": {
              "additionalProperties": false,
