{
  "version": 1,
  "adr": "docs/adr/0218-workspace-expressions.md §12 L6",
  "readBy": "the core test (set.test.ts) and, in the server slice, a Rust test; the core package cannot read outside itself (purity gate), so the file lives here",
  "rule": "One decision keeps some ready slots of one set card. The items are taken in SLOT order whatever the request order. A draft that is not a ready slot of the card (a grey slot has no id), a revision or hash that is not the one shown, or an expired card refuses the WHOLE decision (409 expression_preview_stale). A name the workspace already has is skipped (name_taken); once live registrations reach the ceiling every later item is skipped (quota). A skip never stops the others. Nothing registered at all is a refusal: expression_name_reserved if any skip was a name, else expression_quota. A kind the person chose wins, else the J4 recommendation (expression-kind.vectors.json) for the stored large picture.",
  "quota": 1000,
  "slotFields": "index (0-39, the slot order), name, state (ready|gray), kind (still|gif), width/height/frames = the stored LARGE picture of a ready slot (frames > 1 is a GIF)",
  "caseFields": "choose = slot indexes the person kept, in REQUEST order; chooseKinds = index -> kind the person picked; taken = names the workspace has; live = registrations that are not deleted; quota = override of the ceiling; stale = indexes whose choice pins a revision the card did not show; expired = the card is past its window; expect = the verdict (registered/skipped in SLOT order)",
  "cases": [
    {
      "name": "every kept ready slot registers, and the kind follows the stored large picture",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 512, "height": 512, "frames": 1 },
        { "index": 2, "name": "cat_c", "state": "ready", "kind": "gif", "width": 360, "height": 360, "frames": 16 }
      ],
      "choose": [0, 1, 2],
      "taken": [],
      "live": 10,
      "expect": { "ok": true, "registered": [{ "name": "cat_a", "kind": "emoji" }, { "name": "cat_b", "kind": "sticker" }, { "name": "cat_c", "kind": "sticker" }], "skipped": [] }
    },
    {
      "name": "the order of the request does not matter: slot order wins",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 2, "name": "cat_c", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [2, 0, 1],
      "taken": [],
      "live": 0,
      "expect": { "ok": true, "registered": [{ "name": "cat_a", "kind": "emoji" }, { "name": "cat_b", "kind": "emoji" }, { "name": "cat_c", "kind": "emoji" }], "skipped": [] }
    },
    {
      "name": "the person may keep only some of the ready slots",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 2, "name": "cat_c", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [1],
      "taken": [],
      "live": 0,
      "expect": { "ok": true, "registered": [{ "name": "cat_b", "kind": "emoji" }], "skipped": [] }
    },
    {
      "name": "a name the workspace already has is skipped and the others still register",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 2, "name": "cat_c", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 1, 2],
      "taken": ["cat_b"],
      "live": 10,
      "expect": { "ok": true, "registered": [{ "name": "cat_a", "kind": "emoji" }, { "name": "cat_c", "kind": "emoji" }], "skipped": [{ "name": "cat_b", "reason": "name_taken" }] }
    },
    {
      "name": "the kind the person picked beats the recommendation",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 512, "height": 512, "frames": 1 }
      ],
      "choose": [0],
      "chooseKinds": { "0": "emoji" },
      "taken": [],
      "live": 0,
      "expect": { "ok": true, "registered": [{ "name": "cat_a", "kind": "emoji" }], "skipped": [] }
    },
    {
      "name": "past the ceiling every later item is skipped, in slot order",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 2, "name": "cat_c", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [2, 1, 0],
      "taken": [],
      "live": 998,
      "expect": { "ok": true, "registered": [{ "name": "cat_a", "kind": "emoji" }, { "name": "cat_b", "kind": "emoji" }], "skipped": [{ "name": "cat_c", "reason": "quota" }] }
    },
    {
      "name": "a taken name does not use a place under the ceiling",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 1],
      "taken": ["cat_a"],
      "live": 999,
      "expect": { "ok": true, "registered": [{ "name": "cat_b", "kind": "emoji" }], "skipped": [{ "name": "cat_a", "reason": "name_taken" }] }
    },
    {
      "name": "every kept name taken: nothing registers and the approval is not spent",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 1],
      "taken": ["cat_a", "cat_b"],
      "live": 5,
      "expect": { "ok": false, "status": 409, "code": "expression_name_reserved" }
    },
    {
      "name": "the library is full: nothing registers",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0],
      "taken": [],
      "live": 1000,
      "expect": { "ok": false, "status": 409, "code": "expression_quota" }
    },
    {
      "name": "a taken name and a full library together refuse as a taken name",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 1],
      "taken": ["cat_a"],
      "live": 1000,
      "expect": { "ok": false, "status": 409, "code": "expression_name_reserved" }
    },
    {
      "name": "a grey slot has no id: naming it refuses the whole decision",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "gray", "kind": "still" }
      ],
      "choose": [0, 1],
      "taken": [],
      "live": 0,
      "expect": { "ok": false, "status": 409, "code": "expression_preview_stale" }
    },
    {
      "name": "one stale revision refuses the whole decision",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 },
        { "index": 1, "name": "cat_b", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 1],
      "stale": [1],
      "taken": [],
      "live": 0,
      "expect": { "ok": false, "status": 409, "code": "expression_preview_stale" }
    },
    {
      "name": "an expired card refuses the whole decision",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0],
      "expired": true,
      "taken": [],
      "live": 0,
      "expect": { "ok": false, "status": 409, "code": "expression_preview_stale" }
    },
    {
      "name": "the same draft twice is a malformed request",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [0, 0],
      "taken": [],
      "live": 0,
      "expect": { "ok": false, "status": 400, "code": "expression_choice_invalid" }
    },
    {
      "name": "an empty list is a malformed request",
      "slots": [
        { "index": 0, "name": "cat_a", "state": "ready", "kind": "still", "width": 64, "height": 64, "frames": 1 }
      ],
      "choose": [],
      "taken": [],
      "live": 0,
      "expect": { "ok": false, "status": 400, "code": "expression_choice_invalid" }
    }
  ],
  "referenceRule": "ADR-0218 section 12 L18. The server picks the pictures (the requester's own images on the trigger message) and judges rows first, bytes after consent. One failing picture refuses the WHOLE bundle: nothing is dropped quietly. No picture at all is fine (words alone). The verdict lists every distinct issue in this fixed order: too_many, duplicate, format, input_bytes, input_pixels, prepared_bytes, bundle_bytes.",
  "referenceLimits": { "pictures": 4, "inputBytes": 5242880, "inputEdge": 4096, "inputPixels": 16000000, "preparedBytesEach": 4194304, "bundleBytes": 4194304, "mimes": ["image/png", "image/jpeg", "image/webp"] },
  "referenceCaseFields": "pictures = the attached images in order: mime, bytes, width, height and, once the isolated decoder ran, preparedBytes; duplicateOf = index of an earlier picture this one repeats (same attachment id)",
  "referenceCases": [
    { "name": "no picture: words alone is a fine bundle", "pictures": [], "expect": { "ok": true, "count": 0, "bundleBytes": 0 } },
    { "name": "two pictures that pass, a PNG and a JPEG", "pictures": [
        { "mime": "image/png", "bytes": 320000, "width": 800, "height": 600, "preparedBytes": 310000 },
        { "mime": "image/jpeg", "bytes": 180000, "width": 1024, "height": 768, "preparedBytes": 150000 } ], "expect": { "ok": true, "count": 2, "bundleBytes": 460000 } },
    { "name": "a WebP is a picture too", "pictures": [ { "mime": "image/webp", "bytes": 90000, "width": 512, "height": 512, "preparedBytes": 80000 } ], "expect": { "ok": true, "count": 1, "bundleBytes": 80000 } },
    { "name": "four pictures whose prepared bytes are exactly the bundle ceiling pass", "pictures": [
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 } ], "expect": { "ok": true, "count": 4, "bundleBytes": 4194304 } },
    { "name": "one byte over the bundle ceiling refuses all four", "pictures": [
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048577 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 1048576 } ], "expect": { "ok": false, "refused": ["bundle_bytes"] } },
    { "name": "five pictures: the server does not keep the first four", "pictures": [
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 }, { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 }, { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 } ], "expect": { "ok": false, "refused": ["too_many"] } },
    { "name": "a GIF is refused by format", "pictures": [ { "mime": "image/gif", "bytes": 90000, "width": 400, "height": 400 } ], "expect": { "ok": false, "refused": ["format"] } },
    { "name": "a HEIC next to a good PNG refuses the whole bundle", "pictures": [
        { "mime": "image/png", "bytes": 320000, "width": 800, "height": 600 }, { "mime": "image/heic", "bytes": 400000, "width": 3000, "height": 2000 } ], "expect": { "ok": false, "refused": ["format"] } },
    { "name": "exactly 5 MiB in is allowed", "pictures": [ { "mime": "image/jpeg", "bytes": 5242880, "width": 4000, "height": 3000, "preparedBytes": 900000 } ], "expect": { "ok": true, "count": 1, "bundleBytes": 900000 } },
    { "name": "one byte over 5 MiB in is refused", "pictures": [ { "mime": "image/jpeg", "bytes": 5242881, "width": 4000, "height": 3000 } ], "expect": { "ok": false, "refused": ["input_bytes"] } },
    { "name": "4096 by 3906 is 15,998,976 pixels: inside both limits", "pictures": [ { "mime": "image/png", "bytes": 1000, "width": 4096, "height": 3906 } ], "expect": { "ok": true, "count": 1, "bundleBytes": 0 } },
    { "name": "4096 by 4096 is 16,777,216 pixels: over the pixel limit", "pictures": [ { "mime": "image/png", "bytes": 1000, "width": 4096, "height": 4096 } ], "expect": { "ok": false, "refused": ["input_pixels"] } },
    { "name": "one side past 4096 is refused even with few pixels", "pictures": [ { "mime": "image/png", "bytes": 1000, "width": 4097, "height": 10 } ], "expect": { "ok": false, "refused": ["input_pixels"] } },
    { "name": "a zero-sized picture cannot be real", "pictures": [ { "mime": "image/png", "bytes": 1000, "width": 0, "height": 600 } ], "expect": { "ok": false, "refused": ["input_pixels"] } },
    { "name": "a single prepared picture over 4 MiB is over both ceilings", "pictures": [ { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "preparedBytes": 4194305 } ], "expect": { "ok": false, "refused": ["prepared_bytes", "bundle_bytes"] } },
    { "name": "the same attachment twice", "pictures": [
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 }, { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "duplicateOf": 0 } ], "expect": { "ok": false, "refused": ["duplicate"] } },
    { "name": "every issue at once lists each once, in the fixed order", "pictures": [
        { "mime": "image/gif", "bytes": 5242881, "width": 5000, "height": 5000, "preparedBytes": 4194305 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10, "duplicateOf": 0 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 }, { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 },
        { "mime": "image/png", "bytes": 1000, "width": 10, "height": 10 } ], "expect": { "ok": false, "refused": ["too_many", "duplicate", "format", "input_bytes", "input_pixels", "prepared_bytes", "bundle_bytes"] } }
  ],
  "streakRule": "ADR-0218 section 12 L7.7 (owner 2026-11-06, O2). Stills are made in index order, one delegation each. Three refusals in a row close the rest: every still not yet tried is not_made. A made or failed attempt starts the count over. An attempt after the closing one is ignored. A still never tried for any other reason (time, a cap, a cancel) is not_made too.",
  "streak": 3,
  "mayTryCases": [
    { "name": "nothing tried yet", "attempts": [], "expect": true },
    { "name": "two refusals are not three", "attempts": ["refused", "refused"], "expect": true },
    { "name": "three refusals in a row close the set", "attempts": ["refused", "refused", "refused"], "expect": false },
    { "name": "a made attempt starts the count over", "attempts": ["refused", "refused", "made"], "expect": true },
    { "name": "three in a row after an earlier success", "attempts": ["made", "refused", "refused", "refused"], "expect": false },
    { "name": "a failed attempt starts the count over: a timeout is not a refusal", "attempts": ["refused", "refused", "failed", "refused", "refused"], "expect": true },
    { "name": "a closed set stays closed whatever came after", "attempts": ["refused", "refused", "refused", "made"], "expect": false },
    { "name": "failures alone never close a set", "attempts": ["failed", "failed", "failed", "failed"], "expect": true }
  ],
  "streakCases": [
    { "name": "all made", "stills": 4, "attempts": ["made", "made", "made", "made"], "expect": ["made", "made", "made", "made"] },
    { "name": "three refusals at the start close all the rest", "stills": 8, "attempts": ["refused", "refused", "refused"], "expect": ["refused", "refused", "refused", "not_made", "not_made", "not_made", "not_made", "not_made"] },
    { "name": "two refusals are not enough", "stills": 4, "attempts": ["refused", "refused", "made", "made"], "expect": ["refused", "refused", "made", "made"] },
    { "name": "a made attempt starts the count over", "stills": 8, "attempts": ["refused", "refused", "made", "refused", "refused", "made", "made", "made"], "expect": ["refused", "refused", "made", "refused", "refused", "made", "made", "made"] },
    { "name": "a failed attempt starts the count over too: a timeout says nothing about the next scene", "stills": 6, "attempts": ["refused", "refused", "failed", "refused", "refused", "made"], "expect": ["refused", "refused", "failed", "refused", "refused", "made"] },
    { "name": "three in a row after earlier successes close the rest", "stills": 8, "attempts": ["made", "made", "refused", "refused", "refused"], "expect": ["made", "made", "refused", "refused", "refused", "not_made", "not_made", "not_made"] },
    { "name": "fewer attempts than stills: the rest was never tried", "stills": 5, "attempts": ["made", "failed"], "expect": ["made", "failed", "not_made", "not_made", "not_made"] },
    { "name": "an attempt after the closing refusal is ignored", "stills": 5, "attempts": ["refused", "refused", "refused", "made", "made"], "expect": ["refused", "refused", "refused", "not_made", "not_made"] },
    { "name": "three refusals on the very last stills close nothing more", "stills": 3, "attempts": ["refused", "refused", "refused"], "expect": ["refused", "refused", "refused"] },
    { "name": "a set with no stills settles to nothing", "stills": 0, "attempts": [], "expect": [] }
  ],
  "gifRule": "A GIF is not made by Hermes: the server moves a still. A closed streak does not stop a GIF whose still was made; a GIF whose still is grey (refused, failed or never made) or out of range is base_missing.",
  "gifCases": [
    { "name": "bases that were made", "stills": ["made", "made", "made"], "bases": [0, 2], "expect": ["made", "made"] },
    { "name": "a refused, a failed and a never-made base", "stills": ["refused", "failed", "not_made"], "bases": [0, 1, 2], "expect": ["base_missing", "base_missing", "base_missing"] },
    { "name": "the streak closed the rest, but the first still exists", "stills": ["made", "refused", "refused", "refused", "not_made", "not_made"], "bases": [0, 5], "expect": ["made", "base_missing"] },
    { "name": "a base outside the stills is missing", "stills": ["made"], "bases": [1, 40], "expect": ["base_missing", "base_missing"] }
  ],
  "planRule": "ADR-0218 section 12 L2.5 and L19 (owner 2026-11-06, O5). The plan card is the person's one look before anything leaves. THE invariant: nothing is read or sent for a set unless its plan card was confirmed. An unanswered card past its window is expired. A confirmed set keeps making after the window (the window is for the answer). The notice is shown once per member: due only while pictures would be sent AND the member has no record. 'Take out only': an edit may remove pictures of the server's bundle and never add one; one id the bundle does not hold refuses the whole edit.",
  "planGateCases": [
    { "name": "waiting for the button: nothing leaves", "state": "planned", "expiresAtMs": 1000, "nowMs": 500, "expect": false },
    { "name": "waiting, window over: expired, nothing leaves", "state": "planned", "expiresAtMs": 1000, "nowMs": 1000, "expect": false },
    { "name": "confirmed: it may start", "state": "confirmed", "expiresAtMs": 1000, "nowMs": 500, "expect": true },
    { "name": "confirmed, and the answer window has passed since: it keeps making", "state": "confirmed", "expiresAtMs": 1000, "nowMs": 999999, "expect": true },
    { "name": "cancelled: nothing leaves", "state": "cancelled", "expiresAtMs": 1000, "nowMs": 500, "expect": false },
    { "name": "expired: nothing leaves", "state": "expired", "expiresAtMs": 1000, "nowMs": 500, "expect": false }
  ],
  "noticeCases": [
    { "name": "first time with pictures: told", "seenAtMs": null, "references": 2, "expect": true },
    { "name": "seen before: not told again", "seenAtMs": 1793314800000, "references": 2, "expect": false },
    { "name": "words alone: nothing is sent, nothing to tell", "seenAtMs": null, "references": 0, "expect": false },
    { "name": "a record at time zero is still a record", "seenAtMs": 0, "references": 1, "expect": false }
  ],
  "narrowCases": [
    { "name": "taking nothing out keeps the bundle", "current": ["a", "b"], "remove": [], "expect": { "ok": true, "references": ["a", "b"] } },
    { "name": "taking one out", "current": ["a", "b"], "remove": ["a"], "expect": { "ok": true, "references": ["b"] } },
    { "name": "taking all out leaves words alone", "current": ["a", "b"], "remove": ["a", "b"], "expect": { "ok": true, "references": [] } },
    { "name": "an id the bundle does not hold refuses the edit: no adding", "current": ["a", "b"], "remove": ["c"], "expect": { "ok": false, "unknown": ["c"] } },
    { "name": "one known and one unknown refuses the whole edit", "current": ["a", "b"], "remove": ["a", "c"], "expect": { "ok": false, "unknown": ["c"] } },
    { "name": "the same id twice is one removal", "current": ["a", "b"], "remove": ["a", "a"], "expect": { "ok": true, "references": ["b"] } }
  ]
}
