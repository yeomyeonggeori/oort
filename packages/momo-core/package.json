    "gate:purity": "node scripts/purity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
