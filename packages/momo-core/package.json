{
  "name": "@momo/core",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Platform-free domain logic shared by every momo (oort) client (ADR-0137 D3). No UI, no platform API, and no runtime dependency but FormatJS (ADR-0213) — enforced by scripts/purity.mjs.",
  "type": "module",
  "exports": {
    "./i18n": "./src/i18n/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "extract:emoji": "node scripts/extract-emoji-catalog.mjs",
    "gate:emoji": "node scripts/extract-emoji-catalog.mjs --check",
    "test": "vitest run",
    "i18n:generate": "node src/i18n/tooling/generate.mjs",
    "i18n:check": "node src/i18n/tooling/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "gate:purity": "node scripts/purity.mjs",
    "gate:copy": "node ../../scripts/design_preflight_core.mjs && node ../../scripts/design_preflight_names.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "emojibase-data": "18.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@formatjs/intl": "6.1.4"
  }
}
