#!/usr/bin/env bash
# oort operator CLI dispatcher. bash 3.2, set -euo pipefail.
# SH-3a implements `doctor` only. status/logs/upgrade/backup/member are SH-3b.
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
OORT_ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)"
export OORT_ROOT

usage() {
  cat <<'EOF'
Usage: scripts/oort <command> [options]

Commands:
  doctor [--env FILE] [--json] [--strict]
      Self-host install verdict (tools, env, stack). Compose/env are read-only.
      Exit: 0 pass, 1 major-only, 2 any blocker. --strict promotes major to 2.

  status    (SH-3b에서)
  logs      (SH-3b에서)
  upgrade   (SH-3b에서)
  backup    (SH-3b에서)
  member    (SH-3b에서)

  help      Show this help.
EOF
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  doctor)
    # shellcheck source=lib/oort_doctor.sh
    # shellcheck disable=SC1091
    . "$SCRIPT_DIR/lib/oort_doctor.sh"
    oort_doctor "$@"
    ;;
  status | logs | upgrade | backup | member)
    printf 'scripts/oort %s 는 SH-3b에서 구현한다.\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
  help | -h | --help | '')
    usage
    exit 0
    ;;
  *)
    printf 'scripts/oort: 알 수 없는 명령: %s\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
