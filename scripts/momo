#!/usr/bin/env bash
# Friendly local dogfood launcher for momo.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
APP_SCRIPT="$REPO_ROOT/scripts/macos_dev_run.sh"
ALPHA_SCRIPT="$REPO_ROOT/scripts/local_alpha_runner.sh"

BASE_URL="${MOMO_BASE_URL:-http://127.0.0.1:28180}"
API_PORT="${MOMO_API_PORT:-28180}"
POSTGRES_PORT="${MOMO_POSTGRES_PORT:-28132}"
CENT_PORT="${MOMO_CENT_PORT:-28100}"
HERMES_PORT="${MOMO_HERMES_PORT:-28188}"
HERMES_MODE="${MOMO_HERMES_MODE:-mock}"
APP_WAIT="${MOMO_APP_WAIT:-20}"
LOGIN_EMAIL="${MOMO_LOGIN_EMAIL:-demo@momo.local}"
LOGIN_PASSWORD="${MOMO_LOGIN_PASSWORD:-dev-password}"
LOGIN_SMOKE_ALLOW_NON_LOOPBACK="${MOMO_LOGIN_SMOKE_ALLOW_NON_LOOPBACK:-0}"
STATE_DIR="${MOMO_DOGFOOD_STATE_DIR:-${TMPDIR:-/tmp}/momo-dogfood}"
STATE_FILE="$STATE_DIR/state.env"
ALPHA_EVIDENCE_ROOT="${LOCAL_ALPHA_EVIDENCE_ROOT:-${TMPDIR:-/tmp}/momo-local-alpha}"

usage() {
  cat <<'EOF'
Usage: scripts/momo <command>

Commands:
  start       Start local alpha if needed, then open the macOS app.
  up          Start local alpha only.
  app         Open the macOS app only.
  status      Show app/server/Docker status.
  hermes      Show local Hermes provider setup status and next steps.
  hermes-init Create ~/.momo/local-hermes-provider.env from the safe template.
  hermes-smoke Run the credentialed Hermes provider smoke wrapper.
  hermes-gateway-init
              Create the pre-pairing ~/.momo/hermes-gateway.env template.
  hermes-gateway-status
              Show oort-facing Hermes gateway adapter status.
  hermes-gateway-install-plugin
              Link/copy adapters/hermes into the local Hermes plugin directory.
  hermes-gateway-smoke
              Run mock smoke, or pass --real [--trigger] for real Hermes evidence.
  host add ssh://user@host [options]
              Copy a target-compatible momo-workd and install its user service.
  cleanup-seeded-agents
              Retire historical dogfood seed agents; requires explicit --yes.
  stop        Stop the app and the local alpha stack when it can be identified.
  stop-app    Stop the macOS app only.
  stop-stack  Stop the local alpha stack only.
  help        Show this help.

Defaults:
  Server URL: http://127.0.0.1:28180
  Login:      demo@momo.local / dev-password

Examples:
  scripts/momo start
  scripts/momo status
  scripts/momo host add ssh://user@host --help
  scripts/momo stop

Environment overrides:
  MOMO_BASE_URL=http://127.0.0.1:28180
  MOMO_API_PORT=28180
  MOMO_POSTGRES_PORT=28132
  MOMO_CENT_PORT=28100
  MOMO_HERMES_PORT=28188
  MOMO_HERMES_MODE=mock
  LOCAL_HERMES_PROVIDER_ENV_FILE=$HOME/.momo/local-hermes-provider.env
  MOMO_HERMES_GATEWAY_ENV_FILE=$HOME/.momo/hermes-gateway.env
EOF
}

info() {
  printf '[momo] %s\n' "$*"
}

warn() {
  printf '[momo] WARN: %s\n' "$*" >&2
}

health_check() {
  curl -fsS --max-time 3 "$BASE_URL/health" >/dev/null 2>&1
}

base_url_is_loopback() {
  python3 - "$BASE_URL" <<'PY'
import ipaddress
import sys
from urllib.parse import urlparse

host = urlparse(sys.argv[1]).hostname or ""
if host == "localhost":
    sys.exit(0)
try:
    sys.exit(0 if ipaddress.ip_address(host).is_loopback else 1)
except ValueError:
    sys.exit(1)
PY
}

login_smoke_allowed() {
  [ "$LOGIN_SMOKE_ALLOW_NON_LOOPBACK" = "1" ] || base_url_is_loopback
}

login_check() {
  login_smoke_allowed || return 0
  printf '%s\0%s\0%s' "$BASE_URL" "$LOGIN_EMAIL" "$LOGIN_PASSWORD" | python3 -c '
import json
import sys
import urllib.error
import urllib.request

raw = sys.stdin.buffer.read().split(b"\0", 2)
if len(raw) != 3:
    sys.exit(1)
base_url, email, password = [part.decode("utf-8") for part in raw]
base_url = base_url.rstrip("/")

def request_json(path, body, headers=None):
    data = json.dumps(body, separators=(",", ":")).encode("utf-8")
    req_headers = {"Content-Type": "application/json"}
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(
        base_url + path,
        data=data,
        headers=req_headers,
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=5) as response:
        payload = response.read()
    return json.loads(payload.decode("utf-8") or "{}")

try:
    login = request_json(
        "/v1/auth/login",
        {"email": email, "password": password},
    )
    access_token = login.get("accessToken") or ""
    refresh_token = login.get("refreshToken") or ""
    if not access_token or not refresh_token:
        sys.exit(1)
    request_json(
        "/v1/auth/logout",
        {"refreshToken": refresh_token},
        {"Authorization": "Bearer " + access_token},
    )
except (OSError, urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError):
    sys.exit(1)
except Exception:
    sys.exit(1)
'
}

ready_check() {
  health_check && login_check
}

print_health() {
  if curl -fsS --max-time 3 "$BASE_URL/health"; then
    printf '\n'
    return 0
  fi
  return 1
}

activate_app() {
  osascript -e 'tell application "MomoMacDevApp" to activate' >/dev/null 2>&1 || true
}

launch_app() {
  info "opening MomoMacDevApp"
  DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}" \
    "$APP_SCRIPT" --launch --verify --wait "$APP_WAIT"
  activate_app
}

latest_stop_script() {
  find "$ALPHA_EVIDENCE_ROOT" -name stop-local-alpha.sh -type f -print 2>/dev/null | sort | tail -n 1
}

write_state() {
  mkdir -p "$STATE_DIR"
  {
    printf 'BASE_URL=%q\n' "$BASE_URL"
    printf 'STOP_SCRIPT=%q\n' "${1:-}"
    printf 'UPDATED_AT=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$STATE_FILE"
}

state_stop_script() {
  if [ -f "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    printf '%s\n' "${STOP_SCRIPT:-}"
  fi
}

listener_pids_for_port() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
  fi
}

process_cwd_for_pid() {
  local pid="$1"
  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
}

path_is_inside_repo() {
  local path="$1"
  case "$path" in
    "$REPO_ROOT"|"$REPO_ROOT"/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

stop_orphan_momo_server_on_port() {
  local port="$1"
  local pid command cwd process_name stopped_any=1
  for pid in $(listener_pids_for_port "$port"); do
    command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    cwd="$(process_cwd_for_pid "$pid" || true)"
    process_name="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
    case "$command" in
      *MomoServer*|*"swift run --package-path server MomoServer"*)
        if ! path_is_inside_repo "$cwd"; then
          warn "leaving MomoServer listener pid=$pid on port $port outside this repo"
          continue
        fi
        warn "stopping stale MomoServer listener pid=$pid on port $port"
        kill "$pid" 2>/dev/null || true
        stopped_any=0
        ;;
      *)
        warn "leaving non-MomoServer listener pid=$pid on port $port (${process_name:-unknown})"
        ;;
    esac
  done
  return "$stopped_any"
}

start_stack() {
  if health_check; then
    if login_check; then
      info "local alpha is already ready: $BASE_URL"
      return 0
    fi
    warn "server health is reachable but login smoke failed; restarting stale local alpha"
    stop_stack || true
  fi

  info "starting local alpha stack on $BASE_URL"
  info "ports: api=$API_PORT postgres=$POSTGRES_PORT centrifugo=$CENT_PORT hermes=$HERMES_PORT"

  PORT="$API_PORT" \
  POSTGRES_PORT="$POSTGRES_PORT" \
  CENT_PORT="$CENT_PORT" \
  HERMES_PORT="$HERMES_PORT" \
  DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}" \
    "$ALPHA_SCRIPT" execute --hermes "$HERMES_MODE"

  local stop_script
  stop_script="$(latest_stop_script || true)"
  write_state "$stop_script"

  if ready_check; then
    info "local alpha is ready: $BASE_URL"
  else
    warn "local alpha command finished, but DB-backed login smoke is not ready at $BASE_URL"
    return 1
  fi
}

stop_app() {
  info "stopping MomoMacDevApp"
  "$APP_SCRIPT" --terminate-only
}

stop_with_script() {
  local stop_script="$1"
  if [ -n "$stop_script" ] && [ -x "$stop_script" ]; then
    info "stopping local alpha via $stop_script"
    "$stop_script"
    return 0
  fi
  return 1
}

compose_project_for_port() {
  local port="$1"
  local cid
  cid="$(docker ps --filter "publish=$port" --format '{{.ID}}' | head -n 1 || true)"
  if [ -z "$cid" ]; then
    return 1
  fi
  docker inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$cid" 2>/dev/null || true
}

stop_compose_project() {
  local project="$1"
  case "$project" in
    momo*|infra)
      ;;
    *)
      warn "refusing to stop non-momo Docker compose project: ${project:-<empty>}"
      return 1
      ;;
  esac

  local containers
  containers="$(docker ps -aq --filter "label=com.docker.compose.project=$project" || true)"
  if [ -z "$containers" ]; then
    return 1
  fi

  info "stopping Docker compose project: $project"
  # shellcheck disable=SC2086
  docker rm -f $containers >/dev/null
  docker network rm "${project}_default" >/dev/null 2>&1 || true
  return 0
}

stop_stack() {
  local stopped=0
  local stop_script
  stop_script="$(state_stop_script || true)"
  if stop_with_script "$stop_script"; then
    stopped=1
  fi

  if [ "$stopped" = "0" ]; then
    stop_script="$(latest_stop_script || true)"
    if stop_with_script "$stop_script"; then
      stopped=1
    fi
  fi

  if [ "$stopped" = "0" ]; then
    local project
    project="$(compose_project_for_port "$API_PORT" || true)"
    if [ -n "$project" ] && stop_compose_project "$project"; then
      stopped=1
    fi
  fi

  if stop_orphan_momo_server_on_port "$API_PORT"; then
    stopped=1
  fi

  if [ "$stopped" = "0" ]; then
    warn "no local alpha stack was identified. App stop still completed."
  fi
}

show_status() {
  info "app"
  if pgrep -x MomoMacDevApp >/dev/null 2>&1; then
    pgrep -fl MomoMacDevApp || true
  else
    echo "  not running"
  fi

  info "server"
  if print_health; then
    if ! login_smoke_allowed; then
      echo "  login smoke: skipped (non-loopback; set MOMO_LOGIN_SMOKE_ALLOW_NON_LOOPBACK=1 to enable)"
    elif login_check; then
      echo "  login smoke: ok"
    else
      echo "  login smoke: FAIL"
    fi
  else
    echo "  not reachable: $BASE_URL"
  fi

  info "docker on api port $API_PORT"
  local project
  project="$(compose_project_for_port "$API_PORT" || true)"
  if [ -n "$project" ]; then
    echo "  compose project: $project"
    docker ps --filter "label=com.docker.compose.project=$project" \
      --format '  {{.Names}} {{.Status}} {{.Ports}}'
  else
    echo "  no Docker compose project detected on port $API_PORT"
  fi
}

provider_env_file() {
  printf '%s\n' "${LOCAL_HERMES_PROVIDER_ENV_FILE:-${EXTERNAL_AGENT_PROVIDER_ENV_FILE:-${HOME:-}/.momo/local-hermes-provider.env}}"
}

provider_env_example() {
  printf '%s\n' "$REPO_ROOT/docs/external-agent-provider/local-hermes-provider.env.example"
}

absolute_path() {
  python3 - "$1" <<'PY'
import os
import sys
print(os.path.realpath(os.path.expanduser(sys.argv[1])))
PY
}

provider_env_inside_repo() {
  local env_abs repo_abs
  env_abs="$(absolute_path "$1")"
  repo_abs="$(absolute_path "$REPO_ROOT")"
  case "$env_abs" in
    "$repo_abs"/*) return 0 ;;
  esac
  return 1
}

reject_repo_provider_env() {
  local env_file="$1"
  if provider_env_inside_repo "$env_file"; then
    warn "Hermes provider env must live outside the repository: $env_file"
    warn "Use the default ~/.momo/local-hermes-provider.env or another untracked path."
    return 1
  fi
  return 0
}

provider_env_value() {
  local file="$1"
  local key="$2"
  awk -F= -v key="$key" '
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line == "" || line ~ /^#/) {
        next
      }
      sub(/^export[[:space:]]+/, "", line)
      lhs = line
      sub(/=.*/, "", lhs)
      gsub(/[[:space:]]/, "", lhs)
    }
    lhs == key {
      sub(/^[^=]*=/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      gsub(/^"|"$/, "", line)
      gsub(/^'\''|'\''$/, "", line)
      print line
      exit
    }
  ' "$file"
}

redacted_provider_url() {
  python3 - "$1" <<'PY'
import sys
from urllib.parse import urlsplit, urlunsplit

raw = sys.argv[1]
if not raw:
    print("not configured")
    raise SystemExit
try:
    parts = urlsplit(raw)
except Exception:
    print("invalid url")
    raise SystemExit
host = parts.hostname or ""
if ":" in host and not host.startswith("["):
    host = f"[{host}]"
netloc = host
try:
    port = parts.port
except ValueError:
    print("invalid url")
    raise SystemExit
if port is not None:
    netloc = f"{netloc}:{port}"
print(urlunsplit((parts.scheme, netloc, parts.path, "", "")))
PY
}

is_placeholder_value() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    ""|*"<"*">"*|*change-me*|*changeme*|*replace-with*|*placeholder*|*example*|*dev-insecure*|*not-openai-key*)
      return 0
      ;;
  esac
  return 1
}

forbidden_provider_env_names() {
  local key
  for key in CODEX_OAUTH_TOKEN CODEX_OAUTH_ACCESS_TOKEN CODEX_OAUTH_REFRESH_TOKEN \
    CODEX_ACCESS_TOKEN CODEX_REFRESH_TOKEN CODEX_API_KEY CODEX_PROVIDER_API_KEY \
    OPENAI_OAUTH_TOKEN OPENAI_OAUTH_ACCESS_TOKEN OPENAI_OAUTH_REFRESH_TOKEN \
    OPENAI_ACCESS_TOKEN OPENAI_REFRESH_TOKEN OPENAI_API_KEY OPENAI_ADMIN_KEY \
    OPENAI_PROVIDER_API_KEY; do
    if [ "${!key+x}" ] && [ "${!key:-}" != "" ]; then
      printf '%s\n' "$key"
    fi
  done
}

file_mode() {
  local file="$1"
  stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file" 2>/dev/null || printf 'unknown'
}

hermes_init() {
  local env_file example env_dir
  env_file="$(provider_env_file)"
  example="$(provider_env_example)"
  env_dir="$(dirname "$env_file")"
  reject_repo_provider_env "$env_file" || return 1

  if [ -f "$env_file" ]; then
    info "Hermes provider env already exists: $env_file"
    chmod 600 "$env_file" || {
      warn "failed to chmod 600 $env_file"
      return 1
    }
  else
    mkdir -p "$env_dir"
    cp "$example" "$env_file"
    chmod 600 "$env_file"
    info "created Hermes provider env: $env_file"
  fi

  cat <<EOF
[momo] edit this file with only oort-facing provider values:
  $env_file

Required values:
  AGENT_MODEL=<provider-model-label>
  HERMES_BASE_URL=http://127.0.0.1:<provider-port>/v1
  HERMES_API_KEY=<local Hermes-facing bearer, not OpenAI/Codex token>

Do not put OPENAI_API_KEY, Codex OAuth tokens, refresh tokens, or GPT provider
credentials in this file. Those belong inside the local Hermes-compatible
provider runtime.

Next:
  scripts/momo hermes
  scripts/momo hermes-smoke
EOF
}

hermes_status() {
  local env_file mode model url key mode_bits forbidden_count status_json
  env_file="$(provider_env_file)"

  info "Hermes provider setup"
  echo "  env file: $env_file"
  if ! reject_repo_provider_env "$env_file"; then
    echo "  state: unsafe path"
    echo "  next:  unset LOCAL_HERMES_PROVIDER_ENV_FILE or point it outside the repo"
    return 1
  fi
  if [ ! -f "$env_file" ]; then
    echo "  state: missing"
    echo "  next:  scripts/momo hermes-init"
    return 0
  fi

  mode_bits="$(file_mode "$env_file")"
  echo "  file mode: $mode_bits"
  if [ "$mode_bits" != "600" ]; then
    echo "  warning: expected chmod 600"
  fi

  mode="$(provider_env_value "$env_file" AGENT_PROVIDER_MODE)"
  model="$(provider_env_value "$env_file" AGENT_MODEL)"
  url="$(provider_env_value "$env_file" HERMES_BASE_URL)"
  key="$(provider_env_value "$env_file" HERMES_API_KEY)"

  echo "  provider mode: ${mode:-<missing>}"
  echo "  model: ${model:-<missing>}"
  echo "  endpoint: $(redacted_provider_url "$url")"
  if is_placeholder_value "$key"; then
    echo "  Hermes bearer: missing or placeholder"
  else
    echo "  Hermes bearer: configured (redacted)"
  fi

  forbidden_count="$(forbidden_provider_env_names | wc -l | tr -d '[:space:]')"
  if [ "$forbidden_count" != "0" ]; then
    echo "  boundary: FAIL - provider credential env is present in this shell"
    forbidden_provider_env_names | sed 's/^/    - /'
    echo "  fix: unset those variables and configure them only inside the provider runtime"
  else
    echo "  boundary: OK - no known OpenAI/Codex provider credential env in this shell"
  fi

  if health_check; then
    status_json="$(curl -fsS --max-time 3 "$BASE_URL/v1/agent-runtime/status" 2>/dev/null || true)"
    if [ -n "$status_json" ] && command -v jq >/dev/null 2>&1; then
      echo "  momo runtime: $(printf '%s' "$status_json" | jq -r '.mode + " · " + .availability + " · " + (.endpointLabel // "not configured")' 2>/dev/null || printf 'status unavailable')"
    else
      echo "  momo runtime: server reachable; status unavailable"
    fi
  else
    echo "  momo runtime: server not running at $BASE_URL"
  fi

  if is_placeholder_value "$key" || is_placeholder_value "$url" || is_placeholder_value "$model"; then
    echo "  next: edit $env_file, then run scripts/momo hermes-smoke"
  else
    echo "  next: start/login to your local provider, then run scripts/momo hermes-smoke"
  fi
}

hermes_smoke() {
  LOCAL_HERMES_PROVIDER_ENV_FILE="$(provider_env_file)" \
    "$REPO_ROOT/scripts/verify_local_hermes_credentialed_smoke.sh"
}

gateway_env_file() {
  printf '%s\n' "${MOMO_HERMES_GATEWAY_ENV_FILE:-${HOME:-}/.momo/hermes-gateway.env}"
}

migrate_legacy_gateway_env() {
  local env_file backup temp_file
  env_file="$1"
  if ! grep -Eq '^[[:space:]]*(MOMO_AGENT_GATEWAY_SECRET|MOMO_ALLOW_LEGACY_GATEWAY_SECRET|MOMO_AGENT_EMAIL|MOMO_AGENT_PASSWORD)=' "$env_file"; then
    return 0
  fi
  backup="${env_file}.legacy-$(date -u '+%Y%m%dT%H%M%SZ').bak"
  temp_file="$(mktemp "${env_file}.tmp.XXXXXX")"
  cp -p "$env_file" "$backup"
  awk '
    /^[[:space:]]*(MOMO_AGENT_GATEWAY_SECRET|MOMO_ALLOW_LEGACY_GATEWAY_SECRET|MOMO_AGENT_EMAIL|MOMO_AGENT_PASSWORD)=/ { next }
    { print }
  ' "$env_file" >"$temp_file"
  chmod 600 "$temp_file" "$backup"
  mv "$temp_file" "$env_file"
  info "removed deprecated gateway/operator keys from $env_file"
  warn "private migration backup created: $backup"
  warn "delete the backup after the new agent-token smoke succeeds"
}

hermes_home() {
  printf '%s\n' "${HERMES_HOME:-${HOME:-}/.hermes}"
}

hermes_plugin_dir() {
  printf '%s\n' "${MOMO_HERMES_PLUGIN_DIR:-$(hermes_home)/plugins/momo}"
}

hermes_config_file() {
  printf '%s\n' "${HERMES_CONFIG_FILE:-$(hermes_home)/config.yaml}"
}

hermes_bin() {
  if [ "${HERMES_BIN:-}" != "" ]; then
    printf '%s\n' "$HERMES_BIN"
    return 0
  fi
  if command -v hermes >/dev/null 2>&1; then
    command -v hermes
    return 0
  fi
  if [ -x "$(hermes_home)/bin/hermes" ]; then
    printf '%s\n' "$(hermes_home)/bin/hermes"
    return 0
  fi
  return 1
}

hermes_gateway_enable_plugin_config() {
  local config_file backup_file
  config_file="$(hermes_config_file)"
  mkdir -p "$(dirname "$config_file")"
  if [ -f "$config_file" ] && grep -Eq '^[[:space:]]*-[[:space:]]*momo[[:space:]]*$' "$config_file"; then
    info "Hermes momo plugin already enabled in $config_file"
    return 0
  fi
  if ! command -v ruby >/dev/null 2>&1; then
    warn "ruby not found; enable momo manually in $config_file:"
    warn "plugins:"
    warn "  enabled:"
    warn "    - momo"
    return 1
  fi
  if [ -f "$config_file" ]; then
    backup_file="${config_file}.momo.bak.$(date -u '+%Y%m%dT%H%M%SZ')"
    cp "$config_file" "$backup_file"
    info "backed up Hermes config: $backup_file"
  fi
  ruby - "$config_file" <<'RUBY'
require "yaml"

file = ARGV.fetch(0)
raw = File.exist?(file) ? File.read(file) : ""
data = raw.strip.empty? ? {} : YAML.safe_load(raw, permitted_classes: [], aliases: true)
data = {} unless data.is_a?(Hash)
plugins = data["plugins"]
plugins = {} unless plugins.is_a?(Hash)
enabled = plugins["enabled"]
enabled =
  case enabled
  when Array
    enabled.map(&:to_s)
  when String
    enabled.split(/[,\s]+/)
  else
    []
  end
enabled << "momo" unless enabled.include?("momo")
plugins["enabled"] = enabled
data["plugins"] = plugins
File.write(file, YAML.dump(data))
RUBY
  chmod 600 "$config_file" 2>/dev/null || true
  info "enabled Hermes momo plugin in $config_file"
}

hermes_gateway_init() {
  local env_file env_dir agent_token home_channel default_channel agent_member_id
  env_file="$(gateway_env_file)"
  env_dir="$(dirname "$env_file")"
  reject_repo_provider_env "$env_file" || return 1
  mkdir -p "$env_dir"
  if [ -f "$env_file" ]; then
    chmod 600 "$env_file"
    info "Hermes gateway env already exists: $env_file"
    migrate_legacy_gateway_env "$env_file"
    agent_token="$(provider_env_value "$env_file" MOMO_AGENT_TOKEN)"
    if is_placeholder_value "$agent_token"; then
      if ! grep -Eq '^[[:space:]]*MOMO_AGENT_TOKEN=' "$env_file"; then
        {
          printf '\n# Scoped momo credential returned once by agent pairing.\n'
          printf 'MOMO_AGENT_TOKEN=replace-with-one-time-agent-token\n'
        } >>"$env_file"
        info "added MOMO_AGENT_TOKEN placeholder to the existing env"
      fi
      warn "MOMO_AGENT_TOKEN is missing or still a placeholder."
      warn "Issue one agent credential from pairing and replace only that value."
    fi
    home_channel="$(provider_env_value "$env_file" MOMO_HOME_CHANNEL)"
    if is_placeholder_value "$home_channel"; then
      default_channel="$(provider_env_value "$env_file" MOMO_DEFAULT_CHANNEL_ID)"
      if ! is_placeholder_value "$default_channel" \
        && ! grep -Eq '^[[:space:]]*MOMO_HOME_CHANNEL=' "$env_file"; then
        {
          printf '\n# Hermes operational delivery target, configured before gateway startup.\n'
          printf 'MOMO_HOME_CHANNEL=%s\n' "$default_channel"
          if ! grep -Eq '^[[:space:]]*MOMO_HOME_CHANNEL_NAME=' "$env_file"; then
            printf 'MOMO_HOME_CHANNEL_NAME=agent-lab\n'
          fi
        } >>"$env_file"
        info "configured MOMO_HOME_CHANNEL from the existing default channel"
      fi
    fi
    agent_member_id="$(provider_env_value "$env_file" MOMO_AGENT_MEMBER_ID)"
    case "$agent_member_id" in
      00000000-0000-7000-8000-000000000102|00000000-0000-7000-8000-000000000103)
        warn "This env still points at a historical seed agent."
        warn "Run scripts/momo cleanup-seeded-agents --yes, pair Hermes, then replace the member/channel IDs."
        ;;
    esac
  else
    umask 077
    cat >"$env_file" <<EOF
# oort-facing Hermes platform adapter pairing.
# This file does not contain Codex/OpenAI OAuth or provider API keys.
MOMO_API_URL=${BASE_URL}
MOMO_CENTRIFUGO_WS_URL=ws://127.0.0.1:${CENT_PORT}/connection/websocket
MOMO_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
MOMO_AGENT_MEMBER_ID=replace-with-paired-agent-member-id
MOMO_AGENT_HANDLE=hermes
# Paste the one-time-issued credential from momo's agent pairing surface.
MOMO_AGENT_TOKEN=replace-with-one-time-agent-token
MOMO_DEFAULT_CHANNEL_ID=replace-with-invited-channel-id
# Hermes operational delivery target; set after pairing to the invited channel.
MOMO_HOME_CHANNEL=replace-with-invited-channel-id
MOMO_HOME_CHANNEL_NAME=replace-with-invited-channel-name
EOF
    chmod 600 "$env_file"
    info "created Hermes gateway env: $env_file"
  fi

  cat <<EOF
[momo] Hermes gateway adapter setup:
  env:     $env_file
  plugin:  $REPO_ROOT/adapters/hermes
  target:  $(hermes_plugin_dir)

1. Start momo in gateway mode (fresh local-alpha has no agent members):
  AGENT_GATEWAY_MODE=gateway MOMO_ALLOW_LEGACY_GATEWAY_SECRET=0 scripts/momo up

2. In the app, Members + -> Invite Agent, complete the Hermes pairing invite,
   and add it to the intended channel. Only then does Hermes appear in roster
   and mention candidates.

3. Issue the scoped per-agent credential from pairing. Copy the one-time token,
   paired member ID, and invited channel ID into the env file. The adapter does
   not log in as a human and does not mint or refresh its own credential.

The generated env also sets MOMO_HOME_CHANNEL before startup. Change that UUID
and MOMO_HOME_CHANNEL_NAME in the env file if Hermes should use another channel;
gateway lifecycle/setup notices are never posted into the momo timeline.

Load the oort-facing env in a subshell so the agent bearer does not remain in
your parent shell, then replace that subshell with Hermes:
  ( set -a; . "$env_file"; set +a; exec env HERMES_ACCEPT_HOOKS=1 hermes gateway run --replace -v )

momo still stores no Codex/OpenAI OAuth token; Hermes/provider runtime owns
provider credentials.

Install/link the plugin for a local Hermes install:
  scripts/momo hermes-gateway-install-plugin

Mock contract smoke:
  scripts/momo hermes-gateway-smoke

Real Hermes status/smoke:
  scripts/momo hermes-gateway-smoke --real
  MOMO_HERMES_PROVIDER_READY=1 scripts/momo hermes-gateway-smoke --real --trigger
EOF
}

hermes_gateway_install_plugin() {
  local target mode
  target="$(hermes_plugin_dir)"
  mode="${MOMO_HERMES_PLUGIN_INSTALL_MODE:-symlink}"
  mkdir -p "$(dirname "$target")"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$REPO_ROOT/adapters/hermes" ]; then
      info "Hermes momo plugin already linked: $target"
      hermes_gateway_enable_plugin_config
      return 0
    fi
    warn "plugin target already exists: $target"
    warn "remove it manually or set MOMO_HERMES_PLUGIN_DIR to another path"
    return 1
  fi
  case "$mode" in
    symlink)
      ln -s "$REPO_ROOT/adapters/hermes" "$target"
      ;;
    copy)
      cp -R "$REPO_ROOT/adapters/hermes" "$target"
      if [ -f "$target/plugin.yaml" ] && [ ! -f "$target/PLUGIN.yaml" ]; then
        cp "$target/plugin.yaml" "$target/PLUGIN.yaml"
      fi
      ;;
    *)
      warn "MOMO_HERMES_PLUGIN_INSTALL_MODE must be symlink or copy"
      return 2
      ;;
  esac
  info "installed Hermes momo plugin: $target"
  hermes_gateway_enable_plugin_config
}

hermes_gateway_status() {
  local env_file agent_token bin plugin_dir config_file
  env_file="$(gateway_env_file)"
  plugin_dir="$(hermes_plugin_dir)"
  config_file="$(hermes_config_file)"
  info "Hermes gateway platform adapter"
  echo "  env file: $env_file"
  echo "  repo plugin dir: $REPO_ROOT/adapters/hermes"
  echo "  Hermes plugin dir: $plugin_dir"
  echo "  Hermes config: $config_file"
  if bin="$(hermes_bin 2>/dev/null)"; then
    echo "  Hermes CLI: $bin"
    "$bin" --version 2>/dev/null | sed 's/^/    /' || true
  else
    echo "  Hermes CLI: missing"
    echo "  next: install Hermes, then run scripts/momo hermes-gateway-install-plugin"
  fi
  if [ -f "$plugin_dir/adapter.py" ] && { [ -f "$plugin_dir/PLUGIN.yaml" ] || [ -f "$plugin_dir/plugin.yaml" ]; }; then
    echo "  plugin load files: present"
  else
    echo "  plugin load files: missing"
    echo "  next: scripts/momo hermes-gateway-install-plugin"
  fi
  if [ -f "$config_file" ] && grep -Eq '^[[:space:]]*-[[:space:]]*momo[[:space:]]*$' "$config_file"; then
    echo "  plugin enabled: yes"
  else
    echo "  plugin enabled: no"
    echo "  next: scripts/momo hermes-gateway-install-plugin"
  fi
  if [ ! -f "$env_file" ]; then
    echo "  state: missing"
    echo "  next: scripts/momo hermes-gateway-init"
    return 0
  fi
  echo "  file mode: $(file_mode "$env_file")"
  echo "  api: $(provider_env_value "$env_file" MOMO_API_URL)"
  echo "  workspace: $(provider_env_value "$env_file" MOMO_WORKSPACE_ID)"
  echo "  agent: $(provider_env_value "$env_file" MOMO_AGENT_HANDLE) ($(provider_env_value "$env_file" MOMO_AGENT_MEMBER_ID))"
  agent_token="$(provider_env_value "$env_file" MOMO_AGENT_TOKEN)"
  if is_placeholder_value "$agent_token"; then
    echo "  agent token: missing or placeholder"
    echo "  next: issue one credential from agent pairing and update MOMO_AGENT_TOKEN"
  else
    echo "  agent token: configured (redacted)"
  fi
  if is_placeholder_value "$(provider_env_value "$env_file" MOMO_AGENT_MEMBER_ID)"; then
    echo "  pairing: incomplete"
    echo "  next: Members + -> Invite Agent, pair Hermes, then update member/channel IDs"
  else
    echo "  pairing: member id configured"
  fi
  if health_check; then
    echo "  momo server: reachable at $BASE_URL"
  else
    echo "  momo server: not running at $BASE_URL"
  fi
  if [ "${MOMO_HERMES_PROVIDER_READY:-}" = "1" ]; then
    echo "  provider login: user-marked ready"
  else
    echo "  provider login: unknown; set MOMO_HERMES_PROVIDER_READY=1 only after user-owned OAuth/login"
  fi
}

hermes_gateway_smoke() {
  case "${1:-}" in
    --real|real)
      shift || true
      "$REPO_ROOT/scripts/verify_hermes_gateway_real_smoke.sh" "$@"
      ;;
    *)
      "$REPO_ROOT/scripts/verify_hermes_gateway_adapter.sh" "$@"
      ;;
  esac
}

hermes_gateway_real_smoke() {
  "$REPO_ROOT/scripts/verify_hermes_gateway_real_smoke.sh" "$@"
}

host_command() {
  local subcommand="${1:-help}"
  shift || true
  case "$subcommand" in
    add)
      "$REPO_ROOT/infra/workd/bootstrap.sh" "$@"
      ;;
    help|-h|--help)
      "$REPO_ROOT/infra/workd/bootstrap.sh" --help
      ;;
    *)
      warn "unknown host command: $subcommand"
      echo "Usage: scripts/momo host add ssh://user@host [options]" >&2
      return 2
      ;;
  esac
}

command="${1:-help}"
case "$command" in
  start)
    start_stack
    launch_app
    ;;
  up)
    start_stack
    ;;
  app)
    launch_app
    ;;
  status)
    show_status
    ;;
  hermes|hermes-status)
    hermes_status
    ;;
  hermes-init)
    hermes_init
    ;;
  hermes-smoke)
    hermes_smoke
    ;;
  hermes-gateway-init)
    hermes_gateway_init
    ;;
  hermes-gateway-status)
    hermes_gateway_status
    ;;
  hermes-gateway-install-plugin)
    hermes_gateway_install_plugin
    ;;
  hermes-gateway-smoke)
    shift || true
    hermes_gateway_smoke "$@"
    ;;
  hermes-gateway-real-smoke)
    shift || true
    hermes_gateway_real_smoke "$@"
    ;;
  host)
    shift || true
    host_command "$@"
    ;;
  cleanup-seeded-agents)
    shift || true
    "$REPO_ROOT/scripts/cleanup_dogfood_seed_agents.sh" "$@"
    ;;
  stop)
    stop_app
    stop_stack
    ;;
  stop-app)
    stop_app
    ;;
  stop-stack)
    stop_stack
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    warn "unknown command: $command"
    usage >&2
    exit 2
    ;;
esac
