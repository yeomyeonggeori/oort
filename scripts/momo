#!/usr/bin/env bash
# Friendly local dogfood launcher for momo.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
APP_SCRIPT="$REPO_ROOT/scripts/macos_dev_run.sh"
ALPHA_SCRIPT="$REPO_ROOT/scripts/local_alpha_runner.sh"

BASE_URL="${MOMO_BASE_URL:-http://127.0.0.1:28180}"
API_PORT="${MOMO_API_PORT:-28180}"
POSTGRES_PORT="${MOMO_POSTGRES_PORT:-28132}"
CENT_PORT="${MOMO_CENT_PORT:-28100}"
HERMES_PORT="${MOMO_HERMES_PORT:-28188}"
HERMES_MODE="${MOMO_HERMES_MODE:-mock}"
APP_WAIT="${MOMO_APP_WAIT:-20}"
STATE_DIR="${MOMO_DOGFOOD_STATE_DIR:-${TMPDIR:-/tmp}/momo-dogfood}"
STATE_FILE="$STATE_DIR/state.env"
ALPHA_EVIDENCE_ROOT="${LOCAL_ALPHA_EVIDENCE_ROOT:-${TMPDIR:-/tmp}/momo-local-alpha}"

usage() {
  cat <<'EOF'
Usage: scripts/momo <command>

Commands:
  start       Start local alpha if needed, then open the macOS app.
  up          Start local alpha only.
  app         Open the macOS app only.
  status      Show app/server/Docker status.
  stop        Stop the app and the local alpha stack when it can be identified.
  stop-app    Stop the macOS app only.
  stop-stack  Stop the local alpha stack only.
  help        Show this help.

Defaults:
  Server URL: http://127.0.0.1:28180
  Login:      demo@momo.local / demo

Examples:
  scripts/momo start
  scripts/momo status
  scripts/momo stop

Environment overrides:
  MOMO_BASE_URL=http://127.0.0.1:28180
  MOMO_API_PORT=28180
  MOMO_POSTGRES_PORT=28132
  MOMO_CENT_PORT=28100
  MOMO_HERMES_PORT=28188
  MOMO_HERMES_MODE=mock
EOF
}

info() {
  printf '[momo] %s\n' "$*"
}

warn() {
  printf '[momo] WARN: %s\n' "$*" >&2
}

health_check() {
  curl -fsS --max-time 3 "$BASE_URL/health" >/dev/null 2>&1
}

print_health() {
  if curl -fsS --max-time 3 "$BASE_URL/health"; then
    printf '\n'
    return 0
  fi
  return 1
}

activate_app() {
  osascript -e 'tell application "MomoMacDevApp" to activate' >/dev/null 2>&1 || true
}

launch_app() {
  info "opening MomoMacDevApp"
  DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}" \
    "$APP_SCRIPT" --launch --verify --wait "$APP_WAIT"
  activate_app
}

latest_stop_script() {
  find "$ALPHA_EVIDENCE_ROOT" -name stop-local-alpha.sh -type f -print 2>/dev/null | sort | tail -n 1
}

write_state() {
  mkdir -p "$STATE_DIR"
  {
    printf 'BASE_URL=%q\n' "$BASE_URL"
    printf 'STOP_SCRIPT=%q\n' "${1:-}"
    printf 'UPDATED_AT=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$STATE_FILE"
}

state_stop_script() {
  if [ -f "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    printf '%s\n' "${STOP_SCRIPT:-}"
  fi
}

start_stack() {
  if health_check; then
    info "local alpha is already ready: $BASE_URL"
    return 0
  fi

  info "starting local alpha stack on $BASE_URL"
  info "ports: api=$API_PORT postgres=$POSTGRES_PORT centrifugo=$CENT_PORT hermes=$HERMES_PORT"

  PORT="$API_PORT" \
  POSTGRES_PORT="$POSTGRES_PORT" \
  CENT_PORT="$CENT_PORT" \
  HERMES_PORT="$HERMES_PORT" \
  DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}" \
    "$ALPHA_SCRIPT" execute --hermes "$HERMES_MODE"

  local stop_script
  stop_script="$(latest_stop_script || true)"
  write_state "$stop_script"

  if health_check; then
    info "local alpha is ready: $BASE_URL"
  else
    warn "local alpha command finished, but health is not reachable at $BASE_URL"
    return 1
  fi
}

stop_app() {
  info "stopping MomoMacDevApp"
  "$APP_SCRIPT" --terminate-only
}

stop_with_script() {
  local stop_script="$1"
  if [ -n "$stop_script" ] && [ -x "$stop_script" ]; then
    info "stopping local alpha via $stop_script"
    "$stop_script"
    return 0
  fi
  return 1
}

compose_project_for_port() {
  local port="$1"
  local cid
  cid="$(docker ps --filter "publish=$port" --format '{{.ID}}' | head -n 1 || true)"
  if [ -z "$cid" ]; then
    return 1
  fi
  docker inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$cid" 2>/dev/null || true
}

stop_compose_project() {
  local project="$1"
  case "$project" in
    momo*|infra)
      ;;
    *)
      warn "refusing to stop non-momo Docker compose project: ${project:-<empty>}"
      return 1
      ;;
  esac

  local containers
  containers="$(docker ps -aq --filter "label=com.docker.compose.project=$project" || true)"
  if [ -z "$containers" ]; then
    return 1
  fi

  info "stopping Docker compose project: $project"
  # shellcheck disable=SC2086
  docker rm -f $containers >/dev/null
  docker network rm "${project}_default" >/dev/null 2>&1 || true
  return 0
}

stop_stack() {
  local stopped=0
  local stop_script
  stop_script="$(state_stop_script || true)"
  if stop_with_script "$stop_script"; then
    stopped=1
  fi

  if [ "$stopped" = "0" ]; then
    stop_script="$(latest_stop_script || true)"
    if stop_with_script "$stop_script"; then
      stopped=1
    fi
  fi

  if [ "$stopped" = "0" ]; then
    local project
    project="$(compose_project_for_port "$API_PORT" || true)"
    if [ -n "$project" ] && stop_compose_project "$project"; then
      stopped=1
    fi
  fi

  if [ "$stopped" = "0" ]; then
    warn "no local alpha stack was identified. App stop still completed."
  fi
}

show_status() {
  info "app"
  if pgrep -x MomoMacDevApp >/dev/null 2>&1; then
    pgrep -fl MomoMacDevApp || true
  else
    echo "  not running"
  fi

  info "server"
  if print_health; then
    :
  else
    echo "  not reachable: $BASE_URL"
  fi

  info "docker on api port $API_PORT"
  local project
  project="$(compose_project_for_port "$API_PORT" || true)"
  if [ -n "$project" ]; then
    echo "  compose project: $project"
    docker ps --filter "label=com.docker.compose.project=$project" \
      --format '  {{.Names}} {{.Status}} {{.Ports}}'
  else
    echo "  no Docker compose project detected on port $API_PORT"
  fi
}

command="${1:-help}"
case "$command" in
  start)
    start_stack
    launch_app
    ;;
  up)
    start_stack
    ;;
  app)
    launch_app
    ;;
  status)
    show_status
    ;;
  stop)
    stop_app
    stop_stack
    ;;
  stop-app)
    stop_app
    ;;
  stop-stack)
    stop_stack
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    warn "unknown command: $command"
    usage >&2
    exit 2
    ;;
esac
