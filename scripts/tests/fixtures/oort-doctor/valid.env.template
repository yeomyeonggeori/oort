# oort-doctor fixture template (#1955).
# The test harness substitutes __TOKEN_*__ before use. Those tokens are not
# secrets; materialized values are throwaway and never committed.
COMPOSE_PROJECT_NAME=oort-doctor-fix
MOMO_SELF_HOST_MODE=local-build
MOMO_RUST_IMAGE=oort:local
MOMO_ENV=staging
MOMO_MIGRATE_ENV=development
MOMO_PITR_EVIDENCE_REQUIRED=0
MOMO_PITR_BOOTSTRAP_EMPTY=0
LOG_LEVEL=info
POSTGRES_DB=momo
POSTGRES_USER=momo
POSTGRES_PASSWORD=__TOKEN_PG__
MIGRATE_DATABASE_URL=postgres://momo:__TOKEN_PG__@postgres:5432/momo
DB_VOLUME_NAME=oort-doctor-fix-pgdata
MOMO_APP_POSTGRES_PASSWORD=__TOKEN_APP__
RELAY_POSTGRES_PASSWORD=__TOKEN_RELAY__
WORKER_POSTGRES_PASSWORD=__TOKEN_WORKER__
MOMO_APP_DATABASE_URL=postgres://momo_app:__TOKEN_APP__@postgres:5432/momo
RELAY_DATABASE_URL=postgres://momo_relay:__TOKEN_RELAY__@postgres:5432/momo
JWT_HMAC=__TOKEN_JWT__
CENT_TOKEN_HMAC=__TOKEN_CENT_TOKEN__
CENT_API_KEY=__TOKEN_CENT_API__
CENT_PROXY_SECRET=__TOKEN_CENT_PROXY__
PROVIDER_LINK_MASTER_KEY=__TOKEN_PLINK__
MOMO_WEB_PORT=__TOKEN_WEB_PORT__
MOMO_CENTRIFUGO_WS_URL=same-origin
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:__TOKEN_WEB_PORT__ http://127.0.0.1:__TOKEN_WEB_PORT__ tauri://localhost http://tauri.localhost
MOMO_RUST_API_PORT=__TOKEN_API_PORT__
CENT_HOST_PORT=__TOKEN_CENT_PORT__
MOMO_CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
MOMO_AGENT_SEED_MODE=none
MIGRATE_IDEMPOTENCY_CHECK=1
MOMO_INITIAL_OWNER_EMAIL=owner@oort.local
MOMO_INITIAL_OWNER_PASSWORD=__TOKEN_OWNER__
PLATFORM_ADMIN_EMAILS=owner@oort.local
MOMO_DRIVE_ARCHIVE_BACKEND=local
MOMO_DRIVE_LOCAL_DIR=/var/lib/oort/drive
MOMO_DRIVE_ARCHIVE_LOCAL_BASE_URL=same-origin
DRIVE_VOLUME_NAME=oort-doctor-fix-drive
MOMO_LIVEKIT_NODE_IP=127.0.0.1
