  "_comment": "#3027 \u2014 R2-E7 \uc11c\uba85 \uc9c0\uc2dc \ub77c\uc6b0\ud2b8\uc758 \uacc4\uc57d \uace8\ub4e0(ADR-0146 \uac1c\uc815 2026-09-28 D-5b\u00b7D-8\u00b7D-10, ADR-0188 D3\u00b7D4). \ud3f0\u00b7\ub370\uc2a4\ud06c\ud0d1 \uc9c0\uc2dc \uce74\ub4dc(E8 #3028)\uac00 \ubd99\uc744 \uc11c\ubc84 \ubaa8\uc591\uc774\ub2e4. \uc11c\ubc84(momo-server routes::work_instructions \ub2e8\uc704 \uc2dc\ud5d8\uc774 \uc624\ub958 \ucf54\ub4dc\u00b7props \ud0a4\u00b7\uc2a4\ud0a4\ub9c8\uc640 `database`\uac00 \uc5c6\ub294 \uc0ac\ub840\ub97c \uc77d\ub294\ub2e4)\uc640 \ud074\ub77c\uc774\uc5b8\ud2b8\uac00 \uac19\uc740 \uae30\ub300\uac12\uc744 \uc4f4\ub2e4. `database: true` \uc0ac\ub840\ub294 \ud2b8\ub79c\uc7ad\uc158 \uc548\uc5d0\uc11c \ud310\uc815\ub418\uba70 PG \uc801\ud569\uc131 \uc2dc\ud5d8(work_instruction_conformance_pg)\uc774 \uc7b0\ub2e4. uuid\u00b7\uc11c\uba85\uc740 \uc790\ub9ac\ud45c\uc2dc \uac12\uc774\ub2e4.",
  "route": {
    "method": "POST",
    "path": "/v1/workspaces/{workspaceId}/work-sessions/{workSessionId}/instructions",
    "auth": "human bearer of the session owner (= member-scoped host owner). Agent bearers and host signatures never reach it.",
    "flag": "MOMO_HUMAN_CONTROL_SIGNATURE_REQUIRED; off \u2192 403 signed_instructions_disabled"
  },
  "signature": {
    "schema": "momo.human.control.v2",
    "kind": "input",
    "session_line": "{workSessionId}",
    "host_line": "the session's host",
    "content": "NFC(text)",
    "mode_line": "mode (queue | interrupt)",
    "nonce": "= clientMsgId",
    "accepted_v1": "momo.human.control.v1 is still accepted for input (same bytes but the first line)"
  },
  "order": {
    "queue": "the next turn after the running one and anything already queued",
    "interrupt": "the host cancels the running turn (ACP session/cancel) and delivers this instruction next, ahead of the queue"
  },
  "response": {
    "status": "201 new, 200 replayed retry",
    "body": {
      "workControl": "WorkControl (kind input, status dispatched | failed when the host was revoked in between)",
      "message": {
        "id": "uuid",
        "channelId": "uuid",
        "rootId": "the session's root message",
        "seq": "channel seq",
        "clientMsgId": "= nonce"
      },
      "replayed": "boolean"
    }
  },
  "props_key": "momo.instruction",
  "props_example": {
    "momo.instruction": {
      "control_id": "uuid",
      "work_session_id": "uuid",
      "mode": "queue"
    }
  },
