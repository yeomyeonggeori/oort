# MOMO-257 local Hermes-compatible provider env example.
# Copy to $HOME/.momo/local-hermes-provider.env and chmod 600.
# Keep this file placeholder-only. Do not put Codex/OpenAI OAuth tokens or GPT
# provider API keys here; those belong inside the provider runtime.

MOMO_ENV=local
AGENT_PROVIDER_MODE=external-hermes
AGENT_PROVIDER_ALLOW_LOCAL_LOOPBACK=1
AGENT_MODEL=<provider-model-label>
HERMES_BASE_URL=http://127.0.0.1:<provider-port>/v1
HERMES_API_KEY=<local-hermes-facing-bearer-not-openai-key>
