{
  "name": "momo-web",
  "private": true,
  "version": "0.0.0",
  "description": "momo canonical UI (ADR-0133 §1): TS + React 18 + Vite. The same bundle runs in the browser and inside the Tauri shell (clients/desktop). The ADR-0119 alpha it replaced lives at clients/web-legacy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gate:inject": "node gates/inject.mjs",
    "gate:seq": "node gates/gate-seq.mjs",
    "gate:resume": "node gates/gate-resume.mjs",
    "capture:design": "node scripts/capture-screens.mjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "centrifuge": "^5.3.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.12.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
