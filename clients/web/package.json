{
  "name": "momo-web",
  "private": true,
  "version": "0.0.0",
  "description": "momo canonical UI (ADR-0133 \u00a71): TS + React 18 + Vite. The same bundle runs in the browser and inside the Tauri shell (clients/desktop). The ADR-0119 alpha it replaced lives at clients/web-legacy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node e2e/smoke.mjs",
    "smoke:connect": "node e2e/connect.mjs",
    "gate:inject": "node gates/inject.mjs",
    "gate:seq": "node gates/gate-seq.mjs",
    "gate:resume": "node gates/gate-resume.mjs",
    "gate:shell": "node gates/gate-shell-layout.mjs",
    "gate:scroll": "node gates/gate-scroll.mjs",
    "gate:wire": "node gates/gate-wire.mjs",
    "gate:csp": "node gates/gate-csp.mjs",
    "gate:csp-deploy": "npm run build && node gates/gate-csp-deploy.mjs",
    "gate:boot": "node gates/gate-boot-budget.mjs",
    "gate:huddle": "vite build --mode huddle-gate && node gates/gate-huddle.mjs",
    "gate:my-sessions": "vite build --mode my-sessions-gate && node gates/gate-my-sessions.mjs",
    "gate:agent-hub": "vite build --mode agent-hub-gate && node gates/gate-agent-hub.mjs",
    "gate:workstream": "vite build --mode workstream-gate && node gates/gate-workstream.mjs",
    "gate:approvals": "npm run build && node gates/gate-approvals.mjs",
    "gate:work-panel": "npm run build && node gates/gate-work-panel.mjs",
    "gate:display-control": "npm run build && node gates/gate-display-control.mjs",
    "gate:work-console": "npm run build && node gates/gate-work-console.mjs",
    "gate:ade": "npm run build && node gates/gate-ade.mjs",
    "gate:ailink": "npm run build && node gates/gate-ailink.mjs",
    "gate:quote": "npm run build && node gates/gate-quote.mjs",
    "gate:pin": "npm run build && node gates/gate-pin.mjs",
    "gate:channel-header": "npm run build && node gates/gate-channel-header.mjs",
    "gate:theme": "npm run build && node gates/gate-theme.mjs",
    "gate:typing": "npm run build && node gates/gate-typing.mjs",
    "gate:borders": "npm run build && node gates/gate-time-borders.mjs",
    "gate:fold": "npm run build && node gates/gate-fold-nav.mjs",
    "gate:composer": "npm run build && node gates/gate-composer.mjs",
    "gate:webhook": "npm run build && node gates/gate-webhook-credential.mjs",
    "gate:attachment": "npm run build && node gates/gate-attachment.mjs",
    "capture:attachment": "npm run build && ATTACH_GATE_SHOTS=1 node gates/gate-attachment.mjs",
    "build:design": "tsc -b && vite build --mode design",
    "capture:design": "npm run build:design && node scripts/capture-screens.mjs",
    "capture:usage": "node scripts/capture-usage.mjs",
    "capture:eventsub": "npm run build && node scripts/capture-eventsub.mjs",
    "capture:honesty": "npm run build && node scripts/capture-honesty.mjs",
    "capture:handoff": "npm run build && node scripts/capture-handoff.mjs",
    "capture:routing": "npm run build && node scripts/capture-routing.mjs",
    "capture:standalone": "npm run build && node scripts/capture-standalone.mjs",
    "capture:w4b": "npm run build && node scripts/capture-w4b.mjs",
    "icons:pwa": "node scripts/render-pwa-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "centrifuge": "^5.3.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "livekit-client": "^2.21.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.12.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
