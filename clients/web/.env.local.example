# Copy to .env.local (gitignored). NEVER commit real credentials.
# momowebqa spike backend (ADR-0133 P0 / MOMO-595).

# Leave VITE_MOMO_API_BASE EMPTY to use the same-origin dev proxy (recommended).
# Set it only for a host whose api service sets MOMO_CORS_ALLOWED_ORIGINS
# (MOMO-605 / DESK-1) — otherwise the browser blocks every cross-origin call.
# This is the BUILD-TIME fallback only: a server picked on the connect screen
# (stored as localStorage momo.web.server.v1, MOMO-604) wins over it.
VITE_MOMO_API_BASE=
# Dev/preview proxy target (read by vite.config.ts, not the browser bundle):
MOMO_PROXY_TARGET=http://127.0.0.1:28000
VITE_MOMO_WORKSPACE=00000000-0000-7000-8000-000000000001

# Test-period login prefill (DESK-1). BUILD-TIME only, blank in shared envs, and
# NEVER committed with a value — this file is the names, .env.local is the values.
# Blank/unset prefills nothing, which is the shipped behaviour for the production
# web dist. A build that sets either one SAYS SO on the connect screen
# ("테스트 프리필이 켜진 빌드입니다"), so a prefilled password cannot ship quietly.
VITE_MOMO_DEV_EMAIL=
VITE_MOMO_DEV_PASSWORD=

# Boot budgets (DESK-1). Unset = the shipped defaults (1200 ms / 2500 ms). These
# exist so gates/gate-boot-budget.mjs can prove it detects a regression; a
# deployment should not set them.
# VITE_MOMO_HYDRATE_BUDGET_MS=
# VITE_MOMO_BOOT_RESTORE_BUDGET_MS=
