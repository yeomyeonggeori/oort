<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- 초대 딥링크(W-O1, MOMO-585): oort://join?server=<percent-encoded base URL>&code=<invite code>.
	     onOpenURL이 chooser의 join 경로에 서버 URL·초대 코드를 프리필한다.
	     goal B13(momo→oort 리브랜딩): 발급은 oort:// 하나지만 등록은 둘 다다.
	     이미 보낸 초대 링크는 며칠씩 살아 있고, 제품 이름이 바뀌었다는 이유로
	     안 열리면 안 된다. 구 스킴은 흡수한다(MomoDeepLinkParser.acceptedSchemes). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.momo.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oort</string>
				<string>momo</string>
			</array>
		</dict>
	</array>
	<!-- 내부 알파 LAN 직결(2026-07-23): 같은 와이파이의 http://192.168.x.x
	     서버·ws:// 실시간 접속을 허용한다. NSAllowsLocalNetworking은 사설/링크로컬
	     대역과 .local 호스트에만 ATS를 면제하며 공인 도메인 HTTPS 요구는 유지한다
	     (공개 배포는 TLS 경로 그대로). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 서버 자동 발견(MOMO-587): 첫 실행 chooser가 같은 네트워크의 momo 서버를
	     Bonjour(_momo._tcp)로 조용히 찾아 주소를 제안한다. 발견되지 않으면 무소음.
	     NSLocalNetworkUsageDescription은 로컬 네트워크 권한 프롬프트에 노출되는
	     설명 문자열이고, NSBonjourServices는 브라우징을 허용할 서비스 타입이다. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>momo looks for a workspace server on your local network so you can connect without typing its address.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_momo._tcp</string>
	</array>
</dict>
</plist>
