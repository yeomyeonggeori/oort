# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Expo modules autolinking (ADR-0137 D1: bare RN + Expo modules à la carte, no
# EAS, no prebuild). This is `use_expo_modules!` only — it links the Expo modules
# already in package.json and does not introduce the managed workflow. The iOS
# project stays hand-owned and checked in; nothing here regenerates it.
require File.join(
  File.dirname(
    Pod::Executable.execute_command('node', ['-p',
      'require.resolve(
        "expo/package.json",
        {paths: [process.argv[1]]},
      )', __dir__]).strip
  ),
  'scripts/autolinking'
)

# Podfile.lock 결정성: hermes-engine SPEC CHECKSUM 을 체크아웃 경로에서 떼어낸다.
#
# React Native 0.86 의 hermes-engine.podspec 은 prebuilt 분기에서 hermesc 를
# `require.resolve` 로 찾아 그 **절대경로**를 그대로 xcconfig 에 박는다
# (node_modules/react-native/sdks/hermes-engine/hermes-engine.podspec:91-97):
#     'HERMES_CLI_PATH' => "#{hermes_compiler_path}/hermesc/osx-bin/hermesc"
# CocoaPods 는 외부 소스 podspec 을 `Pods/Local Podspecs/<name>.podspec.json` 으로
# 직렬화한 뒤 **그 파일의 SHA1** 을 Podfile.lock 의 SPEC CHECKSUM 으로 삼는다
# (cocoapods-core/specification.rb:685 `Digest::SHA1.hexdigest(File.read(defined_in_file))`).
#
# 두 사실이 겹치면 hermes-engine 체크섬은 **작업 디렉터리 절대경로의 함수**가 된다.
# 워크트리·머신·CI 러너가 다르면 `pod install` 이 매번 lock 을 다시 쓰고,
# lock 을 강제 검증하는 `pod install --deployment` 는 아예 실패한다(H-FIX1 재현 매트릭스).
# 같은 경로에서 두 번 돌리면 값이 안정적이라 "2회 연속 diff 0" 으로는 안 잡힌다 —
# 결정성의 축은 실행 횟수가 아니라 경로다.
#
# 그래서 직렬화 직전에 그 한 값만 `${PODS_ROOT}` 상대 표현으로 정규화한다. 절대경로가
# 사라져 체크섬이 경로 독립이 되고, 빌드 시점에는 Xcode 가 ${PODS_ROOT} 를 전개하므로
# hermesc 실제 위치는 그대로다. RN 자신이 소스빌드 분기에서 쓰는 표현과 같은 형태다
# (같은 podspec:157). local podspec 96개 중 절대경로를 담는 것은 hermes-engine 하나뿐이라
# 범위도 여기서 닫힌다.
#
# CocoaPods 내부(Sandbox#store_podspec)에 기대는 코드다. 기대한 모양이 아니면 조용히
# no-op 하고 원래 절대경로를 남긴다 — 결정성은 잃지만 설치·빌드는 깨지지 않는다.
module MomoDeterministicHermesChecksum
  HERMES_POD = 'hermes-engine'.freeze
  HERMES_CLI_KEY = 'HERMES_CLI_PATH'.freeze

  def store_podspec(name, podspec, external_source = false, json = false)
    normalize_hermes_cli_path!(podspec) if name == HERMES_POD
    super
  end

  private

  def normalize_hermes_cli_path!(spec)
    return unless spec.is_a?(Pod::Specification)

    attributes = spec.attributes_hash
    return unless attributes.is_a?(Hash)

    xcconfig = attributes['user_target_xcconfig']
    return unless xcconfig.is_a?(Hash)

    value = xcconfig[HERMES_CLI_KEY]
    return unless value.is_a?(String) && value.start_with?('/')

    relative = Pathname.new(value).relative_path_from(root)
    xcconfig[HERMES_CLI_KEY] = "${PODS_ROOT}/#{relative}"
  rescue StandardError => e
    Pod::UI.warn "[momo] hermes-engine HERMES_CLI_PATH 정규화 실패, 절대경로 유지: #{e.message}"
  end
end
Pod::Sandbox.prepend(MomoDeterministicHermesChecksum)

# 위 훅은 CocoaPods 가 외부 소스를 **다시 fetch 할 때만** 돈다. 이미 절대경로가 박힌
# `Pods/Local Podspecs/hermes-engine.podspec.json` 이 남아 있으면 CocoaPods 는 그 파일을
# 그대로 재사용하고(analyzer.rb:1011,1037 — `:podspec` 소스는 저장본이 있으면 fetch 생략)
# 훅이 돌지 않아 옛 체크섬이 그대로 lock 에 실린다. 이 fix 이전에 만든 Pods/ 를 가진
# 체크아웃이 정확히 그 상태다(H-FIX1 실측).
#
# 그래서 저장본이 절대경로를 담고 있으면 버린다. 파일이 없으면 CocoaPods 가 반드시
# 다시 fetch 하고, 그때 위 훅이 정규화한다. 직접 고쳐 쓰지 않고 버리는 이유는
# to_pretty_json 의 바이트 포맷을 손으로 재현하면 신규 설치와 1바이트라도 어긋나는 순간
# 체크섬이 갈라지기 때문이다 — 생성은 CocoaPods 한 곳에만 맡긴다.
def momo_evict_stale_hermes_podspec!
  stored = Pod::Config.instance.sandbox_root + 'Local Podspecs' + 'hermes-engine.podspec.json'
  return unless stored.file?
  return unless stored.read =~ /"HERMES_CLI_PATH"\s*:\s*"\//

  stored.delete
  Pod::UI.puts '[momo] 절대경로가 박힌 hermes-engine podspec 캐시를 버린다 (재fetch 시 정규화)'
rescue StandardError => e
  Pod::UI.warn "[momo] hermes-engine podspec 캐시 정리 실패: #{e.message}"
end
momo_evict_stale_hermes_podspec!

# NOT `min_ios_version_supported` (React Native 0.86 answers 15.1 —
# node_modules/react-native/scripts/cocoapods/helpers.rb:84). Expo SDK 57 declares
# `:ios => '16.4'` (node_modules/expo/Expo.podspec:39) and CocoaPods refuses to
# link ANY Expo pod below it, so 15.1 makes `use_expo_modules!` silently link
# nothing and the push wiring never exists.
#
# This raises the floor rather than lowering it: the SwiftUI kit this client
# replaces already required iOS 17 (clients/iOS/MomoiOSKit/Package.swift:6), so
# no device that could run momo before loses it here. Keep this in step with
# IPHONEOS_DEPLOYMENT_TARGET in project.pbxproj — CocoaPods and Xcode do not read
# each other's value.
platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The MomoMobileNotificationService target is deliberately absent from this file.
# A UNNotificationServiceExtension gets ~24MB and a few hundred milliseconds; it
# must not inherit the React Native pods graph (audit 2026-08-02 §3.1). Its only
# sources are MomoPushKit/PushNotification.swift + NotificationService/, which
# depend on nothing but Foundation, Security and UserNotifications.
target 'MomoMobile' do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
