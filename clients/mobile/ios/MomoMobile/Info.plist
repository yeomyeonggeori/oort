<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>oort</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- CFBundleDisplayName 이 이미 oort 이지만, 그것이 없거나 잘릴 때 OS가 읽는
	     짧은 이름은 CFBundleName 이다. PRODUCT_NAME(=MomoMobile, 실행파일·타깃명)은
	     건드리지 않고 표시용 이름만 분리한다(ADR-0152 D2-1). -->
	<key>CFBundleName</key>
	<string>oort</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.momo.ios.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oort</string>
				<string>momo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 수출 규정 암호화 신고(#2568). false 는 owner 확인을 기다리는 판단이다
	     (docs/runbooks/ios-testflight.md §8, M7 S-7 법무 검토). 사실: 통신은 OS 의 TLS
	     (fetch·WebSocket·NSE 의 URLSession, ATS 켬)뿐이고, 저장 비밀은 키체인(OS)에만 둔다.
	     MMKVCore(react-native-mmkv)의 AES 코드는 바이너리에 들어 있지만 앱은 encryptionKey
	     없이만 쓴다(src/storage/kv.ts). 「켜지 않았으니 사용이 아니다」는 해석이다.
	     코드 쪽 전제는 __tests__/projectShape.test.ts 가 기계로 지킨다. 그 시험이 깨지면 이
	     값을 다시 판단한다. 이 키가 없으면 빌드마다 ASC 가 수출 규정 질문을 띄우고, 답하기
	     전에는 테스터가 설치하지 못한다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Carried over from clients/iOS/XcodeHost/Info.plist:50 (audit 2026-08-02 §7.2 #9).
	     $(APS_ENVIRONMENT) is set per configuration in project.pbxproj
	     (Debug=development, Release=production) and is the ONLY thing that tells the
	     device-registration call whether this build's APNs token is a sandbox or a
	     production token. Drop this key and the code falls back to `__DEV__`, which
	     means a Release build registers a production token as sandbox and every push
	     silently goes nowhere. -->
	<key>MomoAPNSEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Read by MomoPushShared/PushNotification.swift:30-32 in BOTH processes to
	     build kSecAttrAccessGroup. Must match keychain-access-groups in both
	     entitlement files. -->
	<key>MomoKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)app.momo.ios.shared</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>QR 코드로 이 기기를 워크스페이스에 연결할 때 카메라를 씁니다.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크에 있는 oort 서버에 연결합니다.</string>
	<!-- 앱은 마이크를 요청하지 않는다(카메라는 QR 스캔 전용, 녹음 기능 없음). 그래도 이 키가
	     필요한 것은 expo-camera 가 오디오 권한 API 를 바이너리에 링크하기 때문이고, 키가 없으면
	     업로드가 ITMS-90683 으로 반려된다(#2568). 녹음하는 기능이 생기면 이 문구부터 바꾼다 —
	     __tests__/projectShape.test.ts 가 마이크 API 호출을 발견하면 실패해 그 시점을 알린다. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>oort는 소리를 녹음하지 않습니다. 허용하지 않아도 모든 기능을 쓸 수 있습니다.</string>
	<!-- 사진 첨부는 PHPicker 라 선택만으로는 권한을 묻지 않는다(ADR-0168). expo-image-picker 가
	     사진 보관함 권한 API 를 링크하므로 키 자체는 필요하다(ITMS-90683, #2568). -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>대화에 첨부할 사진을 고를 때 사진 보관함을 씁니다.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- ADR-0120 D2-A sends `content-available: 1` alongside `mutable-content: 1`
	     (relay/PushRelay/Sources/PushRelay/PushDispatch.swift:112-113). Without this
	     background mode the content-available half is dropped and the app is never
	     woken to refresh behind the notification. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
