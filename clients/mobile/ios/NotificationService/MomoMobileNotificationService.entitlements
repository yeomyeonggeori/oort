<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NO aps-environment here, deliberately. A UNNotificationServiceExtension
	     is not an APNs client: it is woken to rewrite a notification the HOST app
	     registered for. Declaring aps-environment on the extension would demand a
	     Push Notifications capability on the extension's App ID that it never
	     uses. -->
	<!-- NO com.apple.developer.usernotifications.communication here either (#4316). The capability is the
	     APP target's: the extension donates and re-dresses content inside the app's bundle, which is
	     what Apple's "Implementing communication notifications" and Buzz's shipped entitlements both say. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.momo.ios</string>
	</array>
	<!-- LOAD-BEARING — must match MomoMobile.entitlements byte for byte.
	     See the note there. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.momo.ios.shared</string>
	</array>
</dict>
</plist>
