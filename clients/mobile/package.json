{
  "name": "momo-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "momo (oort) iOS client — bare React Native, New Architecture, Hermes (ADR-0137 D1). Consumes @momo/core by path, exactly as clients/web does. Not clients/mobile-spike: that harness is disposable, this is the app.",
  "scripts": {
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "gate:project-shape": "jest __tests__/projectShape.test.ts",
    "build:sim": "bash scripts/build-sim.sh",
    "gate:session": "node gate/run.mjs",
    "lane:phone": "bash scripts/lane-phone.sh",
    "install:maestro": "bash scripts/install_maestro.sh"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.59.0",
    "centrifuge": "^5.7.0",
    "expo": "^57.0.9",
    "expo-clipboard": "^57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-notifications": "^57.0.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "autolinking": {
      "//": "Local Expo modules are NOT discovered by default — expo-modules-autolinking only scans this directory when nativeModulesDir is set (expo-modules-autolinking/build/commands/autolinkingOptions.js:76). Without this line modules/momo-push-native links silently as nothing. This is autolinking configuration only; it does not opt this app into the managed workflow or prebuild.",
      "nativeModulesDir": "./modules"
    }
  }
}
