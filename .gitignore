.build/
build/
dist/
*.xcuserstate
xcuserdata/
.env
.env.local
.env.worktree
.momo/
local-hermes-provider.env
external-agent.env
*.secret.env
*.secrets.env
infra/prod/.env
infra/prod/.env.*
!infra/prod/.env.example
infra/prod/secrets.env
infra/prod/*.plain.env
infra/prod/*.decrypted
