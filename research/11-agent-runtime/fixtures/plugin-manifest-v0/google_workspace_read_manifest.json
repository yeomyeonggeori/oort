{
  "schema": "momo.plugin_manifest.v0",
  "id": "com.momo.plugins.google-workspace-read",
  "name": "Google Workspace Read Sources",
  "version": "0.1.0",
  "publisher": {
    "id": "momo.first_party",
    "name": "momo",
    "homepage": "https://github.com/Dawn-kim-official/momo",
    "support": "momo://support/plugins/google-workspace-read"
  },
  "runtime": {
    "kind": "hosted_connector",
    "entrypoint": "momo://connectors/google-workspace/read",
    "transport": "momo_worker",
    "sandbox": "process_external_api",
    "network": {
      "egress_allowlist": [
        "www.googleapis.com",
        "oauth2.googleapis.com"
      ]
    }
  },
  "surfaces": [
    {
      "kind": "source_provider",
      "name": "google_workspace.drive",
      "display_name": "Google Drive Sources"
    },
    {
      "kind": "source_provider",
      "name": "google_workspace.gmail",
      "display_name": "Gmail Thread Sources"
    },
    {
      "kind": "source_provider",
      "name": "google_workspace.calendar",
      "display_name": "Calendar Availability"
    },
    {
      "kind": "sidebar_settings",
      "name": "google_workspace.connect",
      "display_name": "Connect Google Workspace"
    }
  ],
  "capabilities": [
    {
      "tool_name": "google_workspace.drive.search",
      "display_name": "Search selected Drive files",
      "grant": "read",
      "risk": "read",
      "allowed_operations": ["search_files", "fetch_file_metadata", "fetch_file_excerpt"],
      "denied_operations": ["share_file", "change_permission", "upload_file"],
      "required_provider_grants": [
        "https://www.googleapis.com/auth/drive.file",
        "https://www.googleapis.com/auth/drive.metadata.readonly"
      ],
      "result_kind": "external_source_ref",
      "idempotency_required": false,
      "resource_scope_summary": "selected_file_or_metadata_readonly_scope"
    },
    {
      "tool_name": "google_workspace.gmail.search_threads",
      "display_name": "Search Gmail threads",
      "grant": "read",
      "risk": "read",
      "allowed_operations": ["search_threads", "fetch_thread_metadata", "fetch_thread_excerpt"],
      "denied_operations": ["send_email", "modify_labels", "delete_message"],
      "required_provider_grants": [
        "https://www.googleapis.com/auth/gmail.metadata",
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "result_kind": "external_source_ref",
      "idempotency_required": false,
      "resource_scope_summary": "bounded_query_window"
    },
    {
      "tool_name": "google_workspace.calendar.availability",
      "display_name": "Query calendar availability",
      "grant": "read",
      "risk": "read",
      "allowed_operations": ["query_freebusy", "list_events_window"],
      "denied_operations": ["create_event", "update_event", "delete_event", "invite_attendees"],
      "required_provider_grants": [
        "https://www.googleapis.com/auth/calendar.freebusy",
        "https://www.googleapis.com/auth/calendar.events.readonly"
      ],
      "result_kind": "external_source_ref",
      "idempotency_required": false,
      "resource_scope_summary": "freebusy_or_bounded_event_window"
    }
  ],
  "tool_schema_refs": [
    {
      "tool_name": "google_workspace.drive.search",
      "input_schema_ref": "momo://capability-cache/google_workspace.drive.search/schemas/input/sha256:gwsdrivesearchv0",
      "output_schema_ref": "momo://capability-cache/google_workspace.drive.search/schemas/output/sha256:gwsdrivesearchoutv0",
      "schema_format": "json_schema_2020_12",
      "schema_hash": "sha256:gwsdrivesearchv0"
    },
    {
      "tool_name": "google_workspace.gmail.search_threads",
      "input_schema_ref": "momo://capability-cache/google_workspace.gmail.search_threads/schemas/input/sha256:gwsgmailsearchv0",
      "output_schema_ref": "momo://capability-cache/google_workspace.gmail.search_threads/schemas/output/sha256:gwsgmailsearchoutv0",
      "schema_format": "json_schema_2020_12",
      "schema_hash": "sha256:gwsgmailsearchv0"
    },
    {
      "tool_name": "google_workspace.calendar.availability",
      "input_schema_ref": "momo://capability-cache/google_workspace.calendar.availability/schemas/input/sha256:gwscalendaravailabilityv0",
      "output_schema_ref": "momo://capability-cache/google_workspace.calendar.availability/schemas/output/sha256:gwscalendaravailabilityoutv0",
      "schema_format": "json_schema_2020_12",
      "schema_hash": "sha256:gwscalendaravailabilityv0"
    }
  ],
  "approval_policy": {
    "default": "none",
    "rules": [
      {
        "match": {
          "risk": "read"
        },
        "policy": "none",
        "grant": "read",
        "requires_current_provider_grant": true
      },
      {
        "match": {
          "operation": ["send_email", "create_event", "share_file", "change_permission"]
        },
        "policy": "deny",
        "grant": "deny",
        "reason": "Google Workspace write operations are not part of this read-mostly manifest."
      }
    ]
  },
  "risk": {
    "level": "medium",
    "classes": ["read"],
    "external_systems": ["google_workspace"],
    "data_sensitivity": "restricted_workspace_sources",
    "side_effects": ["external_read"]
  },
  "source_policy": {
    "source_kinds": ["google_drive", "gmail", "calendar"],
    "context_packet_projection": {
      "sources_allowed": true,
      "max_excerpt_chars": 3000,
      "required_permission_basis": [
        "google_workspace_grant",
        "resource_scope",
        "actor_is_channel_member",
        "agent_is_channel_member"
      ]
    },
    "memory_plane_projection": {
      "allowed_memory_types": ["external_source_ref", "artifact_ref", "task_state"],
      "default_visibility": "personal",
      "retrieval_policy_version": "memory-policy@2026-06-26+google-workspace-connector@2026-06-27+plugin:google-workspace-read@0.1.0"
    }
  },
  "audit_policy": {
    "event_prefix": "plugin.google_workspace_read",
    "required_events": [
      "plugin.installed",
      "source_ref.created",
      "capability.discovered",
      "capability.projected_to_context_packet",
      "memory.revalidation_required",
      "plugin.revoked"
    ],
    "redact_fields": [
      "provider_access_token",
      "provider_refresh_token",
      "google_primary_email",
      "resource_key"
    ]
  },
  "compatibility": {
    "manifest_version": "0",
    "momo_protocol": ">=0.1.0 <0.2.0",
    "context_packet": "momo.context_packet.v0",
    "capability_cache": "momo.capability_cache_entry.v0",
    "memory_plane": "momo.memory_item.v0",
    "client_cards": ["source_badge.v0", "tool_result.v0"]
  },
  "signature": {
    "required_for_catalog": true,
    "algorithm": "minisign-ed25519",
    "artifact_digest": "sha256:fixture-google-workspace-read-manifest-v0",
    "signature_ref": "momo://catalog/signatures/google-workspace-read/0.1.0/minisign",
    "signed_at": "2026-06-29T00:00:00Z"
  }
}
